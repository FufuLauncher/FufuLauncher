<windowex:WindowEx
    x:Class="FufuLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowex="using:WinUIEx"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:helpers="using:FufuLauncher.Helpers"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <AcrylicBrush x:Key="IosGlassBrush"
                                      TintColor="#FFFFFF"
                                      TintOpacity="0.6"
                                      FallbackColor="#E5FFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <AcrylicBrush x:Key="IosGlassBrush"
                                      TintColor="#000000"
                                      TintOpacity="0.15"
                                      FallbackColor="#CC000000" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <AcrylicBrush x:Key="IosGlassBrush"
                                      TintColor="#000000"
                                      TintOpacity="0.15"
                                      FallbackColor="#CC000000" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/Assets/WindowIcon.ico"
                        ToolTipText="{helpers:Loc Key=AppDisplayName}"
                        LeftClickCommand="{x:Bind ShowWindowCommand}"
                        DoubleClickCommand="{x:Bind ShowWindowCommand}"
                        RightClickCommand="{x:Bind ShowTrayMenuCommand}" />

        <Grid x:Name="GlobalBackgroundHost" IsHitTestVisible="False">
            <Image x:Name="GlobalBackgroundImage"
                   ImageFailed="OnGlobalBackgroundImageFailed"
                   helpers:ImageFadeInHelper.IsFadeInEnabled="False"
                   Stretch="UniformToFill"
                   VerticalAlignment="Top"
                   Margin="0,-25,0,0"
                   Opacity="1" />
            <MediaPlayerElement x:Name="GlobalBackgroundVideo"
                                Stretch="UniformToFill"
                                Opacity="1"
                                AutoPlay="False"
                                AreTransportControlsEnabled="False"
                                Visibility="Collapsed" />
            <Rectangle x:Name="GlobalBackgroundOverlay"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Opacity="0.2" />
        </Grid>

        <Grid x:Name="PageBackgroundOverlay"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              IsHitTestVisible="False">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="OverlayTranslate" Y="2000" />
            </Grid.RenderTransform>
        </Grid>

        <Frame x:Name="AgreementFrame" Visibility="Collapsed" Background="Transparent" />

        <NavigationView x:Name="NavigationView"
                        Visibility="Collapsed"
                        PaneDisplayMode="Left"
                        IsPaneOpen="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="NavigationView_SelectionChanged"
                        Loaded="NavigationView_Loaded"
                        PaneOpened="NavigationView_PaneOpened"
                        PaneClosed="NavigationView_PaneClosed"
                        OpenPaneLength="150"
                        CompactPaneLength="60"
                        Background="{x:Null}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Enabled">

            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <AcrylicBrush x:Key="NavigationViewDefaultPaneBackground"
                                          TintColor="#FFFFFF"
                                          TintOpacity="0.6"
                                          FallbackColor="#E5FFFFFF" />
                            <AcrylicBrush x:Key="NavigationViewExpandedPaneBackground"
                                          TintColor="#FFFFFF"
                                          TintOpacity="0.6"
                                          FallbackColor="#E5FFFFFF" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <AcrylicBrush x:Key="NavigationViewDefaultPaneBackground"
                                          TintColor="#000000"
                                          TintOpacity="0.15"
                                          FallbackColor="#CC000000" />
                            <AcrylicBrush x:Key="NavigationViewExpandedPaneBackground"
                                          TintColor="#000000"
                                          TintOpacity="0.15"
                                          FallbackColor="#CC000000" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>

                    <FontFamily x:Key="ActionIconFont">Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol</FontFamily>

                    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                    <CornerRadius x:Key="NavigationViewItemCornerRadius">0</CornerRadius>
                    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                    <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>

                    <Style TargetType="NavigationViewItem">
                        <Setter Property="MinHeight" Value="48" />
                        <Setter Property="Margin" Value="0,1,0,1" />
                    </Style>
                    <Style TargetType="FontIcon">
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Style>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                </ResourceDictionary>
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <TextBlock Text=""
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="12,68,0,8"
                           VerticalAlignment="Center" />
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="{helpers:Loc Key=NavHome}" Tag="FufuLauncher.ViewModels.MainViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontFamily="{StaticResource ActionIconFont}" FontSize="24" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="{helpers:Loc Key=InjectionSettingsNav}"
                                    Tag="FufuLauncher.ViewModels.PluginSettingsViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA86;" FontFamily="{StaticResource ActionIconFont}" FontSize="24" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="{helpers:Loc Key=Panel_Toolbox}"
                                    Tag="FufuLauncher.ViewModels.ControlPanelViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80A;" FontFamily="{StaticResource ActionIconFont}" FontSize="24" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="{helpers:Loc Key=PageTitle_GameSettings}"
                                    Tag="FufuLauncher.ViewModels.GameSettingsViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" FontFamily="{StaticResource ActionIconFont}" FontSize="24" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="{helpers:Loc Key=NavAccountSettings}"
                                    Tag="FufuLauncher.ViewModels.AccountViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" FontFamily="{StaticResource ActionIconFont}" FontSize="24" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="{helpers:Loc Key=NavOtherFeatures}"
                                    Tag="FufuLauncher.ViewModels.OtherViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" FontFamily="{StaticResource ActionIconFont}" FontSize="24" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="{helpers:Loc Key=PluginMgmtTitle}"
                                    Tag="FufuLauncher.ViewModels.PluginViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B5;" FontFamily="{StaticResource ActionIconFont}" FontSize="24" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="{helpers:Loc Key=PluginStoreTitle}"
                                    Tag="FufuLauncher.ViewModels.PluginStoreViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" FontFamily="{StaticResource ActionIconFont}" FontSize="24" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="{helpers:Loc Key=NavHelpDocs}" Tag="FufuLauncher.ViewModels.HelpViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE82D;" FontFamily="{StaticResource ActionIconFont}" FontSize="24" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Grid Padding="10,0,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AccountNavButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="20"
                            Click="AccountNavButton_Click"
                            AutomationProperties.Name="{helpers:Loc Key=Account_MenuTitle}"
                            ToolTipService.ToolTip="{helpers:Loc Key=Account_MenuTitle}">
                        <Button.Flyout>
                            <Flyout x:Name="AccountFlyout"
                                    Placement="RightEdgeAlignedBottom"
                                    ShouldConstrainToRootBounds="True">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="MaxWidth" Value="400" />
                                        <Setter Property="Background"
                                                Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                                        <Setter Property="BorderBrush"
                                                Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="12" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <Border Width="300">
                                    <Grid>
                                        <StackPanel x:Name="AccountFlyoutProfilePanel"
                                                    Padding="18,16,18,14"
                                                    Spacing="14"
                                                    Visibility="Collapsed">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <PersonPicture x:Name="AccountFlyoutAvatar"
                                                               Width="52"
                                                               Height="52" />
                                                <TextBlock x:Name="AccountFlyoutNickname"
                                                           Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>

                                            <StackPanel Spacing="8">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{helpers:Loc Key=Account_Flyout_CommunityUid}" />
                                                    <TextBlock x:Name="AccountFlyoutCommunityUid"
                                                               Grid.Column="1"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Right"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{helpers:Loc Key=Account_Flyout_GameUid}" />
                                                    <TextBlock x:Name="AccountFlyoutGameUid"
                                                               Grid.Column="1"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Right"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{helpers:Loc Key=ServerLabel}" />
                                                    <TextBlock x:Name="AccountFlyoutServer"
                                                               Grid.Column="1"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Right"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{helpers:Loc Key=Account_Flyout_Level}" />
                                                    <TextBlock x:Name="AccountFlyoutLevel"
                                                               Grid.Column="1"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Right"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </StackPanel>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Padding="8,7"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        Click="AccountSwitchButton_Click"
                                                        ToolTipService.ToolTip="{helpers:Loc Key=Account_Flyout_SwitchAccount}">
                                                    <TextBlock FontSize="12"
                                                               Text="{helpers:Loc Key=Account_Flyout_SwitchAccount}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                </Button>
                                                <Button Grid.Column="1"
                                                        Padding="8,7"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        Click="RoleSwitchButton_Click"
                                                        ToolTipService.ToolTip="{helpers:Loc Key=Account_Flyout_SwitchRole}">
                                                    <TextBlock FontSize="12"
                                                               Text="{helpers:Loc Key=Account_Flyout_SwitchRole}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel x:Name="AccountFlyoutGuestPanel"
                                                    Padding="18,20,18,16"
                                                    Spacing="12">
                                            <FontIcon HorizontalAlignment="Center"
                                                      FontSize="32"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      Glyph="&#xE77B;" />
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="{helpers:Loc Key=Account_NotLoggedIn}" />
                                            <Button HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Click="AccountFlyoutGoToAccount_Click"
                                                    Content="{helpers:Loc Key=Account_Login}"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <Grid Width="32" Height="32" IsHitTestVisible="False">
                            <FontIcon x:Name="AccountNavPlaceholderIcon"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontFamily="{StaticResource ActionIconFont}"
                                      FontSize="24"
                                      Glyph="&#xE77B;"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <Grid CornerRadius="16">
                                <Image x:Name="AccountNavAvatar"
                                       Width="32"
                                       Height="32"
                                       Stretch="UniformToFill"
                                       helpers:ImageFadeInHelper.IsFadeInEnabled="True"
                                       helpers:ImageFadeInHelper.DurationMilliseconds="260"
                                       helpers:ImageFadeInHelper.EnableRetry="False" />
                            </Grid>
                        </Grid>
                    </Button>
                    <TextBlock x:Name="AccountNavText"
                               Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Text="{helpers:Loc Key=Account_MenuTitle}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" />
                </Grid>
            </NavigationView.PaneFooter>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="{helpers:Loc Key=NavSettings}"
                                    Tag="FufuLauncher.ViewModels.SettingsViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="SettingsIcon"
                                  Glyph="&#xE713;" FontFamily="{StaticResource ActionIconFont}"
                                  FontSize="24"
                                  RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform x:Name="SettingsIconRotation" Angle="0" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Background="Transparent" />
        </NavigationView>

        <Grid x:Name="SystemMessageBar"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,20"
              Height="40"
              CornerRadius="20"
              IsHitTestVisible="False"
              Visibility="Collapsed"
              Canvas.ZIndex="2000">

            <Grid.RenderTransform>
                <TranslateTransform x:Name="SystemMessageTranslate" Y="100" />
            </Grid.RenderTransform>

            <Border CornerRadius="20" BorderThickness="1" BorderBrush="#1A000000">
                <Border.Background>
                    <AcrylicBrush TintColor="#000000"
                                  TintOpacity="0.0"
                                  FallbackColor="#CC000000"
                                  Opacity="0.6" />
                </Border.Background>

                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8" Padding="16,0,16,0" VerticalAlignment="Center">
                <FontIcon x:Name="SystemMessageIcon" Glyph="&#xE774;" FontSize="16" />
                <TextBlock x:Name="SystemMessageText" Text="{helpers:Loc Key=SysStatusChecking}" FontSize="13"
                           FontWeight="Medium" />
            </StackPanel>
        </Grid>

        <Grid x:Name="NotificationContainer"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,24,24"
              Width="390"
              MaxHeight="450"
              Visibility="Collapsed"
              Canvas.ZIndex="3000">

            <Border CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Border.Background>
                    <ThemeResource ResourceKey="IosGlassBrush" />
                </Border.Background>
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="16,12,16,8">
                        <TextBlock Text="{helpers:Loc Key=NotificationCenter}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Spacing="4">
                            <Button ToolTipService.ToolTip="{helpers:Loc Key=NotificationPositionTitle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6,4"
                                    Click="NotificationSettings_Click">
                                <FontIcon Glyph="&#xE713;" FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <Button Content="{helpers:Loc Key=ClearAllBtn}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    FontSize="12"
                                    Padding="8,4"
                                    Click="ClearAllNotifications_Click" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="12,12,12,12">
                        <StackPanel x:Name="NotificationPanel"
                                    Orientation="Vertical"
                                    Spacing="8" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="AppTitleBar"
              Height="40"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Canvas.ZIndex="1000"
              Margin="80,0,140,0"
              IsHitTestVisible="False">

            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Padding="8,4,12,4"
                    Background="{ThemeResource IosGlassBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">

                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Image x:Name="TitleBarIcon" helpers:ImageFadeInHelper.IsFadeInEnabled="False" Width="20"
                           Height="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleBarText"
                               Text="{helpers:Loc Key=AppDisplayName}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="TitleBarVersionText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Foreground="#FFD700"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</windowex:WindowEx>