<Flyout
    x:Class="FufuLauncher.Tray.TrayContextMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:FufuLauncher.Helpers"
    xmlns:tray="using:FufuLauncher.Tray"
    ShouldConstrainToRootBounds="False">

    <Flyout.SystemBackdrop>
        <tray:InputActiveDesktopAcrylicBackdrop />
    </Flyout.SystemBackdrop>

    <Flyout.FlyoutPresenterStyle>
        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Flyout.FlyoutPresenterStyle>

    <Grid
        x:Name="Root"
        MinWidth="240"
        Background="Transparent">
        <Grid.Resources>
            <Style x:Key="TrayActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="MaxWidth" Value="92" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel
                Margin="10,8"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Image
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Source="/Assets/WindowIcon.ico" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource AppGlobalFont}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{Binding Title}" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                Margin="4,2,4,6"
                HorizontalAlignment="Center"
                Spacing="2">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        Command="{Binding LaunchGameCommand}"
                        Style="{StaticResource TrayActionButtonStyle}"
                        ToolTipService.ToolTip="{helpers:Loc Key=McpTool_StartGame}">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontFamily="{Binding TrayIconFont}"
                                FontSize="20"
                                Glyph="&#xE768;" />
                            <TextBlock
                                MaxWidth="64"
                                FontSize="12"
                                Text="{helpers:Loc Key=McpTool_StartGame}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding CheckinCommand}"
                        Style="{StaticResource TrayActionButtonStyle}"
                        ToolTipService.ToolTip="{helpers:Loc Key=TrayCheckin}">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontFamily="{Binding TrayIconFont}"
                                FontSize="20"
                                Glyph="&#xE787;" />
                            <TextBlock
                                MaxWidth="64"
                                FontSize="12"
                                Text="{helpers:Loc Key=TrayCheckin}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding SwitchServerCommand}"
                        Style="{StaticResource TrayActionButtonStyle}"
                        ToolTipService.ToolTip="{helpers:Loc Key=SwitchServerTitle}">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontFamily="{Binding TrayIconFont}"
                                FontSize="20"
                                Glyph="&#xE774;" />
                            <TextBlock
                                MaxWidth="64"
                                FontSize="12"
                                Text="{helpers:Loc Key=SwitchServerTitle}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        Command="{Binding ShowWindowCommand}"
                        Style="{StaticResource TrayActionButtonStyle}"
                        ToolTipService.ToolTip="{helpers:Loc Key=TrayShowWindow}">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontFamily="{Binding TrayIconFont}"
                                FontSize="20"
                                Glyph="&#xE80F;" />
                            <TextBlock
                                MaxWidth="64"
                                FontSize="12"
                                Text="{helpers:Loc Key=TrayShowWindow}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding McpCommand}"
                        Style="{StaticResource TrayActionButtonStyle}"
                        ToolTipService.ToolTip="{helpers:Loc Key=TrayMcp}">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontFamily="{Binding TrayIconFont}"
                                FontSize="20"
                                Glyph="&#xE713;" />
                            <TextBlock
                                MaxWidth="64"
                                FontSize="12"
                                Text="{helpers:Loc Key=TrayMcp}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding ExitCommand}"
                        Style="{StaticResource TrayActionButtonStyle}"
                        ToolTipService.ToolTip="{helpers:Loc Key=TrayExit}">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontFamily="{Binding TrayIconFont}"
                                FontSize="20"
                                Glyph="&#xE7E8;" />
                            <TextBlock
                                MaxWidth="64"
                                FontSize="12"
                                Text="{helpers:Loc Key=TrayExit}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Flyout>