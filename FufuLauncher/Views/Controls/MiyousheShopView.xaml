<UserControl x:Class="FufuLauncher.Views.MiyousheShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="using:FufuLauncher.Helpers"
             xmlns:views="using:FufuLauncher.Views">
    <UserControl.Resources>
        <views:MiyousheImageConverter x:Key="ShopImageConverter" />
    </UserControl.Resources>
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{helpers:Loc Key=MiyousheShop_Title}" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Border x:Name="ViewModeControls" Grid.Column="1" CornerRadius="8" Padding="3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="ListViewButton" Click="OnViewModeClick" IsChecked="True" IsEnabled="False"
                                  Padding="8,4" MinWidth="0" Background="Transparent" BorderThickness="0"
                                  AutomationProperties.Name="{helpers:Loc Key=PluginPage_ListViewTooltip}"
                                  ToolTipService.ToolTip="{helpers:Loc Key=PluginPage_ListViewTooltip}">
                        <FontIcon Glyph="&#xE8FD;" FontSize="15" />
                    </ToggleButton>
                    <ToggleButton x:Name="GridViewButton" Click="OnViewModeClick" IsEnabled="False"
                                  Padding="8,4" MinWidth="0" Background="Transparent" BorderThickness="0"
                                  AutomationProperties.Name="{helpers:Loc Key=PluginPage_GridViewTooltip}"
                                  ToolTipService.ToolTip="{helpers:Loc Key=PluginPage_GridViewTooltip}">
                        <FontIcon Glyph="&#xE80A;" FontSize="15" />
                    </ToggleButton>
                </StackPanel>
            </Border>
            <Button Grid.Column="2" Content="{helpers:Loc Key=Miyoushe_Refresh}" Click="OnRefresh" />
            <Button x:Name="PendantsButton" Grid.Column="3" Content="{helpers:Loc Key=MiyoushePendant_Open}"
                    Click="OnTogglePendants" />
            <Button x:Name="PlansButton" Grid.Column="4" Content="{helpers:Loc Key=MiyousheShop_Plans}"
                    Click="OnTogglePlans" />
        </Grid>
        <InfoBar x:Name="ShopStatus" Grid.Row="1" IsClosable="True" />
        <Grid Grid.Row="2">
            <Grid x:Name="CatalogPane" SizeChanged="OnCatalogSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition x:Name="DetailsColumn" Width="320" />
                </Grid.ColumnDefinitions>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressBar x:Name="ListProgress" IsIndeterminate="True" Visibility="Collapsed" />
                    <ListView x:Name="GoodsList" Grid.Row="1" SelectionChanged="OnGoodsChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="64" Height="64" CornerRadius="8"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Image Stretch="Uniform"
                                               Source="{Binding Icon, Converter={StaticResource ShopImageConverter}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   ToolTipService.ToolTip="{Binding Name}"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CatalogTimingText}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PriceText}" FontWeight="SemiBold"
                                                   TextAlignment="Right"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding StockText}" FontSize="12" TextAlignment="Right"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <GridView x:Name="GoodsGrid" Grid.Row="1" Visibility="Collapsed" SelectionMode="Single"
                              SelectionChanged="OnGoodsChanged" SizeChanged="OnGoodsGridSizeChanged"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="144" ItemHeight="242" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,6,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="10" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" CornerRadius="10" RowSpacing="4"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="108" />
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Image Margin="2" Stretch="Uniform"
                                               Source="{Binding Icon, Converter={StaticResource ShopImageConverter}}" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                               ToolTipService.ToolTip="{Binding Name}"
                                               MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Text="{Binding PriceText}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Row="3" Spacing="2">
                                        <TextBlock Text="{Binding StockText}" FontSize="12" />
                                        <TextBlock Text="{Binding CatalogTimingText}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <TextBlock x:Name="EmptyGoods" Grid.Row="1" Visibility="Collapsed" Margin="12,16"
                               IsHitTestVisible="False" Text="{helpers:Loc Key=MiyousheShop_EmptyGoods}"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="MoreGoods" Grid.Row="2" Content="{helpers:Loc Key=Miyoushe_More}"
                            Click="OnLoadMore" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                </Grid>

                <Thumb x:Name="DetailDivider" Grid.Column="1" IsTabStop="True" IsEnabled="False"
                       DragDelta="OnDetailsDragDelta" DragCompleted="OnDetailsDragCompleted"
                       KeyDown="OnDetailsSplitterKeyDown" PointerEntered="OnDetailsSplitterEntered"
                       PointerExited="OnDetailsSplitterExited"
                       AutomationProperties.Name="{helpers:Loc Key=MiyousheShop_ResizeDetails}"
                       ToolTipService.ToolTip="{helpers:Loc Key=MiyousheShop_ResizeDetails}">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Grip.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Grip.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Grip" Width="3" Height="40" CornerRadius="2" Opacity="0.45"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>

                <Border Grid.Column="2" CornerRadius="12" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <TextBlock x:Name="DetailsPlaceholder" Margin="16,20"
                                   Text="{helpers:Loc Key=MiyousheShop_SelectGoods}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Disabled" Visibility="Collapsed">
                            <StackPanel Spacing="14" Padding="16,16,16,18">
                                <TextBlock x:Name="GoodsName" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="88" Height="88" CornerRadius="8"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Image x:Name="GoodsImage" Margin="2" Stretch="Uniform"
                                               Source="{Binding Icon, Converter={StaticResource ShopImageConverter}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Name="GoodsPrice" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{helpers:Loc Key=MiyousheShop_CoinUnit}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Border Padding="8,4" CornerRadius="6" HorizontalAlignment="Left"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock x:Name="GoodsStock" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="GoodsTiming" Padding="12,10" CornerRadius="8" Visibility="Collapsed"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="GoodsOpeningLabel" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="GoodsOpening" FontSize="16" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="GoodsRestockQuantity" FontSize="13" TextWrapping="Wrap" />
                                        <TextBlock x:Name="GoodsCountdown" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="ScheduleButton" Click="OnSchedule" IsEnabled="False"
                                        HorizontalAlignment="Stretch" MinHeight="38" Visibility="Collapsed"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="{helpers:Loc Key=MiyousheShop_Schedule}" />
                                <Button x:Name="ExchangeButton" Click="OnExchangeNow" MinHeight="38"
                                        HorizontalAlignment="Stretch" Visibility="Collapsed"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="{helpers:Loc Key=MiyousheShop_ExchangeNow}" />
                                <ProgressBar x:Name="DetailProgress" IsIndeterminate="True" Visibility="Collapsed" />
                                <StackPanel x:Name="GoodsNotes" Spacing="8" Visibility="Collapsed">
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <TextBlock Text="{helpers:Loc Key=MiyousheShop_Notes}" FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="GoodsDetails" FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <HyperlinkButton Content="{helpers:Loc Key=MiyousheShop_OfficialGoods}"
                                                 Click="OnOpenSelectedGoods" Padding="0,4" FontSize="13" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="PlansPane" RowSpacing="12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{helpers:Loc Key=MiyousheShop_PlanHint}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="EmptyPlans" Grid.Row="1" Visibility="Collapsed"
                           Text="{helpers:Loc Key=MiyousheShop_EmptyPlans}" />
                <ListView x:Name="PlansList" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding GoodsName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding TimeText}" />
                                    <TextBlock Text="{Binding RecipientText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Result}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Tag="{Binding}" Click="OnOpenPlanGoods"
                                        Content="{Binding OfficialLinkText}" />
                                <Button Grid.Column="2" Tag="{Binding}" Click="OnResolvePlan"
                                        IsEnabled="{Binding CanResolve}"
                                        Content="{helpers:Loc Key=MiyousheShop_Resolve}" />
                                <Button Grid.Column="3" Tag="{Binding}" Click="OnRemovePlan"
                                        IsEnabled="{Binding CanRemove}"
                                        Content="{helpers:Loc Key=MiyousheShop_Remove}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Grid x:Name="PendantsPane" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{helpers:Loc Key=MiyoushePendant_Hint}" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox x:Name="OwnedOnlyCheck" Grid.Column="1" IsChecked="True"
                                  Content="{helpers:Loc Key=MiyoushePendant_OwnedOnly}" Click="OnOwnedOnlyChanged" />
                    </Grid>
                    <ProgressBar x:Name="PendantProgress" Grid.Row="1" IsIndeterminate="True" Visibility="Collapsed" />
                    <GridView x:Name="PendantGrid" Grid.Row="2" SelectionMode="Single"
                              SelectionChanged="OnPendantChanged"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="120" ItemHeight="150" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,6,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="10" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,8,8,6" RowSpacing="6"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                      CornerRadius="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="92" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Image Margin="2" Stretch="Uniform" Source="{Binding Icon}" />
                                    </Border>
                                    <FontIcon Glyph="&#xE72E;" FontSize="18" Margin="0,6,6,0"
                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Visibility="{Binding Owned, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}" />
                                    <Border Margin="6" Padding="5,2" CornerRadius="4" HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{Binding IsUsed, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{helpers:Loc Key=MiyoushePendant_Equipped}" FontSize="10"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" LineHeight="16"
                                               LineStackingStrategy="BlockLineHeight" MaxLines="2"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding Name}" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <TextBlock x:Name="EmptyPendants" Grid.Row="2" Margin="12,16" IsHitTestVisible="False"
                               Visibility="Collapsed" Text="{helpers:Loc Key=MiyoushePendant_Empty}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Border Grid.Column="1" CornerRadius="12" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <TextBlock x:Name="PendantPlaceholder" Margin="16,20"
                                   Text="{helpers:Loc Key=MiyoushePendant_Select}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ScrollViewer x:Name="PendantDetailsScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Disabled" Visibility="Collapsed">
                            <StackPanel Spacing="12" Padding="16,16,16,18">
                                <Grid Width="212" Height="212" HorizontalAlignment="Center">
                                    <Ellipse Width="160" Height="160" HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="PendantAvatarBrush" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <FontIcon x:Name="PendantAvatarFallback" Glyph="&#xE77B;" FontSize="56"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Image x:Name="PendantPreview" Width="160" Height="160" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <ScaleTransform ScaleX="1.32" ScaleY="1.32" />
                                        </Image.RenderTransform>
                                    </Image>
                                </Grid>
                                <TextBlock x:Name="PendantName" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Border x:Name="PendantStateBadge" Padding="8,4" CornerRadius="6"
                                        HorizontalAlignment="Left" Visibility="Collapsed"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock x:Name="PendantState" FontSize="12"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock x:Name="PendantDescription" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PendantAuthor" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PendantRemain" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Name="EquipPendantButton" Click="OnEquipPendant" MinHeight="38"
                                        HorizontalAlignment="Stretch" Visibility="Collapsed"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="{helpers:Loc Key=MiyoushePendant_Equip}" />
                                <Button x:Name="RemovePendantButton" Click="OnRemovePendant" MinHeight="34"
                                        HorizontalAlignment="Stretch" Visibility="Collapsed"
                                        Content="{helpers:Loc Key=MiyoushePendant_Remove}" />
                                <ProgressBar x:Name="PendantSaveProgress" IsIndeterminate="True" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>