<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="FufuLauncher.Views.Controls.CycleChallenge.RemoteImage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:FufuLauncher.Helpers"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid x:Name="RootGrid" Background="Transparent">

        <Border x:Name="PlaceholderBorder"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="4">
            <FontIcon x:Name="PlaceholderGlyph"
                      Glyph="&#xE91B;"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      FontSize="18"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False" />
        </Border>


        <Image x:Name="ContentImage"
               Stretch="Uniform"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               helpers:ImageFadeInHelper.IsFadeInEnabled="True"
               helpers:ImageFadeInHelper.DurationMilliseconds="260"
               helpers:ImageFadeInHelper.EnableRetry="False"
               Opacity="0" />
    </Grid>
</UserControl>