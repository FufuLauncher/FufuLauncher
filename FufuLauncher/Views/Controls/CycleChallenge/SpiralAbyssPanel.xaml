<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="FufuLauncher.Views.Controls.CycleChallenge.SpiralAbyssPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:FufuLauncher.Helpers"
    xmlns:local="using:FufuLauncher.Views.Controls.CycleChallenge"
    xmlns:models="using:FufuLauncher.Models.CycleChallenge"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <UserControl.Resources>

        <Style x:Key="AbyssCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="AbyssInnerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,9" />
        </Style>

        <Style x:Key="AbyssLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
        </Style>

        <Style x:Key="AbyssCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
        </Style>

        <DataTemplate x:Key="KpiCardTemplate" x:DataType="local:SpiralAbyssKpiCard">
            <Border MinHeight="86" Style="{StaticResource AbyssCardStyle}">
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Style="{StaticResource AbyssLabelStyle}"
                               Text="{x:Bind Title}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="22"
                               FontWeight="Bold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Text="{x:Bind ValueText}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BattleAvatarTemplate" x:DataType="models:SpiralAbyssAvatar">
            <local:AvatarCard Margin="0,0,6,0"
                              AvatarId="{x:Bind AvatarId}"
                              CardWidth="68"
                              IconUrl="{x:Bind IconUrl}"
                              Level="{x:Bind Level}"
                              Rarity="{x:Bind Rarity}" />
        </DataTemplate>

        <DataTemplate x:Key="LevelTemplate" x:DataType="models:SpiralAbyssLevel">
            <Border Margin="0,0,0,8" Style="{StaticResource AbyssInnerCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" MinWidth="34" VerticalAlignment="Center" Spacing="2">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Text="{x:Bind IndexText}" />
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="10"
                                   Text="{x:Bind StarText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Text="{helpers:Loc Key=Abyss_UpperHalf}" />
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource AbyssCaptionStyle}"
                                       Text="{x:Bind UpperTimeText}" />
                        </StackPanel>
                        <ItemsControl ItemTemplate="{StaticResource BattleAvatarTemplate}"
                                      ItemsSource="{x:Bind UpperAvatars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <Rectangle Grid.Column="2"
                               Width="1"
                               Margin="0,2"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Text="{helpers:Loc Key=Abyss_LowerHalf}" />
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource AbyssCaptionStyle}"
                                       Text="{x:Bind LowerTimeText}" />
                        </StackPanel>
                        <ItemsControl ItemTemplate="{StaticResource BattleAvatarTemplate}"
                                      ItemsSource="{x:Bind LowerAvatars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FloorTemplate" x:DataType="models:SpiralAbyssFloor">
            <Border Margin="0,0,0,10" Style="{StaticResource AbyssCardStyle}">
                <StackPanel Spacing="10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       Text="{x:Bind IndexText}" />
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource AbyssLabelStyle}"
                                       Text="{helpers:Loc Key=Abyss_Floor}" />
                            <local:RemoteImage Width="22" Height="22" Source="{x:Bind AbyssStar}" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind StarText}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource AbyssLabelStyle}"
                                   Text="{helpers:Loc Key=CycleChallenge_NotUnlocked}"
                                   Visibility="{x:Bind IsLocked, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <StackPanel Spacing="4"
                                Visibility="{x:Bind ShowSplitLeyLine, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource AbyssLabelStyle}"
                                   Text="{helpers:Loc Key=Abyss_LeyLineDisorder}" />
                        <StackPanel Spacing="2"
                                    Visibility="{x:Bind HasUpperLeyLine, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Text="{helpers:Loc Key=Abyss_UpperHalf}" />
                            <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind UpperLeyLineText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="2"
                                    Visibility="{x:Bind HasLowerLeyLine, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Text="{helpers:Loc Key=Abyss_LowerHalf}" />
                            <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind LowerLeyLineText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="4"
                                Visibility="{x:Bind ShowCommonLeyLine, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource AbyssLabelStyle}"
                                   Text="{helpers:Loc Key=Abyss_LeyLineDisorder}" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind LeyLineText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ItemsControl ItemTemplate="{StaticResource LevelTemplate}" ItemsSource="{x:Bind Levels}" />

                    <TextBlock Style="{StaticResource AbyssCaptionStyle}"
                               Text="--"
                               Visibility="{x:Bind HasLevels, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RankRowTemplate" x:DataType="models:SpiralAbyssRankRow">
            <StackPanel Width="62" Margin="0,0,10,0" Spacing="2">
                <local:AvatarCard AvatarId="{x:Bind AvatarId}"
                                  CardWidth="56"
                                  HorizontalAlignment="Center"
                                  IconUrl="{x:Bind IconUrl}"
                                  Rarity="{x:Bind Rarity}" />
                <TextBlock HorizontalAlignment="Center"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ValueText}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RankSectionRowTemplate" x:DataType="local:SpiralAbyssRankSectionView">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind Title}"
                           TextTrimming="CharacterEllipsis" />
                <ItemsControl Grid.Column="1"
                              ItemTemplate="{StaticResource RankRowTemplate}"
                              ItemsSource="{x:Bind Rows}"
                              Visibility="{x:Bind HasRows, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Style="{StaticResource AbyssCaptionStyle}"
                           Text="--"
                           Visibility="{x:Bind HasRows, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <StackPanel Margin="0,0,6,0"
                    HorizontalAlignment="Stretch"
                    Spacing="14">

            <Border Style="{StaticResource AbyssInnerCardStyle}"
                    Visibility="{x:Bind ShowSkippedFloor, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Text="{helpers:Loc Key=Abyss_SkippedFloor}" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind SkippedFloorText}" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="14"
                        Visibility="{x:Bind ShowContent, Converter={StaticResource BoolToVisibilityConverter}}">

                <ItemsRepeater ItemTemplate="{StaticResource KpiCardTemplate}" ItemsSource="{x:Bind KpiCards}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="Fill"
                                           MinColumnSpacing="10"
                                           MinItemHeight="86"
                                           MinItemWidth="132"
                                           MinRowSpacing="10" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <Border Style="{StaticResource AbyssCardStyle}"
                        Visibility="{x:Bind ShowRanks, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Text="{helpers:Loc Key=Abyss_BattleStats}" />
                        <ItemsControl ItemTemplate="{StaticResource RankSectionRowTemplate}"
                                      ItemsSource="{x:Bind RankSections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ItemsRepeater ItemTemplate="{StaticResource FloorTemplate}" ItemsSource="{x:Bind Floors}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="0" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <Border MinHeight="180"
                    Style="{StaticResource AbyssCardStyle}"
                    Visibility="{x:Bind ShowEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind EmptyText}" />
                </StackPanel>
            </Border>

            <Border MinHeight="180"
                    Style="{StaticResource AbyssCardStyle}"
                    Visibility="{x:Bind ShowLocked, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind LockedText}" />
                </StackPanel>
            </Border>

            <Border MinHeight="180"
                    Style="{StaticResource AbyssCardStyle}"
                    Visibility="{x:Bind ShowError, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Text="{x:Bind ErrorText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>