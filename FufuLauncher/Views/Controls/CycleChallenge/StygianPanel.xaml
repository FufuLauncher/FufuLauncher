<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="FufuLauncher.Views.Controls.CycleChallenge.StygianPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="using:FufuLauncher.Views.Controls.CycleChallenge"
    xmlns:helpers="using:FufuLauncher.Helpers"
    xmlns:models="using:FufuLauncher.Models.CycleChallenge"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <UserControl.Resources>
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="StageCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="ModeChipStyle" TargetType="primitives:ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
        </Style>
        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="IsTextScaleFactorEnabled" Value="False" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
        </Style>
        <Style x:Key="SecondaryCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
        </Style>
    </UserControl.Resources>

    <StackPanel Padding="0,0,0,8" Spacing="12">

        <StackPanel
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind Display.HasState, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="32"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE7BA;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="16"
                Text="{x:Bind Display.StateTitle, Mode=OneTime}" />
            <TextBlock
                MaxWidth="420"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Display.StateDetail, Mode=OneTime}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind Display.HasStateDetail, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <StackPanel Spacing="12"
                    Visibility="{x:Bind Display.ShowContent, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">

            <StackPanel Spacing="2">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind Display.HasScheduleName, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        VerticalAlignment="Bottom"
                        Style="{StaticResource KpiLabelStyle}"
                        Text="{helpers:Loc Key=Stygian_ScheduleName}" />
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind Display.ScheduleName, Mode=OneTime}" />
                </StackPanel>
                <TextBlock
                    Style="{StaticResource SecondaryCaptionStyle}"
                    Text="{x:Bind Display.PeriodText, Mode=OneTime}"
                    Visibility="{x:Bind Display.HasPeriod, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <primitives:ToggleButton
                    x:Name="SoloChip"
                    Click="OnSoloChipClick"
                    Content="{helpers:Loc Key=Stygian_Solo}"
                    IsChecked="{x:Bind IsSoloSelected, Mode=OneTime}"
                    Style="{StaticResource ModeChipStyle}" />
                <primitives:ToggleButton
                    x:Name="CoopChip"
                    Click="OnCoopChipClick"
                    Content="{helpers:Loc Key=Stygian_Coop}"
                    IsChecked="{x:Bind IsCoopSelected, Mode=OneTime}"
                    Style="{StaticResource ModeChipStyle}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{helpers:Loc Key=Stygian_NoCoopData}"
                    Visibility="{x:Bind ShowNoCoopHint, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <cc:RemoteImage
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            Source="{x:Bind Mode.DifficultyIconPath, Mode=OneTime}"
                            Visibility="{x:Bind Mode.HasDifficultyIcon, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource KpiLabelStyle}"
                                       Text="{helpers:Loc Key=Stygian_Difficulty}" />
                            <TextBlock Style="{StaticResource KpiValueStyle}" FontSize="16"
                                       Text="{x:Bind Mode.DifficultyName, Mode=OneTime}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource KpiLabelStyle}" Text="{helpers:Loc Key=Stygian_BestTime}" />
                        <TextBlock Style="{StaticResource KpiValueStyle}"
                                   Text="{x:Bind Mode.BestTimeText, Mode=OneTime}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource KpiLabelStyle}" Text="{helpers:Loc Key=Stygian_ExtremeValue}" />
                        <TextBlock Style="{StaticResource KpiValueStyle}"
                                   Text="{x:Bind Mode.ExtremeValueText, Mode=OneTime}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Mode.EmptyText, Mode=OneTime}"
                Visibility="{x:Bind ShowModeEmpty, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />

            <StackPanel Spacing="8"
                        Visibility="{x:Bind Mode.HasChallenges, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{helpers:Loc Key=Stygian_Stage}" />
                <ItemsRepeater ItemsSource="{x:Bind Mode.Challenges, Mode=OneTime}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:StygianChallenge">
                            <Border Style="{StaticResource StageCardStyle}">
                                <StackPanel Spacing="10">

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <cc:RemoteImage
                                            Width="56"
                                            Height="56"
                                            VerticalAlignment="Top"
                                            Source="{x:Bind Monster.IconUrl}"
                                            Visibility="{x:Bind Monster.IsPresent, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Style="{StaticResource SecondaryCaptionStyle}"
                                                           Text="{x:Bind Monster.DisplayName}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryCaptionStyle}"
                                                    Text="{x:Bind Monster.LevelText}"
                                                    Visibility="{x:Bind Monster.HasLevel, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource KpiLabelStyle}"
                                                Text="{helpers:Loc Key=Stygian_UseTime}" />
                                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind TimeText}" />
                                        </StackPanel>
                                    </Grid>

                                    <RichTextBlock
                                        x:Name="MonsterDescriptionText"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Loaded="OnMonsterDescriptionLoaded"
                                        Tag="{x:Bind Monster}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind Monster.HasDescriptions, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <StackPanel Spacing="6"
                                                Visibility="{x:Bind HasTeam, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource KpiLabelStyle}"
                                                   Text="{helpers:Loc Key=Stygian_Team}" />
                                        <ItemsControl ItemsSource="{x:Bind Team}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="10" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:StygianAvatar">
                                                    <cc:AvatarCard
                                                        AvatarId="{x:Bind AvatarId}"
                                                        CardWidth="78"
                                                        CharacterName="{x:Bind DisplayName}"
                                                        IconUrl="{x:Bind IconUrl}"
                                                        Level="{x:Bind Level}"
                                                        Rarity="{x:Bind Rarity}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Spacing="6"
                                                Visibility="{x:Bind HasBestAvatars, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource KpiLabelStyle}"
                                                   Text="{helpers:Loc Key=Stygian_BestAvatar}" />
                                        <ItemsControl ItemsSource="{x:Bind BestAvatars}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:StygianBestAvatar">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <cc:AvatarCard
                                                            AvatarId="{x:Bind AvatarId}"
                                                            CardWidth="60"
                                                            IconUrl="{x:Bind IconUrl}" />
                                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock
                                                                Style="{StaticResource SecondaryCaptionStyle}"
                                                                Text="{x:Bind TypeText}"
                                                                Visibility="{x:Bind HasTypeText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ValueText}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <Border Style="{StaticResource SectionCardStyle}"
                    Visibility="{x:Bind Display.HasBlings, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{helpers:Loc Key=Stygian_BlingAvatars}" />
                    <ItemsControl ItemsSource="{x:Bind Display.Blings, Mode=OneTime}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid
                                    ItemHeight="96"
                                    ItemWidth="82"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:StygianBling">
                                <cc:AvatarCard
                                    AvatarId="{x:Bind AvatarId}"
                                    CardWidth="72"
                                    CharacterName="{x:Bind DisplayName}"
                                    HorizontalAlignment="Center"
                                    IconUrl="{x:Bind IconUrl}"
                                    Opacity="{x:Bind IconOpacity}"
                                    Rarity="{x:Bind Rarity}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>