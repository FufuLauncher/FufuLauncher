<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FufuLauncher.Views.Controls.CycleChallenge.AvatarCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="using:FufuLauncher.Views.Controls.CycleChallenge"
    xmlns:controls="using:FufuLauncher.Controls"
    HorizontalAlignment="Left"
    VerticalAlignment="Top">

    <Grid
        x:Name="Root"
        Background="Transparent"
        UseLayoutRounding="True">

        <Border
            x:Name="CardBorder"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="PortraitHost"
                    Grid.Row="0"
                    Width="66"
                    Height="66">
                    <controls:ItemRarityBackground x:Name="RarityBackground" CornerRadius="9,9,0,0">
                        <Grid>
                            <cc:RemoteImage x:Name="AvatarImage" />

                            <Border
                                x:Name="RarityBadge"
                                Margin="0,5,5,0"
                                Padding="4,1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#B3000000"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    VerticalAlignment="Center">
                                    <FontIcon
                                        x:Name="StarGlyph"
                                        VerticalAlignment="Center"
                                        FontSize="7"
                                        Foreground="#FFFFD86B"
                                        Glyph="&#xE735;" />
                                    <TextBlock
                                        x:Name="RarityText"
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="White" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="LevelBadge"
                                Margin="0,0,5,5"
                                Padding="5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="#B3000000"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="LevelText"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="White" />
                            </Border>
                        </Grid>
                    </controls:ItemRarityBackground>

                    <TextBlock
                        x:Name="FallbackText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="#CCFFFFFF"
                        IsHitTestVisible="False"
                        Text="?"
                        Visibility="Collapsed" />
                </Grid>

                <StackPanel
                    x:Name="InfoPanel"
                    Grid.Row="1"
                    Margin="4,1"
                    VerticalAlignment="Center"
                    Spacing="0">
                    <TextBlock
                        x:Name="NameText"
                        HorizontalAlignment="Stretch"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        LineStackingStrategy="BlockLineHeight"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        x:Name="CaptionText"
                        HorizontalAlignment="Stretch"
                        FontSize="9.5"
                        LineStackingStrategy="BlockLineHeight"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>