<UserControl
    x:Class="FufuLauncher.Views.Controls.CycleChallenge.TheaterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="using:FufuLauncher.Views.Controls.CycleChallenge"
    xmlns:helpers="using:FufuLauncher.Helpers"
    xmlns:models="using:FufuLauncher.Models.CycleChallenge">

    <UserControl.Resources>
        <!--  KPI 卡片  -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <!--  区块卡片  -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <!--  单幕卡片  -->
        <Style x:Key="RoundCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <!--  KPI 标题  -->
        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
        </Style>
        <!--  KPI 数值  -->
        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="IsTextScaleFactorEnabled" Value="False" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
        </Style>
        <!--  区块标题  -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
        </Style>
        <!--  小号次要文本  -->
        <Style x:Key="SecondaryCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
        </Style>
    </UserControl.Resources>

    <StackPanel Padding="0,0,0,8" Spacing="12">

        <!--  空态 / 未解锁 / 解析失败  -->
        <StackPanel
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind Display.HasState, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="32"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE7BA;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="16"
                Text="{x:Bind Display.StateTitle, Mode=OneTime}" />
            <TextBlock
                MaxWidth="420"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Display.StateDetail, Mode=OneTime}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind Display.HasStateDetail, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <!--  内容区  -->
        <StackPanel Spacing="12"
                    Visibility="{x:Bind Display.ShowContent, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">

            <!--  头部：难度 + 期次  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <cc:RemoteImage
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Source="{x:Bind Display.HeraldryIconPath, Mode=OneTime}"
                    Visibility="{x:Bind Display.HasHeraldryIcon, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind Display.DifficultyName, Mode=OneTime}" />
                    <TextBlock
                        Style="{StaticResource SecondaryCaptionStyle}"
                        Text="{x:Bind Display.PeriodText, Mode=OneTime}"
                        Visibility="{x:Bind Display.HasPeriod, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Grid>

            <!--  KPI：4 列 × 2 行  -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource KpiLabelStyle}" Text="{helpers:Loc Key=Theater_Difficulty}" />
                        <TextBlock Style="{StaticResource KpiValueStyle}"
                                   Text="{x:Bind Display.DifficultyName, Mode=OneTime}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource KpiLabelStyle}" Text="{helpers:Loc Key=Theater_MaxRound}" />
                        <TextBlock Style="{StaticResource KpiValueStyle}"
                                   Text="{x:Bind Display.MaxRoundText, Mode=OneTime}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource KpiCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource KpiLabelStyle}" Text="{helpers:Loc Key=Theater_Medals}" />
                        <!--  挑战星章：逐幕图标（参考 Hutao：普通幕星章 / 塔罗轮塔罗牌）  -->
                        <ItemsControl ItemsSource="{x:Bind Display.MedalIcons, Mode=OneTime}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="22" ItemHeight="22" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TheaterMedalIcon">
                                    <cc:RemoteImage Width="20" Height="20" Source="{x:Bind IconPath}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource KpiLabelStyle}" Text="{helpers:Loc Key=Theater_Coins}" />
                        <TextBlock Style="{StaticResource KpiValueStyle}"
                                   Text="{x:Bind Display.CoinText, Mode=OneTime}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource KpiLabelStyle}" Text="{helpers:Loc Key=Theater_AvatarBonus}" />
                        <TextBlock Style="{StaticResource KpiValueStyle}"
                                   Text="{x:Bind Display.AvatarBonusText, Mode=OneTime}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource KpiCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource KpiLabelStyle}" Text="{helpers:Loc Key=Theater_Rent}" />
                        <TextBlock Style="{StaticResource KpiValueStyle}"
                                   Text="{x:Bind Display.RentText, Mode=OneTime}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  战斗统计  -->
            <Border Style="{StaticResource SectionCardStyle}"
                    Visibility="{x:Bind Display.ShowBattleStats, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <!--  战斗统计  -->
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{helpers:Loc Key=Theater_BattleStats}" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                                   Text="{helpers:Loc Key=Theater_TotalTime}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind Display.BattleTotalTimeText, Mode=OneTime}"
                            Visibility="{x:Bind Display.HasBattleTotalTime, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                   Text="{helpers:Loc Key=Theater_MaxDamage}" />
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind Display.HasMaxDamage, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                            <cc:AvatarCard
                                AvatarId="{x:Bind Display.MaxDamageAvatarId, Mode=OneTime}"
                                CardWidth="60"
                                IconUrl="{x:Bind Display.MaxDamageIconUrl, Mode=OneTime}"
                                Rarity="{x:Bind Display.MaxDamageRarity, Mode=OneTime}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{x:Bind Display.MaxDamageValueText, Mode=OneTime}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                                   Text="{helpers:Loc Key=Theater_MaxDefeat}" />
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind Display.HasMaxDefeat, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                            <cc:AvatarCard
                                AvatarId="{x:Bind Display.MaxDefeatAvatarId, Mode=OneTime}"
                                CardWidth="60"
                                IconUrl="{x:Bind Display.MaxDefeatIconUrl, Mode=OneTime}"
                                Rarity="{x:Bind Display.MaxDefeatRarity, Mode=OneTime}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{x:Bind Display.MaxDefeatValueText, Mode=OneTime}" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"
                                   Text="{helpers:Loc Key=Theater_MaxTakeDamage}" />
                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind Display.HasMaxTakeDamage, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                            <cc:AvatarCard
                                AvatarId="{x:Bind Display.MaxTakeDamageAvatarId, Mode=OneTime}"
                                CardWidth="60"
                                IconUrl="{x:Bind Display.MaxTakeDamageIconUrl, Mode=OneTime}"
                                Rarity="{x:Bind Display.MaxTakeDamageRarity, Mode=OneTime}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{x:Bind Display.MaxTakeDamageValueText, Mode=OneTime}" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
                                   Text="{helpers:Loc Key=Theater_ShortestClear}" />
                        <ItemsControl
                            Grid.Row="4"
                            Grid.Column="1"
                            ItemsSource="{x:Bind Display.ShortestClear, Mode=OneTime}"
                            Visibility="{x:Bind Display.HasShortestClear, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TheaterAvatarDamage">
                                    <cc:AvatarCard
                                        AvatarId="{x:Bind AvatarId}"
                                        CardWidth="60"
                                        IconUrl="{x:Bind IconUrl}"
                                        Rarity="{x:Bind Rarity}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  待命角色  -->
            <Border Style="{StaticResource SectionCardStyle}"
                    Visibility="{x:Bind Display.HasBackupAvatars, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="10" ScrollViewer.VerticalScrollMode="Auto">
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="{helpers:Loc Key=Theater_BackupAvatars}" />
                    <ItemsRepeater ItemsSource="{x:Bind Display.BackupAvatars, Mode=OneTime}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinColumnSpacing="8"
                                MinItemHeight="98"
                                MinItemWidth="74"
                                MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:TheaterAvatar">
                                <cc:AvatarCard
                                    AvatarId="{x:Bind AvatarId}"
                                    Caption="{x:Bind TypeText}"
                                    CardWidth="66"
                                    CharacterName="{x:Bind DisplayName}"
                                    HorizontalAlignment="Center"
                                    IconUrl="{x:Bind IconUrl}"
                                    Level="{x:Bind Level}"
                                    Rarity="{x:Bind Rarity}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!--  逐幕  -->
            <Border Style="{StaticResource SectionCardStyle}"
                    Visibility="{x:Bind Display.HasRounds, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <!--  演出回顾  -->
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{helpers:Loc Key=Theater_Review}" />
                    <ItemsRepeater ItemsSource="{x:Bind Display.Rounds, Mode=OneTime}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:TheaterRound">
                                <Border Style="{StaticResource RoundCardStyle}">
                                    <StackPanel Spacing="10">

                                        <!--  幕标题（星章图标在幕数前）/ 完成时间  -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <cc:RemoteImage
                                                    Width="20"
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    Source="{x:Bind MedalIconPath}"
                                                    Visibility="{x:Bind HasMedalIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Title}" />
                                                <cc:RemoteImage
                                                    Width="22"
                                                    Height="22"
                                                    VerticalAlignment="Center"
                                                    Source="{x:Bind TarotIconPath}"
                                                    Visibility="{x:Bind HasTarotIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind FinishTimeText}"
                                                Visibility="{x:Bind HasFinishTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>

                                        <!--  敌人  -->
                                        <StackPanel Spacing="6"
                                                    Visibility="{x:Bind HasEnemies, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource KpiLabelStyle}"
                                                       Text="{helpers:Loc Key=Theater_Enemies}" />
                                            <ItemsControl ItemsSource="{x:Bind Enemies}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:TheaterEnemy">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <cc:RemoteImage Width="28" Height="28"
                                                                            Source="{x:Bind IconUrl}" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock FontSize="12" Text="{x:Bind DisplayName}" />
                                                                <TextBlock
                                                                    Style="{StaticResource SecondaryCaptionStyle}"
                                                                    FontSize="11"
                                                                    Text="{x:Bind LevelText}"
                                                                    Visibility="{x:Bind HasLevel, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!--  出战角色  -->
                                        <ItemsControl ItemsSource="{x:Bind Avatars}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="10" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:TheaterAvatar">
                                                    <cc:AvatarCard
                                                        AvatarId="{x:Bind AvatarId}"
                                                        Caption="{x:Bind TypeText}"
                                                        CardWidth="78"
                                                        CharacterName="{x:Bind DisplayName}"
                                                        IconUrl="{x:Bind IconUrl}"
                                                        Level="{x:Bind Level}"
                                                        Rarity="{x:Bind Rarity}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--  辉彩祝福：汇总描述 + 祝福图标（悬浮显示等级效果）  -->
                                        <StackPanel Spacing="6"
                                                    Visibility="{x:Bind HasSplendour, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource KpiLabelStyle}"
                                                       Text="{helpers:Loc Key=Theater_SplendourBuffs}" />
                                            <RichTextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Loaded="OnSplendourSummaryLoaded"
                                                Tag="{x:Bind SplendourSummary}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind HasSplendourSummary, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ItemsControl ItemsSource="{x:Bind SplendourBuffs}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="10" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:TheaterSplendourBuff">
                                                        <Grid>
                                                            <ToolTipService.ToolTip>
                                                                <StackPanel MaxWidth="380" Spacing="6">
                                                                    <TextBlock FontWeight="SemiBold"
                                                                               Text="{x:Bind Name}" />
                                                                    <RichTextBlock
                                                                        FontSize="12"
                                                                        Loaded="OnSplendourTooltipLoaded"
                                                                        Tag="{x:Bind}"
                                                                        TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </ToolTipService.ToolTip>
                                                            <cc:RemoteImage
                                                                Width="40"
                                                                Height="40"
                                                                Source="{x:Bind IconUrl}"
                                                                Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            <Border
                                                                Padding="5,1"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                CornerRadius="9"
                                                                Visibility="{x:Bind HasLevel, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                    Text="{x:Bind LevelText}" />
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!--  神秘收获：事件卡图标（悬浮显示名称与效果）  -->
                                        <StackPanel Spacing="6"
                                                    Visibility="{x:Bind HasChoiceCards, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource KpiLabelStyle}"
                                                       Text="{helpers:Loc Key=Theater_ChoiceCards}" />
                                            <ItemsControl ItemsSource="{x:Bind ChoiceCards}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:TheaterBuff">
                                                        <Grid>
                                                            <ToolTipService.ToolTip>
                                                                <StackPanel MaxWidth="380" Spacing="6">
                                                                    <TextBlock FontWeight="SemiBold"
                                                                               Text="{x:Bind Name}" />
                                                                    <RichTextBlock
                                                                        FontSize="12"
                                                                        Loaded="OnBuffTooltipLoaded"
                                                                        Tag="{x:Bind}"
                                                                        TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </ToolTipService.ToolTip>
                                                            <cc:RemoteImage
                                                                Width="36"
                                                                Height="36"
                                                                Source="{x:Bind IconUrl}"
                                                                Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!--  无逐幕明细提示  -->
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{helpers:Loc Key=Theater_NoDetail}"
                Visibility="{x:Bind Display.HasNoRounds, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
    </StackPanel>
</UserControl>