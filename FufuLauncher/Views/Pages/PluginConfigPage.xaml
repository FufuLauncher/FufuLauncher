<Page
    x:Class="FufuLauncher.Views.PluginConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FufuLauncher.Models"
    xmlns:selectors="using:FufuLauncher.Selectors"
    xmlns:helpers="using:FufuLauncher.Helpers"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <CollectionViewSource x:Name="ConfigOptionsViewSource" IsSourceGrouped="True" ItemsPath="Items" />

        <DataTemplate x:Key="OptionHeaderTemplate" x:DataType="models:PluginConfigOption">
            <Grid MinHeight="20" Margin="0,0,0,8" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind DisplayName}"
                           MaxWidth="{x:Bind HeaderTextMaxWidth}"
                           Style="{StaticResource PluginSettingLabelStyle}"
                           ToolTipService.ToolTip="{x:Bind ToolTipText}" />
                <Button Grid.Column="1"
                        Margin="4,0,0,0"
                        Style="{StaticResource PluginSettingActionButtonStyle}"
                        Visibility="{x:Bind HasDescription, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTipService.ToolTip="{helpers:Loc Key=ViewHelpTooltip}"
                        AutomationProperties.Name="{helpers:Loc Key=ViewHelpTooltip}">
                    <FontIcon Glyph="&#xE9CE;" FontSize="12" />
                    <Button.Flyout>
                        <Flyout Placement="Right">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MaxWidth" Value="640" />
                                    <Setter Property="MaxHeight" Value="480" />
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <ScrollViewer MaxHeight="420" HorizontalScrollMode="Disabled"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8" MaxWidth="560">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="2" Margin="4,0,0,0" Tag="{x:Bind}" Click="OnPinOptionClick"
                        Style="{StaticResource PluginSettingActionButtonStyle}"
                        Opacity="{x:Bind PinOpacity, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind PinTooltip, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind PinGlyph, Mode=OneWay}" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BooleanOptionTemplate" x:DataType="models:PluginConfigOption">
            <StackPanel Style="{StaticResource PluginSettingContainerStyle}">
                <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource OptionHeaderTemplate}"
                                HorizontalContentAlignment="Stretch" IsTabStop="False" />
                <ToggleSwitch IsOn="{x:Bind BooleanValue, Mode=TwoWay}"
                              OnContent="{helpers:Loc Key=OnLabel}" OffContent="{helpers:Loc Key=OffLabel}"
                              MinWidth="0" Margin="0"
                              AutomationProperties.Name="{x:Bind DisplayName}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NumberOptionTemplate" x:DataType="models:PluginConfigOption">
            <StackPanel Style="{StaticResource PluginSettingContainerStyle}">
                <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource OptionHeaderTemplate}"
                                HorizontalContentAlignment="Stretch" IsTabStop="False" />
                <NumberBox Value="{x:Bind NumberValue, Mode=TwoWay}"
                           Minimum="{x:Bind Minimum}" Maximum="{x:Bind Maximum}"
                           SmallChange="{x:Bind SmallChange}" LargeChange="10"
                           SpinButtonPlacementMode="Inline" Width="200" HorizontalAlignment="Left"
                           AutomationProperties.Name="{x:Bind DisplayName}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TextOptionTemplate" x:DataType="models:PluginConfigOption">
            <StackPanel Style="{StaticResource PluginSettingContainerStyle}">
                <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource OptionHeaderTemplate}"
                                HorizontalContentAlignment="Stretch" IsTabStop="False" />
                <TextBox Text="{x:Bind Value, Mode=OneWay}" Tag="{x:Bind}"
                         TextChanged="OnTextOptionChanged"
                         PlaceholderText="{helpers:Loc Key=PluginConfigPage_ValuePlaceholder}"
                         Width="200" HorizontalAlignment="Left"
                         AutomationProperties.Name="{x:Bind DisplayName}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceOptionTemplate" x:DataType="models:PluginConfigOption">
            <StackPanel Style="{StaticResource PluginSettingContainerStyle}">
                <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource OptionHeaderTemplate}"
                                HorizontalContentAlignment="Stretch" IsTabStop="False" />
                <Grid>
                    <ComboBox ItemsSource="{x:Bind Choices, Mode=OneWay}"
                              SelectedItem="{x:Bind SelectedChoice, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              Visibility="{x:Bind ShowChoiceList, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              Width="200" HorizontalAlignment="Left"
                              AutomationProperties.Name="{x:Bind DisplayName}" />
                    <NumberBox Value="{x:Bind KeyNumberValue, Mode=TwoWay}"
                               Minimum="-2147483648" Maximum="2147483647"
                               SmallChange="1" SpinButtonPlacementMode="Inline"
                               Visibility="{x:Bind ShowKeyNumber, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                               Width="200" HorizontalAlignment="Left"
                               AutomationProperties.Name="{x:Bind DisplayName}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <selectors:PluginConfigTemplateSelector x:Key="OptionTemplateSelector"
                                                BooleanTemplate="{StaticResource BooleanOptionTemplate}"
                                                NumberTemplate="{StaticResource NumberOptionTemplate}"
                                                TextTemplate="{StaticResource TextOptionTemplate}"
                                                ChoiceTemplate="{StaticResource ChoiceOptionTemplate}" />

        <Storyboard x:Name="EntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootLayoutGrid"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PageTranslation"
                             Storyboard.TargetProperty="Y"
                             From="40" To="0" Duration="0:0:0.3"
                             EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="ExitStoryboard" Completed="OnExitStoryboardCompleted">
            <DoubleAnimation Storyboard.TargetName="RootLayoutGrid"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PageTranslation"
                             Storyboard.TargetProperty="Y"
                             To="40" Duration="0:0:0.3"
                             EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid x:Name="RootLayoutGrid" Padding="32,24,32,24" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PageTranslation" Y="40" />
        </Grid.RenderTransform>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootLayoutGrid.Padding" Value="24" />
                        <Setter Target="PluginMetadataPanel.(Grid.Row)" Value="1" />
                        <Setter Target="PluginMetadataPanel.(Grid.Column)" Value="0" />
                        <Setter Target="PluginMetadataPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="PluginMetadataPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="PluginMetadataPanel.Margin" Value="0,12,0,0" />
                        <Setter Target="DeveloperTextBlock.HorizontalAlignment" Value="Left" />
                        <Setter Target="ModifiedDatePanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="SettingsSearchBox.(Grid.Row)" Value="1" />
                        <Setter Target="SettingsSearchBox.(Grid.Column)" Value="0" />
                        <Setter Target="SettingsSearchBox.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SettingsSearchBox.Width" Value="Auto" />
                        <Setter Target="SettingsSearchBox.Margin" Value="0,16,0,0" />
                        <Setter Target="ReloadButton.(Grid.Row)" Value="1" />
                        <Setter Target="ReloadButton.Margin" Value="12,16,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                <Button x:Name="BackButton" Click="OnBackClick"
                        Width="32" Height="32" MinWidth="0" MinHeight="0"
                        Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="{helpers:Loc Key=GameAnnouncement_Back}"
                        AutomationProperties.Name="{helpers:Loc Key=GameAnnouncement_Back}">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Text="{helpers:Loc Key=PluginConfigPage_Title}"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="TitleTextBlock" Text="{helpers:Loc Key=PluginConfigPage_Title}"
                               FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DescriptionTextBlock" Text="{helpers:Loc Key=PluginConfigPage_AdjustParams}"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel x:Name="PluginMetadataPanel" Grid.Column="1" Margin="24,0,20,0"
                            VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                    <TextBlock x:Name="DeveloperTextBlock" FontSize="12" FontWeight="SemiBold"
                               MaxWidth="220" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                    <StackPanel x:Name="ModifiedDatePanel" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{helpers:Loc Key=ModifiedDateLabel}" FontSize="12" Opacity="0.6" />
                        <TextBlock x:Name="ModifiedDateTextBlock" FontSize="12" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="PluginInfoButton" Grid.Column="2" Width="34" Height="34" MinWidth="0"
                        Padding="0" VerticalAlignment="Center"
                        ToolTipService.ToolTip="{helpers:Loc Key=PluginConfigPage_PluginInfo}"
                        AutomationProperties.Name="{helpers:Loc Key=PluginConfigPage_PluginInfo}">
                    <FontIcon Glyph="&#xE946;" FontSize="16" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="420">
                                <StackPanel Spacing="16" MinWidth="240" MaxWidth="360">
                                    <TextBlock Text="{helpers:Loc Key=PluginConfigPage_PluginInfo}"
                                               FontWeight="SemiBold" />
                                    <ItemsControl x:Name="InfoItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:PluginConfigInfoItem">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Key}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12"
                                                               Margin="12,0,0,0" TextWrapping="Wrap"
                                                               IsTextSelectionEnabled="True" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{helpers:Loc Key=PluginConfigPage_ConfigFile}" FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="ConfigPathTextBlock" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <Button Content="{helpers:Loc Key=OpenFolderLabel}" Click="OnOpenFolderClick"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,24" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="OptionCountTextBlock" FontWeight="SemiBold" />
                    <StackPanel x:Name="SaveStatusPanel" Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="SaveStatusIcon" Glyph="&#xE73E;" FontSize="12" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="SaveStatusTextBlock" Text="{helpers:Loc Key=PluginConfigPage_AutoSaveHint}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </StackPanel>
                <AutoSuggestBox x:Name="SettingsSearchBox" Grid.Column="1" Width="280" Margin="16,0,0,0"
                                VerticalAlignment="Center" QueryIcon="Find" TextChanged="OnSearchTextChanged"
                                PlaceholderText="{helpers:Loc Key=SettingsSearchPlaceholder}"
                                AutomationProperties.Name="{helpers:Loc Key=SettingsSearchPlaceholder}" />
                <Button x:Name="ReloadButton" Grid.Column="2" Margin="12,0,0,0"
                        Width="34" Height="34" MinWidth="0" Padding="0" VerticalAlignment="Center"
                        Click="OnReloadClick" ToolTipService.ToolTip="{helpers:Loc Key=DeviceInfo_Reload}"
                        AutomationProperties.Name="{helpers:Loc Key=DeviceInfo_Reload}">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>

            <InfoBar x:Name="ConfigMessageBar" Grid.Row="1" IsOpen="False" Severity="Error" Margin="0,0,0,16">
                <InfoBar.ActionButton>
                    <Button Content="{helpers:Loc Key=PluginStoreRetry}" Click="OnRetryClick" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                    <GridView x:Name="ConfigGridView"
                              ItemTemplateSelector="{StaticResource OptionTemplateSelector}"
                              ItemContainerStyle="{StaticResource SettingGridViewItemStyle}"
                              ItemsPanel="{StaticResource SettingItemsPanel}"
                              SelectionMode="None" IsItemClickEnabled="False" HorizontalAlignment="Stretch"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled">
                        <GridView.GroupStyle>
                            <GroupStyle HidesIfEmpty="True"
                                        HeaderContainerStyle="{StaticResource PluginSettingGroupHeaderStyle}">
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="models:PluginConfigOptionGroup">
                                        <Rectangle Height="1" Margin="0,0,0,24"
                                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                   Visibility="{x:Bind ShowSeparator, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </GridView.GroupStyle>
                    </GridView>
                </ScrollViewer>
                <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed" Spacing="12" Margin="24"
                            MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon x:Name="EmptyStateIcon" Glyph="&#xE9CE;" FontSize="32" Opacity="0.5" Margin="0,0,0,4" />
                    <TextBlock x:Name="EmptyStateTitleTextBlock" FontSize="16" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="EmptyStateHintTextBlock" FontSize="12" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="ClearSearchButton" Content="{helpers:Loc Key=PluginConfigPage_ClearSearch}"
                            Click="OnClearSearchClick" HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" Spacing="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="False" />
                    <TextBlock Text="{helpers:Loc Key=PluginStoreLoading}" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="ConfigLoadErrorOverlay" Grid.RowSpan="2" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="600" Margin="24" Spacing="12">
                <InfoBar x:Name="ConfigLoadErrorBar" IsOpen="False" Severity="Error" IsClosable="False"
                         Title="{helpers:Loc Key=PluginConfigPage_LoadFailed}"
                         AutomationProperties.LiveSetting="Assertive">
                    <InfoBar.ActionButton>
                        <Button Content="{helpers:Loc Key=PluginStoreRetry}" Click="OnRetryClick" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="ConfigLockInfoBar" IsOpen="False" Severity="Informational" IsClosable="False"
                         Title="{helpers:Loc Key=Plugin_FileLocked_Title}"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
