<Page
    x:Class="FufuLauncher.Views.GameAnnouncementListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:FufuLauncher.Helpers"
    xmlns:controls="using:FufuLauncher.Views"
    xmlns:vm="using:FufuLauncher.ViewModels"
    xmlns:model="using:FufuLauncher.Models.GameAnnouncement"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,12,16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox Grid.Column="0"
                            PlaceholderText="{helpers:Loc Key=GameAnnouncement_SearchPlaceholder}"
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox Grid.Column="1"
                      ItemsSource="{x:Bind ViewModel.Regions}"
                      SelectedItem="{x:Bind ViewModel.SelectedRegion, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      HorizontalAlignment="Stretch" />

            <Button Grid.Column="3"
                    Content="{helpers:Loc Key=GameAnnouncement_Refresh}"
                    Command="{x:Bind ViewModel.RefreshCommand}" />

            <Button Grid.Column="4"
                    Content="{helpers:Loc Key=GameAnnouncement_ClassicMode}"
                    Click="ClassicMode_Click" />
        </Grid>

        <Grid Grid.Row="1">
            <Pivot x:Name="AnnouncementPivot" ItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}">
                <Pivot.HeaderTemplate>
                    <DataTemplate x:DataType="vm:GameAnnouncementTab">
                        <TextBlock Text="{x:Bind Header}" />
                    </DataTemplate>
                </Pivot.HeaderTemplate>
                <Pivot.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameAnnouncementTab">
                        <ListView ItemsSource="{x:Bind Items}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  ScrollViewer.HorizontalScrollMode="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal"
                                                   Margin="16,12,16,16"
                                                   ItemWidth="332"
                                                   ItemHeight="204" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:GameAnnouncement">
                                    <Grid Width="320" Margin="0,0,12,12"
                                          Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                          CornerRadius="8"
                                          Translation="0,0,12"
                                          Tapped="AnnouncementCard_Tapped"
                                          PointerEntered="AnnouncementCard_PointerEntered"
                                          PointerExited="AnnouncementCard_PointerExited">
                                        <Grid.Shadow>
                                            <ThemeShadow />
                                        </Grid.Shadow>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="116" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Height="116">
                                            <controls:GameAnnouncementBanner x:Name="BannerImage"
                                                                             BannerUrl="{x:Bind Banner}" />

                                            <Border Margin="0,0,8,8" Padding="8,2" CornerRadius="4"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Background="{ThemeResource AcrylicInAppFillColorBaseBrush}"
                                                    IsHitTestVisible="False"
                                                    Visibility="{x:Bind ShouldShowTimeDescription, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind TimeDescription, Mode=OneTime}"
                                                           FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Margin="12,10,12,10" Spacing="2">
                                            <TextBlock Text="{x:Bind Subtitle}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       FontFamily="{StaticResource AppGlobalFont}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Title}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontFamily="{StaticResource AppGlobalFont}"
                                                       Opacity="0.6"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DataTemplate>
                </Pivot.ItemTemplate>
            </Pivot>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock Text="{helpers:Loc Key=GameAnnouncement_Loading}" Opacity="0.7"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                        Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon FontFamily="{StaticResource FluentIconsFont}" Glyph="&#xF3F1;" FontSize="40" Opacity="0.6" HorizontalAlignment="Center" />
                <TextBlock Text="{helpers:Loc Key=GameAnnouncement_LoadFailed}" Opacity="0.7"
                           HorizontalAlignment="Center" />
                <Button Content="{helpers:Loc Key=GameAnnouncement_Retry}"
                        Command="{x:Bind ViewModel.RetryCommand}"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{helpers:Loc Key=GameAnnouncement_Empty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Opacity="0.7"
                       Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </Grid>
</Page>