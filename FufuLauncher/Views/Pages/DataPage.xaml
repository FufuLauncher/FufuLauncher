<Page
    x:Class="FufuLauncher.Views.DataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FufuLauncher.ViewModels"
    xmlns:views="using:FufuLauncher.Views"
    xmlns:cc="using:FufuLauncher.Views.Controls.CycleChallenge"
    xmlns:helpers="using:FufuLauncher.Helpers"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="SafeGlassBrush" FallbackColor="#E5FFFFFF" TintColor="#FFFFFF"
                                  TintOpacity="0.6" />
                    <SolidColorBrush x:Key="SafeCardBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="SafeBorderBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="SafeHoverBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="SafeTextBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="SafeSecondaryTextBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="SafeTrackBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="SkeletonFillBrush" Color="#16000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <AcrylicBrush x:Key="SafeGlassBrush" FallbackColor="#CC000000" TintColor="#000000"
                                  TintOpacity="0.15" />
                    <SolidColorBrush x:Key="SafeCardBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="SafeBorderBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="SafeHoverBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="SafeTextBrush" Color="White" />
                    <SolidColorBrush x:Key="SafeSecondaryTextBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="SafeTrackBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="SkeletonFillBrush" Color="#26FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush x:Key="SafeGlassBrush" FallbackColor="#CC000000" TintColor="#000000"
                                  TintOpacity="0.15" />
                    <SolidColorBrush x:Key="SafeCardBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="SafeBorderBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="SafeHoverBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="SafeTextBrush" Color="White" />
                    <SolidColorBrush x:Key="SafeSecondaryTextBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="SafeTrackBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="SkeletonFillBrush" Color="#26FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <views:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <views:DataCenterBrushConverter x:Key="TagBrush" />
            <helpers:InverseBoolConverter x:Key="InverseBool" />

            <Storyboard x:Name="EntranceStoryboard">
                <DoubleAnimation Storyboard.TargetName="RootLayoutGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.6">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="RootLayoutTranslate"
                                 Storyboard.TargetProperty="Y"
                                 From="18" To="0" Duration="0:0:0.6">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Name="SkeletonPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="InitialSkeletonContent"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.92" To="0.56" Duration="0:0:0.95">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Name="DataContentEntranceStoryboard">
                <DoubleAnimation Storyboard.TargetName="DataContentHost"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.36">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="DataContentTranslate"
                                 Storyboard.TargetProperty="Y"
                                 From="12" To="0" Duration="0:0:0.36">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Name="ExitStoryboard">
                <DoubleAnimation Storyboard.TargetName="RootLayoutGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Name="RefreshSpinStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="RefreshIconRotate"
                                 Storyboard.TargetProperty="Angle"
                                 From="0" To="360" Duration="0:0:1" />
            </Storyboard>

            <Style x:Key="SettingsCardStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource SafeGlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="24" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource SafeSecondaryTextBrush}" />
                <Setter Property="Margin" Value="4,0,0,8" />
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>

            <Style x:Key="SectionCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource SafeSecondaryTextBrush}" />
                <Setter Property="Opacity" Value="0.8" />
                <Setter Property="Margin" Value="0,0,4,8" />
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>

            <Style x:Key="DcLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="{ThemeResource SafeSecondaryTextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>

            <Style x:Key="DcValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource SafeTextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>

            <Style x:Key="DcSubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SafeCardBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource SafeTextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="36" />
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            </Style>

            <Style x:Key="DcIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DcSubtleButtonStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="MinWidth" Value="36" />
            </Style>

            <Style x:Key="SkeletonBarStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SkeletonFillBrush}" />
                <Setter Property="CornerRadius" Value="5" />
            </Style>

            <Style x:Key="SkeletonCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SafeGlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="DcChipStyle" TargetType="primitives:ToggleButton">
                <Setter Property="Foreground" Value="{ThemeResource SafeTextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="primitives:ToggleButton">
                            <Grid x:Name="ChipRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="ChipScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>

                                <Border x:Name="ChipRest" CornerRadius="16"
                                        Background="{ThemeResource SafeCardBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" />
                                <Border x:Name="ChipHover" CornerRadius="16"
                                        Background="{ThemeResource SafeHoverBrush}" Opacity="0" />
                                <Border x:Name="ChipAccent" CornerRadius="16"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0" />

                                <ContentPresenter x:Name="ChipContent"
                                                  Padding="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  AutomationProperties.AccessibilityView="Raw" />

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ChipHover"
                                                                 Storyboard.TargetProperty="Opacity" To="0"
                                                                 Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="ChipAccent"
                                                                 Storyboard.TargetProperty="Opacity" To="0"
                                                                 Duration="0:0:0.25" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ChipHover"
                                                                 Storyboard.TargetProperty="Opacity" To="1"
                                                                 Duration="0:0:0.2" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ChipScale"
                                                                 Storyboard.TargetProperty="ScaleX" To="0.95"
                                                                 Duration="0:0:0.1" />
                                                <DoubleAnimation Storyboard.TargetName="ChipScale"
                                                                 Storyboard.TargetProperty="ScaleY" To="0.95"
                                                                 Duration="0:0:0.1" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ChipRoot"
                                                                 Storyboard.TargetProperty="Opacity" To="0.4"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ChipAccent"
                                                                 Storyboard.TargetProperty="Opacity" To="1"
                                                                 Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipContent"
                                                                               Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ChipAccent"
                                                                 Storyboard.TargetProperty="Opacity" To="0.85"
                                                                 Duration="0:0:0.2" />
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipContent"
                                                                               Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ChipAccent"
                                                                 Storyboard.TargetProperty="Opacity" To="0.7"
                                                                 Duration="0:0:0.1" />
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipContent"
                                                                               Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ChipRoot"
                                                                 Storyboard.TargetProperty="Opacity" To="0.4"
                                                                 Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="ChipAccent"
                                                                 Storyboard.TargetProperty="Opacity" To="1"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DcGridItemStyle" TargetType="GridViewItem"
                   BasedOn="{StaticResource DefaultGridViewItemStyle}">
                <Setter Property="Margin" Value="6" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="DcMiniBarStyle" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{ThemeResource ProgressBarForeground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ProgressBarBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource ProgressBarBorderThemeThickness}" />
                <Setter Property="Height" Value="4" />
                <Setter Property="MinHeight" Value="4" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="Background" Value="{ThemeResource SafeTrackBrush}" />
            </Style>

            <DataTemplate x:Key="KpiTileTemplate" x:DataType="vm:DcKpiTile">
                <Border Height="92" Padding="14,12"
                        CornerRadius="10"
                        Background="{ThemeResource SafeCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="12"
                                      FontFamily="{StaticResource SegoeFluentIconsFont}"
                                      Foreground="{x:Bind ColorTag, Converter={StaticResource TagBrush}}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource DcLabelStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="{x:Bind Value}" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppGlobalFont}"
                                   Foreground="{x:Bind ColorTag, Converter={StaticResource TagBrush}}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="2" Text="{x:Bind Caption}" Style="{StaticResource DcLabelStyle}"
                                   Visibility="{x:Bind HasCaption, Converter={StaticResource BoolToVis}}"
                                   MaxLines="1" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="RateRowTemplate" x:DataType="vm:DcRateRow">
                <Grid ColumnSpacing="8" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="24" Height="24" CornerRadius="6"
                            Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{x:Bind Icon}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{x:Bind Name}" FontSize="12"
                                   Foreground="{ThemeResource SafeTextBrush}"
                                   FontFamily="{StaticResource AppGlobalFont}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <ProgressBar Style="{StaticResource DcMiniBarStyle}" Value="{x:Bind Rate}"
                                     Foreground="{x:Bind ColorTag, Converter={StaticResource TagBrush}}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{x:Bind RateText}" FontSize="12" FontWeight="SemiBold"
                               MinWidth="46" TextAlignment="Right" VerticalAlignment="Center"
                               FontFamily="{StaticResource AppGlobalFont}"
                               Foreground="{ThemeResource SafeSecondaryTextBrush}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="BarTemplate" x:DataType="vm:DcBar">
                <Grid ColumnSpacing="8" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource DcLabelStyle}"
                               VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Style="{StaticResource DcMiniBarStyle}" Value="{x:Bind Value}"
                                 VerticalAlignment="Center"
                                 Foreground="{x:Bind ColorTag, Converter={StaticResource TagBrush}}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind ValueText}" FontSize="11" MinWidth="44"
                               TextAlignment="Right" VerticalAlignment="Center"
                               FontFamily="{StaticResource AppGlobalFont}"
                               Foreground="{ThemeResource SafeSecondaryTextBrush}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="InsightTemplate" x:DataType="vm:DcInsight">
                <Grid ColumnSpacing="12" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Rectangle Width="3" RadiusX="2" RadiusY="2" VerticalAlignment="Stretch"
                               Fill="{x:Bind ColorTag, Converter={StaticResource TagBrush}}" />

                    <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="14"
                              FontFamily="{StaticResource SegoeFluentIconsFont}"
                              VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{x:Bind ColorTag, Converter={StaticResource TagBrush}}" />

                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                   FontFamily="{StaticResource AppGlobalFont}"
                                   Foreground="{ThemeResource SafeTextBrush}" />
                        <TextBlock Text="{x:Bind Body}" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                                   FontFamily="{StaticResource AppGlobalFont}"
                                   Foreground="{ThemeResource SafeSecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="MoverRowTemplate" x:DataType="vm:DcMoverRow">
                <Grid ColumnSpacing="10" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <cc:AvatarCard CardWidth="46"
                                   IconUrl="{x:Bind Avatar}"
                                   Rarity="{x:Bind Star}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource DcValueStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind PreviousText}" Style="{StaticResource DcLabelStyle}" />
                            <FontIcon Glyph="&#xE72A;" FontSize="9"
                                      FontFamily="{StaticResource SegoeFluentIconsFont}"
                                      Foreground="{ThemeResource SafeSecondaryTextBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind CurrentText}" Style="{StaticResource DcLabelStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind ChangeGlyph}" FontSize="11"
                                  FontFamily="{StaticResource SegoeFluentIconsFont}"
                                  Foreground="{x:Bind ChangeTag, Converter={StaticResource TagBrush}}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ChangeText}" FontSize="13" FontWeight="SemiBold"
                                   FontFamily="{StaticResource AppGlobalFont}"
                                   Foreground="{x:Bind ChangeTag, Converter={StaticResource TagBrush}}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CountRowTemplate" x:DataType="vm:DcCountRow">
                <Grid ColumnSpacing="10" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{x:Bind PositionText}" Style="{StaticResource DcLabelStyle}"
                               VerticalAlignment="Center" TextAlignment="Center" />

                    <cc:AvatarCard Grid.Column="1"
                                   Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVis}}"
                                   CardWidth="46"
                                   IconUrl="{x:Bind Icon}"
                                   Rarity="{x:Bind Star}" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource DcValueStyle}" />
                        <ProgressBar Style="{StaticResource DcMiniBarStyle}" Value="{x:Bind Ratio}"
                                     Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="72">
                        <TextBlock Text="{x:Bind CountText}" FontSize="13" FontWeight="SemiBold"
                                   TextAlignment="Right"
                                   FontFamily="{StaticResource AppGlobalFont}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind DetailText}" Style="{StaticResource DcLabelStyle}"
                                   TextAlignment="Right" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="RankRowTemplate" x:DataType="vm:DcRankRow">
                <Grid ColumnSpacing="10" Margin="0,0,0,10" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{x:Bind PositionText}" Style="{StaticResource DcLabelStyle}"
                               VerticalAlignment="Center" TextAlignment="Center" />

                    <cc:AvatarCard Grid.Column="1"
                                   CardWidth="46"
                                   IconUrl="{x:Bind Avatar}"
                                   Rarity="{x:Bind Star}" />

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,3">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource DcValueStyle}" />
                            <Border CornerRadius="4" Padding="5,0" VerticalAlignment="Center"
                                    Background="{x:Bind TierTag, Converter={StaticResource TagBrush}}">
                                <TextBlock Text="{x:Bind TierText}" FontSize="9" FontWeight="Bold"
                                           Foreground="White"
                                           FontFamily="{StaticResource AppGlobalFont}" />
                            </Border>
                        </StackPanel>
                        <ProgressBar Grid.Row="1" Style="{StaticResource DcMiniBarStyle}" Value="{x:Bind UseRate}"
                                     Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Grid>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="{helpers:Loc Key=DataPage_UsageRate}" Style="{StaticResource DcLabelStyle}" />
                        <TextBlock Text="{x:Bind UseRateText}" Style="{StaticResource DcValueStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="{helpers:Loc Key=DataPage_OwnRate}" Style="{StaticResource DcLabelStyle}" />
                        <TextBlock Text="{x:Bind OwnRateText}" Style="{StaticResource DcValueStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                        <TextBlock Text="{helpers:Loc Key=DataPage_AvgConstellation}"
                                   Style="{StaticResource DcLabelStyle}" />
