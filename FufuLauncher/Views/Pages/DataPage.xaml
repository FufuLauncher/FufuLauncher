                                        </Grid.ColumnDefinitions>

                                        <AutoSuggestBox x:Name="CharacterSearchBox" Grid.Column="0"
                                                        MaxWidth="360" HorizontalAlignment="Left" MinWidth="200"
                                                        QueryIcon="Find" CornerRadius="8" Height="36"
                                                        VerticalAlignment="Bottom"
                                                        PlaceholderText="{helpers:Loc Key=DataPage_SearchRole}"
                                                        TextChanged="OnCharacterSearchTextChanged" />

                                        <ComboBox Grid.Column="1" MinWidth="120" VerticalAlignment="Bottom"
                                                  Header="{helpers:Loc Key=DataPage_StarFilter}"
                                                  ItemsSource="{x:Bind ViewModel.StarFilterOptions}"
                                                  DisplayMemberPath="Title" SelectedIndex="0"
                                                  SelectionChanged="OnCharacterStarFilterChanged" />

                                        <ComboBox Grid.Column="2" MinWidth="140" VerticalAlignment="Bottom"
                                                  Header="{helpers:Loc Key=DataPage_SortBy}"
                                                  ItemsSource="{x:Bind ViewModel.CharacterSortOptions}"
                                                  DisplayMemberPath="Title" SelectedIndex="0"
                                                  SelectionChanged="OnCharacterSortChanged" />
                                    </Grid>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="{helpers:Loc Key=DataPage_SectionCharacters}"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.CharacterCountText, Mode=OneWay}"
                                               Style="{StaticResource SectionCaptionStyle}"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <GridView x:Name="CharacterGridView"
                                          ItemsSource="{x:Bind ViewModel.Characters, Mode=OneWay}"
                                          ItemTemplate="{StaticResource CharacterCardTemplate}"
                                          ItemContainerStyle="{StaticResource DcGridItemStyle}"
                                          SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="OnCharacterItemClick"
                                          Padding="0" Margin="-6,0,-6,0"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollMode="Disabled">
                                    <GridView.ItemContainerTransitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" />
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </GridView.ItemContainerTransitions>
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Left" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                </GridView>

                                <Button Style="{StaticResource DcSubtleButtonStyle}" HorizontalAlignment="Center"
                                        Content="{x:Bind ViewModel.CharacterMoreText, Mode=OneWay}"
                                        Click="OnShowMoreCharactersClick"
                                        Visibility="{x:Bind ViewModel.HasMoreCharacters, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                                <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,32,0,0"
                                            Visibility="{x:Bind ViewModel.HasNoCharacters, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                                            Background="{ThemeResource SafeCardBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <FontIcon Glyph="&#xE721;" FontSize="26"
                                                  FontFamily="{StaticResource SegoeFluentIconsFont}"
                                                  Foreground="{ThemeResource SafeSecondaryTextBrush}" />
                                    </Border>
                                    <TextBlock Text="{helpers:Loc Key=DataPage_NoResult}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               HorizontalAlignment="Center"
                                               FontFamily="{StaticResource AppGlobalFont}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                        HorizontalAlignment="Stretch"
                                        Content="{x:Bind ViewModel.Spiral}"
                                        ContentTemplate="{StaticResource AbyssSectionTemplate}"
                                        Visibility="{x:Bind ViewModel.IsSpiralAbyss, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                        HorizontalAlignment="Stretch"
                                        Content="{x:Bind ViewModel.Stygian}"
                                        ContentTemplate="{StaticResource AbyssSectionTemplate}"
                                        Visibility="{x:Bind ViewModel.IsStygian, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Spacing="24"
                                    Visibility="{x:Bind ViewModel.IsWish, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="24" />
                                </TransitionCollection>
                            </StackPanel.Transitions>

                            <StackPanel>
                                <TextBlock Text="{helpers:Loc Key=DataPage_SectionFilter}"
                                           Style="{StaticResource SectionHeaderStyle}" />
                                <Grid Style="{StaticResource SettingsCardStyle}" Padding="16" Translation="0,0,32">
                                    <Grid.Shadow>
                                        <ThemeShadow />
                                    </Grid.Shadow>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <primitives:ToggleButton Style="{StaticResource DcChipStyle}"
                                                                     Content="{helpers:Loc Key=DataPage_WishCharacters}"
                                                                     IsChecked="{x:Bind ViewModel.WishShowCharacters, Mode=OneWay}"
                                                                     Click="OnWishCategoryClick" Tag="0" />
                                            <primitives:ToggleButton Style="{StaticResource DcChipStyle}"
                                                                     Content="{helpers:Loc Key=DataPage_WishWeapons}"
                                                                     IsChecked="{x:Bind ViewModel.WishShowWeapons, Mode=OneWay}"
                                                                     Click="OnWishCategoryClick" Tag="1" />
                                        </StackPanel>

                                        <AutoSuggestBox Grid.Column="1" MaxWidth="360" HorizontalAlignment="Right"
                                                        MinWidth="200" QueryIcon="Find" CornerRadius="8" Height="36"
                                                        VerticalAlignment="Center"
                                                        PlaceholderText="{helpers:Loc Key=DataPage_WishSearchPlaceholder}"
                                                        TextChanged="OnWishSearchTextChanged" />
                                    </Grid>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="{helpers:Loc Key=DataPage_SectionBanners}"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.WishCountText, Mode=OneWay}"
                                               Style="{StaticResource SectionCaptionStyle}"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <GridView ItemsSource="{x:Bind ViewModel.WishBanners, Mode=OneWay}"
                                          ItemTemplate="{StaticResource WishBannerTemplate}"
                                          ItemContainerStyle="{StaticResource DcGridItemStyle}"
                                          SelectionMode="None" IsItemClickEnabled="False"
                                          Padding="0" Margin="-6,0,-6,0"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollMode="Disabled">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Left" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                </GridView>

                                <Button Style="{StaticResource DcSubtleButtonStyle}" HorizontalAlignment="Center"
                                        Content="{x:Bind ViewModel.WishMoreText, Mode=OneWay}"
                                        Click="OnShowMoreWishClick"
                                        Visibility="{x:Bind ViewModel.WishHasMore, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="{helpers:Loc Key=DataPage_NoResult}"
                                           Style="{StaticResource SectionCaptionStyle}"
                                           HorizontalAlignment="Center" Margin="0,32,0,0"
                                           Visibility="{x:Bind ViewModel.WishHasNone, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{helpers:Loc Key=DataPage_WishTopRerun}"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <Grid Style="{StaticResource SettingsCardStyle}" Translation="0,0,32">
                                        <Grid.Shadow>
                                            <ThemeShadow />
                                        </Grid.Shadow>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.WishTopReruns, Mode=OneWay}"
                                                      ItemTemplate="{StaticResource CountRowTemplate}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{helpers:Loc Key=DataPage_WishTopCompanion}"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <Grid Style="{StaticResource SettingsCardStyle}" Translation="0,0,32">
                                        <Grid.Shadow>
                                            <ThemeShadow />
                                        </Grid.Shadow>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.WishTopCompanions, Mode=OneWay}"
                                                      ItemTemplate="{StaticResource CountRowTemplate}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="24"
                                    Visibility="{x:Bind ViewModel.IsRerun, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="24" />
                                </TransitionCollection>
                            </StackPanel.Transitions>

                            <StackPanel>
                                <TextBlock Text="{helpers:Loc Key=DataPage_SectionFilter}"
                                           Style="{StaticResource SectionHeaderStyle}" />
                                <Grid Style="{StaticResource SettingsCardStyle}" Padding="16" Translation="0,0,32">
                                    <Grid.Shadow>
                                        <ThemeShadow />
                                    </Grid.Shadow>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <AutoSuggestBox Grid.Column="0" MaxWidth="360" HorizontalAlignment="Left"
                                                        MinWidth="200" QueryIcon="Find" CornerRadius="8" Height="36"
                                                        VerticalAlignment="Bottom"
                                                        PlaceholderText="{helpers:Loc Key=DataPage_RerunSearchPlaceholder}"
                                                        TextChanged="OnRerunSearchTextChanged" />

                                        <ComboBox Grid.Column="1" MinWidth="130" VerticalAlignment="Bottom"
                                                  Header="{helpers:Loc Key=DataPage_RerunCategory}"
                                                  ItemsSource="{x:Bind ViewModel.RerunGroupOptions}"
                                                  DisplayMemberPath="Title" SelectedIndex="0"
                                                  SelectionChanged="OnRerunGroupChanged" />

                                        <ComboBox Grid.Column="2" MinWidth="130" VerticalAlignment="Bottom"
                                                  Header="{helpers:Loc Key=DataPage_SortBy}"
                                                  ItemsSource="{x:Bind ViewModel.RerunSortOptions}"
                                                  DisplayMemberPath="Title" SelectedIndex="0"
                                                  SelectionChanged="OnRerunSortChanged" />
                                    </Grid>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="{helpers:Loc Key=DataPage_SectionRerun}"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.RerunCountText, Mode=OneWay}"
                                               Style="{StaticResource SectionCaptionStyle}"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <GridView ItemsSource="{x:Bind ViewModel.RerunCards, Mode=OneWay}"
                                          ItemTemplate="{StaticResource RerunCardTemplate}"
                                          ItemContainerStyle="{StaticResource DcGridItemStyle}"
                                          SelectionMode="None" IsItemClickEnabled="False"
                                          Padding="0" Margin="-6,0,-6,0"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollMode="Disabled">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Left" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                </GridView>

                                <TextBlock Text="{helpers:Loc Key=DataPage_NoResult}"
                                           Style="{StaticResource SectionCaptionStyle}"
                                           HorizontalAlignment="Center" Margin="0,32,0,0"
                                           Visibility="{x:Bind ViewModel.RerunHasNone, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Margin="36,24,36,24"
                  Visibility="{x:Bind ViewModel.IsTimeline, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Border CornerRadius="14" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource SafeGlassBrush}">
                    <Grid CornerRadius="14">
                        <WebView2 x:Name="TimelineWebView" Opacity="0" />

                        <StackPanel x:Name="TimelineLoadingTip" Spacing="10"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <ProgressRing IsActive="True" Width="44" Height="44" />
                            <TextBlock Text="{helpers:Loc Key=DataPage_LoadingTimeline}"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       FontFamily="{StaticResource AppGlobalFont}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="InitialSkeletonHost"
                  IsHitTestVisible="False"
                  IsTabStop="False"
                  Visibility="{x:Bind ViewModel.ShowInitialSkeleton, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="InitialSkeletonContent" Margin="36,24,36,48" MaxWidth="1060"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="24">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ProgressRing IsActive="True" Width="18" Height="18" />
                                <TextBlock Text="{helpers:Loc Key=DataPage_Loading}"
                                           FontSize="13" FontWeight="SemiBold"
                                           FontFamily="{StaticResource AppGlobalFont}"
                                           Foreground="{ThemeResource SafeTextBrush}" />
                            </StackPanel>
                            <Border Style="{StaticResource SkeletonBarStyle}" Width="260" Height="10" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <Border Style="{StaticResource SkeletonBarStyle}" Width="108" Height="12" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SkeletonCardStyle}" Height="116">
                                    <StackPanel Spacing="14">
                                        <Border Style="{StaticResource SkeletonBarStyle}" Width="68" Height="10" />
                                        <Border Style="{StaticResource SkeletonBarStyle}" Width="106" Height="28" />
                                        <Border Style="{StaticResource SkeletonBarStyle}" Width="86" Height="8" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource SkeletonCardStyle}" Height="116">
                                    <StackPanel Spacing="14">
                                        <Border Style="{StaticResource SkeletonBarStyle}" Width="76" Height="10" />
                                        <Border Style="{StaticResource SkeletonBarStyle}" Width="94" Height="28" />
                                        <Border Style="{StaticResource SkeletonBarStyle}" Width="112" Height="8" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SkeletonCardStyle}" Height="116">
                                    <StackPanel Spacing="14">
                                        <Border Style="{StaticResource SkeletonBarStyle}" Width="60" Height="10" />
                                        <Border Style="{StaticResource SkeletonBarStyle}" Width="116" Height="28" />
                                        <Border Style="{StaticResource SkeletonBarStyle}" Width="72" Height="8" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource SkeletonCardStyle}" Height="116">
                                    <StackPanel Spacing="14">
                                        <Border Style="{StaticResource SkeletonBarStyle}" Width="80" Height="10" />
                                        <Border Style="{StaticResource SkeletonBarStyle}" Width="98" Height="28" />
                                        <Border Style="{StaticResource SkeletonBarStyle}" Width="96" Height="8" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="10">
                                <Border Style="{StaticResource SkeletonBarStyle}" Width="120" Height="12" />
                                <Border Style="{StaticResource SkeletonCardStyle}" Height="230">
                                    <Grid>
                                        <StackPanel Spacing="16" VerticalAlignment="Top">
                                            <Border Style="{StaticResource SkeletonBarStyle}" Width="180" Height="13" />
                                            <Border Style="{StaticResource SkeletonBarStyle}" Width="260" Height="9" />
                                            <Border Style="{StaticResource SkeletonBarStyle}" Width="220" Height="9" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                                            <Border Style="{StaticResource SkeletonBarStyle}" Width="54" Height="72" />
                                            <Border Style="{StaticResource SkeletonBarStyle}" Width="54" Height="110" />
                                            <Border Style="{StaticResource SkeletonBarStyle}" Width="54" Height="88" />
                                            <Border Style="{StaticResource SkeletonBarStyle}" Width="54" Height="142" />
                                            <Border Style="{StaticResource SkeletonBarStyle}" Width="54" Height="98" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="10">
                                <Border Style="{StaticResource SkeletonBarStyle}" Width="104" Height="12" />
                                <Border Style="{StaticResource SkeletonCardStyle}" Height="230">
                                    <StackPanel Spacing="18">
                                        <Border Style="{StaticResource SkeletonBarStyle}" Height="12" />
                                        <Border Style="{StaticResource SkeletonBarStyle}" Height="12" Width="250" />
                                        <Border Style="{StaticResource SkeletonBarStyle}" Height="12" Width="208" />
                                        <Border Style="{StaticResource SkeletonBarStyle}" Height="12" Width="232" />
                                        <Border Style="{StaticResource SkeletonBarStyle}" Height="12" Width="182" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <StackPanel Spacing="12" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Border Width="76" Height="76" CornerRadius="38" HorizontalAlignment="Center"
                        Background="{ThemeResource SafeCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <FontIcon Glyph="&#xF3F1;" FontSize="35"
                              FontFamily="{StaticResource FluentIconsFont}"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </Border>
                <TextBlock Text="{helpers:Loc Key=DataPage_LoadFailedTitle}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppGlobalFont}" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppGlobalFont}"
                           Foreground="{ThemeResource SafeSecondaryTextBrush}" />
                <Button Content="{helpers:Loc Key=DataPage_Retry}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,4,0,0"
                        Click="OnRefreshClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>