<Page
    x:Class="FufuLauncher.Views.AgreementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:FufuLauncher.Helpers"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="OnPageLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              HorizontalAlignment="Center"
              Padding="24,16"
              MaxWidth="650"
              Visibility="{x:Bind ViewModel.AgreementVisibility, Mode=OneWay}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Image Grid.Row="0"
                   x:Name="IconImage"
                   Source="ms-appx:///Assets/icon.png"
                   Width="52"
                   Height="52"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"
                   Opacity="0">
            </Image>

            <TextBlock Grid.Row="1"
                       x:Name="TitleText"
                       Text="{helpers:Loc Key=AgreementPage_Title}"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"
                       Opacity="0">
            </TextBlock>

            <TextBlock Grid.Row="2"
                       x:Name="DescText"
                       Text="{helpers:Loc Key=AgreementPage_Welcome}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,8"
                       Opacity="0">
            </TextBlock>

            <Grid Grid.Row="3" x:Name="AgreementArea" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <ScrollViewer x:Name="AgreementScrollViewer" Padding="16,12" VerticalScrollBarVisibility="Auto"
                                      ViewChanged="OnAgreementScrollChanged">
                            <TextBlock Text="{x:Bind ViewModel.AgreementText, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       FontSize="12.5"
                                       LineHeight="20"
                                       IsTextSelectionEnabled="True" />
                        </ScrollViewer>

                        <ProgressRing Width="32"
                                      Height="32"
                                      IsActive="{x:Bind ViewModel.IsAgreementLoading, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />

                        <StackPanel Spacing="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.AgreementErrorVisibility, Mode=OneWay}">

                            <FontIcon FontFamily="{StaticResource SegoeFluentIconsFont}"
                                      Glyph="&#xE783;"
                                      FontSize="28"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <TextBlock Text="{helpers:Loc Key=AgreementPage_LoadFailed}"
                                       FontSize="12.5"
                                       MaxWidth="360"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Button Content="{helpers:Loc Key=AgreementPage_Retry}"
                                    Click="OnReloadAgreementClick"
                                    HorizontalAlignment="Center"
                                    Padding="16,6"
                                    CornerRadius="4" />
                        </StackPanel>
                    </Grid>
                </Border>

                <CheckBox Grid.Row="1"
                          IsChecked="{x:Bind ViewModel.IsAgreementChecked, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.CanAcceptAgreement, Mode=OneWay}"
                          Margin="0,8,0,0"
                          Content="{helpers:Loc Key=AgreementPage_AgreeCheck}" />

                <TextBlock Grid.Row="2"
                           Text="{helpers:Loc Key=AgreementPage_ScrollHint}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="{x:Bind ViewModel.HintVisibility, Mode=OneWay}"
                           Margin="28,2,0,0" />

                <TextBlock Grid.Row="2"
                           Text="{helpers:Loc Key=AgreementPage_SkipHint}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.SkipHintVisibility, Mode=OneWay}"
                           Margin="28,2,0,0" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="0"
                    x:Name="IconCheckSection"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="32"
                    Padding="48"
                    Visibility="{x:Bind ViewModel.IconCheckVisibility, Mode=OneWay}">

            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Image Source="ms-appx:///Assets/icon.png"
                       Width="52" Height="52"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4" />
                <TextBlock Text="{helpers:Loc Key=AgreementPage_IconCheckHint}"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32,24">
                <StackPanel Orientation="Horizontal" Spacing="48" HorizontalAlignment="Center">
                    <StackPanel Spacing="12">
                        <FontIcon Glyph="&#xE713;"
                                  FontSize="40"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="{helpers:Loc Key=AgreementPage_Settings}" FontSize="12"
                                   HorizontalAlignment="Center" Opacity="0.7" />
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <FontIcon Glyph="&#xE80F;"
                                  FontSize="40"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="{helpers:Loc Key=AgreementPage_Home}" FontSize="12"
                                   HorizontalAlignment="Center" Opacity="0.7" />
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <FontIcon Glyph="&#xE8B7;"
                                  FontSize="40"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="{helpers:Loc Key=AgreementPage_Files}" FontSize="12"
                                   HorizontalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                <Button Content="{helpers:Loc Key=AgreementPage_CannotDisplay}"
                        Command="{x:Bind ViewModel.TroubleshootIconsCommand}"
                        Style="{StaticResource DefaultButtonStyle}"
                        MinWidth="120" />

                <Button Content="{helpers:Loc Key=AgreementPage_DisplayNormal}"
                        Click="OnIconCheckConfirmClick"
                        Style="{StaticResource DefaultButtonStyle}"
                        MinWidth="120" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="0"
                    x:Name="DataDirSection"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="16"
                    Padding="32,24"
                    MaxWidth="560"
                    Visibility="{x:Bind ViewModel.DataDirVisibility, Mode=OneWay}">

            <Image Source="ms-appx:///Assets/icon.png"
                   Width="52" Height="52"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,0" />

            <TextBlock Text="{helpers:Loc Key=AgreementPage_DataStorage}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <TextBlock Text="{helpers:Loc Key=AgreementPage_DataDirDesc}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />

            <StackPanel Spacing="12">
                <TextBlock Text="{helpers:Loc Key=AgreementPage_UserDataDir}" FontSize="13" FontWeight="SemiBold" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.DataPath, Mode=OneWay}" IsReadOnly="True"
                             FontSize="12" />
                    <Button Grid.Column="1" Content="{helpers:Loc Key=AgreementPage_Change}"
                            Command="{x:Bind ViewModel.BrowseDataPathCommand}"
                            VerticalAlignment="Bottom" Padding="12,6" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="{helpers:Loc Key=AgreementPage_CacheDir}" FontSize="13" FontWeight="SemiBold" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.CachePath, Mode=OneWay}" IsReadOnly="True"
                             FontSize="12" />
                    <Button Grid.Column="1" Content="{helpers:Loc Key=AgreementPage_Change}"
                            Command="{x:Bind ViewModel.BrowseCachePathCommand}"
                            VerticalAlignment="Bottom" Padding="12,6" />
                </Grid>
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10">
                <StackPanel Spacing="2">
                    <CheckBox Content="{helpers:Loc Key=Settings_Telemetry_Title}"
                              IsChecked="{x:Bind ViewModel.IsTelemetryEnabled, Mode=TwoWay}" />
                    <TextBlock Text="{helpers:Loc Key=Settings_Telemetry_Caption}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"
                               Margin="28,0,0,0" />
                </StackPanel>
            </Border>

            <Button Content="{helpers:Loc Key=AgreementPage_Next}"
                    Click="OnDataDirNextClick"
                    HorizontalAlignment="Center"
                    Padding="24,8"
                    CornerRadius="4" />

            <TextBlock Text="{x:Bind ViewModel.PathError, Mode=OneWay}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Visibility="{x:Bind ViewModel.PathErrorVisibility, Mode=OneWay}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="0"
                    x:Name="TrustSection"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="20"
                    Padding="48"
                    MaxWidth="560"
                    Visibility="{x:Bind ViewModel.TrustVisibility, Mode=OneWay}">

            <FontIcon FontFamily="{StaticResource FluentIconsFont}" Glyph="&#xF27E;"
                      FontSize="50"
                      HorizontalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

            <TextBlock Text="安装平台证书(可选)"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <TextBlock Text="安装后本启动器与系统可以识别我们为可信开发者签发的代码签名，提高你的使用便捷性，使我们的插件不再频繁被Windows Defender拦截。"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12">
                <Button Content="安装证书"
                        Click="OnTrustInstallClick"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Padding="24,8"
                        CornerRadius="4" />

                <Button Content="暂不安装"
                        Click="OnTrustSkipClick"
                        Style="{StaticResource DefaultButtonStyle}"
                        HorizontalAlignment="Center"
                        Padding="24,8"
                        CornerRadius="4" />
            </StackPanel>

            <TextBlock x:Name="TrustStatusText"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="0"
              x:Name="CompleteSection"
              Padding="48"
              MaxWidth="600"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="{x:Bind ViewModel.CompleteVisibility, Mode=OneWay}">

            <StackPanel x:Name="CompleteBadgeArea"
                        Spacing="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <FontIcon FontFamily="{StaticResource FluentIconsFont}" Glyph="&#xE930;"
                          FontSize="64"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <TextBlock x:Name="CompleteBadgeText"
                           Text="配置完成"
                           FontSize="28"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="WelcomePanel"
                        Spacing="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">

                <Image Source="ms-appx:///Assets/icon.png"
                       Width="52"
                       Height="52"
                       HorizontalAlignment="Center" />

                <TextBlock x:Name="WelcomeTitle"
                           Text="欢迎使用芙芙启动器"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <TextBlock x:Name="WelcomeDesc"
                           Text="重启后即可使用"
                           FontSize="12.5"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />

                <Button x:Name="RestartButton"
                        Content="重启并进入主界面"
                        Click="OnRestartClick"
                        Style="{StaticResource AccentButtonStyle}"
                        FontSize="16"
                        MinWidth="280"
                        MinHeight="56"
                        Padding="48,16"
                        CornerRadius="8"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center" />

                <TextBlock x:Name="RestartStatusText"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              x:Name="AgreementActionBar"
              Opacity="0"
              Padding="20,12"
              BorderThickness="1,1,0,0"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind ViewModel.AgreementVisibility, Mode=OneWay}">

            <Button Content="{helpers:Loc Key=AgreementPage_Next}"
                    Click="OnAgreementNextClick"
                    IsEnabled="{x:Bind ViewModel.IsAgreementChecked, Mode=OneWay}"
                    HorizontalAlignment="Right"
                    CornerRadius="4"
                    Padding="24,8" />
        </Grid>
    </Grid>
</Page>