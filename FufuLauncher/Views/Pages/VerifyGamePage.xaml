<Page
    x:Class="FufuLauncher.Views.VerifyGamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:FufuLauncher.Helpers"
    xmlns:controls="using:FufuLauncher.Controls"
    Background="Transparent">

    <Grid Padding="32">
        <StackPanel VerticalAlignment="Center" Spacing="16" MaxWidth="480" HorizontalAlignment="Center">
            <FontIcon FontFamily="{StaticResource FluentIconsFont}" Glyph="&#xEAC8;" FontSize="60" Opacity="0.8" />
            <TextBlock Text="{helpers:Loc Key=VerifyGame_Title}" FontSize="24" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{helpers:Loc Key=VerifyGame_Description}"
                       TextWrapping="Wrap" HorizontalAlignment="Center" Opacity="0.6" TextAlignment="Center"
                       MaxWidth="400" />
            <Button x:Name="StartVerifyBtn" Content="{helpers:Loc Key=VerifyGame_Start}" Click="StartVerifyBtn_Click"
                    HorizontalAlignment="Center" MinWidth="160" Height="40" />

            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="8">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Height="8" />
                <TextBlock x:Name="ProgressDetailText" Opacity="0.7" />
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"
                        Padding="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{helpers:Loc Key=AdvancedServerSwitch_DownloadSpeed}" FontWeight="SemiBold" />
                        <controls:SpeedGraph x:Name="SpeedGraphChart" Height="120" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="RemainingCountText" FontWeight="SemiBold" />
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"
                        Padding="8">
                    <ListView x:Name="RemainingChunksList" Height="110" SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                <Button x:Name="CancelBtn" Content="{helpers:Loc Key=AdvancedServerSwitch_Cancel}" Width="120"
                        Height="36" HorizontalAlignment="Center"
                        Click="CancelBtn_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>