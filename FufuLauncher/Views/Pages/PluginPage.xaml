<Page
    x:Class="FufuLauncher.Views.PluginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FufuLauncher.Models"
    xmlns:viewModels="using:FufuLauncher.ViewModels"
    xmlns:converters="using:FufuLauncher.Converters"
    xmlns:helpers="using:FufuLauncher.Helpers"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="SafeGlassBrush" FallbackColor="#E5FFFFFF" TintColor="#FFFFFF"
                                  TintOpacity="0.6" />
                    <SolidColorBrush x:Key="SafeCardBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="SafeBorderBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="SafeTextBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="SafeSecondaryTextBrush" Color="#99000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <AcrylicBrush x:Key="SafeGlassBrush" FallbackColor="#CC000000" TintColor="#000000"
                                  TintOpacity="0.15" />
                    <SolidColorBrush x:Key="SafeCardBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="SafeBorderBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="SafeTextBrush" Color="White" />
                    <SolidColorBrush x:Key="SafeSecondaryTextBrush" Color="#B3FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="SafePluginCardStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource SafeGlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="24" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>

            <Style x:Key="SafeCommandBarStyle" TargetType="CommandBar">
                <Setter Property="Background" Value="{ThemeResource SafeGlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style x:Key="PluginGridCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SafeGlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <Style x:Key="PluginLayoutCardContainerStyle" TargetType="GridViewItem"
                   BasedOn="{StaticResource DefaultGridViewItemStyle}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewItem">
                            <Grid Background="Transparent">
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Control.IsTemplateFocusTarget="True" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="PluginGridCardTemplate" x:DataType="models:PluginItem">
                <Grid Margin="12,12,12,16">
                    <Border Width="300" MinHeight="190"
                            Style="{StaticResource PluginGridCardStyle}"
                            Translation="0,0,32">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="{helpers:Loc Key=RenameFolderLabel}" Click="OnRenameClick"
                                                Tag="{x:Bind}" />
                                <MenuFlyoutItem Text="{helpers:Loc Key=DeleteLabel}" Click="OnDeleteClick"
                                                Icon="Delete" Tag="{x:Bind}" />
                            </MenuFlyout>
                        </Border.ContextFlyout>

                        <Grid Padding="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                        Background="{ThemeResource SafeCardBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Top">
                                    <FontIcon Glyph="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                              Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="0,2,0,0" VerticalAlignment="Top" Spacing="3">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource SafeTextBrush}"
                                               FontFamily="{StaticResource AppGlobalFont}"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}" />

                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Developer, Mode=OneWay}"
                                                   Visibility="{x:Bind DeveloperVisibility, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   MaxWidth="130"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Developer, Mode=OneWay}"
                                                   FontFamily="{StaticResource AppGlobalFont}" />
                                        <TextBlock Text="|"
                                                   Visibility="{x:Bind DeveloperVisibility, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                   FontFamily="{StaticResource AppGlobalFont}" />
                                        <TextBlock Text="{x:Bind FileSizeDisplay, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                   FontFamily="{StaticResource AppGlobalFont}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                                           Visibility="{x:Bind DescriptionVisibility, Mode=OneWay}"
                                           FontSize="12"
                                           LineHeight="17"
                                           Foreground="{ThemeResource SafeSecondaryTextBrush}"
                                           Opacity="0.85"
                                           Margin="0,10,0,0"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top"
                                           FontFamily="{StaticResource AppGlobalFont}" />

                                <TextBlock Text="{x:Bind VersionBlockMessage, Mode=OneWay}"
                                           Visibility="{x:Bind VersionBlockVisibility, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Margin="0,4,0,0"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind VersionBlockMessage, Mode=OneWay}"
                                           FontFamily="{StaticResource AppGlobalFont}" />
                            </StackPanel>

                            <Rectangle Grid.Row="2" Height="1" Fill="{ThemeResource SafeBorderBrush}"
                                       Margin="-16,10,-16,10" />

                            <Grid Grid.Row="3" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind GameVersionText, Mode=OneWay}"
                                           Visibility="{x:Bind GameVersionVisibility, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource SafeSecondaryTextBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind GameVersionText, Mode=OneWay}"
                                           FontFamily="{StaticResource AppGlobalFont}" />

                                <Button Grid.Column="1"
                                        Click="OnConfigClick"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind ConfigVisibility, Mode=OneWay}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="8,4"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{helpers:Loc Key=PluginSettingsLabel}"
                                        ToolTipService.ToolTip="{helpers:Loc Key=EditConfigTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                        <TextBlock Text="{helpers:Loc Key=PluginSettingsLabel}" VerticalAlignment="Center"
                                                   FontSize="11" FontFamily="{StaticResource AppGlobalFont}" />
                                    </StackPanel>
                                </Button>

                                <ToggleSwitch Grid.Column="2"
                                              IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                              Toggled="OnPluginToggled"
                                              Tag="{x:Bind}"
                                              OffContent="" OnContent=""
                                              MinWidth="0"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>

            <converters:BoolInverter x:Key="BoolInverter" />

            <Storyboard x:Name="EntranceStoryboard">
                <DoubleAnimation Storyboard.TargetName="RootLayoutGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.6">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Name="ExitStoryboard">
                <DoubleAnimation Storyboard.TargetName="RootLayoutGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootLayoutGrid"
          Padding="24"
          Opacity="0"
          RenderTransformOrigin="0.5,0.5">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="40" />
            </TransitionCollection>
        </Grid.Transitions>

        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootLayoutScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{helpers:Loc Key=PluginMgmtTitle}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource AppGlobalFont}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{helpers:Loc Key=EnableInjectionTitle}" FontWeight="SemiBold"
                               Foreground="{ThemeResource SafeTextBrush}" HorizontalAlignment="Right"
                               FontFamily="{StaticResource AppGlobalFont}" />
                    <TextBlock Text="{helpers:Loc Key=InjectionLoadCaption}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"
                               FontFamily="{StaticResource AppGlobalFont}" />
                </StackPanel>

                <ToggleSwitch IsOn="{x:Bind MainViewModel.UseInjection, Mode=OneWay}"
                              Toggled="OnInjectionToggled"
                              OnContent="" OffContent=""
                              MinWidth="0"
                              VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
            <AppBarElementContainer Margin="4,0,8,0" VerticalAlignment="Center">
                <Border CornerRadius="8"
                        Padding="3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton x:Name="ListViewModeButton"
                                      Click="OnListViewModeClick"
                                      IsChecked="True"
                                      Padding="8,4"
                                      MinWidth="0"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      AutomationProperties.Name="{helpers:Loc Key=PluginPage_ListViewTooltip}"
                                      ToolTipService.ToolTip="{helpers:Loc Key=PluginPage_ListViewTooltip}">
                            <FontIcon Glyph="&#xE8FD;" FontSize="15" />
                        </ToggleButton>
                        <ToggleButton x:Name="GridViewModeButton"
                                      Click="OnGridViewModeClick"
                                      Padding="8,4"
                                      MinWidth="0"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      AutomationProperties.Name="{helpers:Loc Key=PluginPage_GridViewTooltip}"
                                      ToolTipService.ToolTip="{helpers:Loc Key=PluginPage_GridViewTooltip}">
                            <FontIcon Glyph="&#xE80A;" FontSize="15" />
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </AppBarElementContainer>

            <AppBarButton x:Name="GetPluginsBtn"
                          Icon="Download"
                          Label="{helpers:Loc Key=GetPluginsLabel}"
                          Click="OnGetPluginsClick" />

            <AppBarButton Label="{helpers:Loc Key=FreeCamHelpLabel}"
                          Click="OnFreeCamHelpClick">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE9CE;" />
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarButton Icon="Add" Label="{helpers:Loc Key=AddPluginLabel}"
                          Command="{x:Bind ViewModel.AddPluginCommand}" />
            <AppBarButton Icon="Refresh" Label="{helpers:Loc Key=RefreshLabel}"
                          Command="{x:Bind ViewModel.RefreshCommand}" />
            <AppBarButton Icon="Folder" Label="{helpers:Loc Key=OpenFolderLabel}"
                          Command="{x:Bind ViewModel.OpenFolderCommand}" />

            <AppBarButton Icon="Sort" Label="{helpers:Loc Key=SortLabel}">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="{helpers:Loc Key=SortByName}" Command="{x:Bind ViewModel.SortCommand}"
                                        CommandParameter="Name" />
                        <MenuFlyoutItem Text="{helpers:Loc Key=SortByStatus}" Command="{x:Bind ViewModel.SortCommand}"
                                        CommandParameter="Status" />
                        <MenuFlyoutItem Text="{helpers:Loc Key=SortBySize}" Command="{x:Bind ViewModel.SortCommand}"
                                        CommandParameter="Size" />
                        <MenuFlyoutItem Text="{helpers:Loc Key=SortByDate}" Command="{x:Bind ViewModel.SortCommand}"
                                        CommandParameter="Date" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <ScrollViewer x:Name="PluginContentScroll"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <Grid MinHeight="{Binding ViewportHeight, ElementName=PluginContentScroll}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <ListView x:Name="PluginListView"
                              ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
                              ContainerContentChanging="OnPluginLayoutContainerChanging"
                              SelectionMode="None"
                              Padding="0,12,0,0"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PluginItem">
                                <Grid Style="{StaticResource SafePluginCardStyle}" Translation="0,0,32">
                                    <Grid.Shadow>
                                        <ThemeShadow />
                                    </Grid.Shadow>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{helpers:Loc Key=RenameFolderLabel}" Click="OnRenameClick"
                                                            Tag="{x:Bind}" />
                                            <MenuFlyoutItem Text="{helpers:Loc Key=DeleteLabel}" Click="OnDeleteClick"
                                                            Icon="Delete" Tag="{x:Bind}" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                              Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                              Margin="0,0,16,0" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource SafeTextBrush}"
                                                   FontFamily="{StaticResource AppGlobalFont}" />

                                        <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                                                   Visibility="{x:Bind DescriptionVisibility, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2"
                                                   Margin="0,0,8,4"
                                                   FontFamily="{StaticResource AppGlobalFont}" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">

                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        Visibility="{x:Bind DeveloperVisibility, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind Developer, Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                           MaxWidth="120"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Developer, Mode=OneWay}"
                                                           FontFamily="{StaticResource AppGlobalFont}" />
                                                <TextBlock Text="|" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                           FontFamily="{StaticResource AppGlobalFont}" />
                                            </StackPanel>

                                            <TextBlock Text="{x:Bind FileSizeDisplay, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                       FontFamily="{StaticResource AppGlobalFont}" />
                                            <TextBlock Text="|" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                       FontFamily="{StaticResource AppGlobalFont}" />
                                            <TextBlock Text="{x:Bind DateModified, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                       FontFamily="{StaticResource AppGlobalFont}" />
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind VersionBlockMessage, Mode=OneWay}"
                                                   Visibility="{x:Bind VersionBlockVisibility, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind VersionBlockMessage, Mode=OneWay}"
                                                   FontFamily="{StaticResource AppGlobalFont}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind GameVersionText, Mode=OneWay}"
                                               Visibility="{x:Bind GameVersionVisibility, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SafeSecondaryTextBrush}"
                                               MaxWidth="200"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               ToolTipService.ToolTip="{x:Bind GameVersionText, Mode=OneWay}"
                                               FontFamily="{StaticResource AppGlobalFont}" />

                                    <Button Grid.Column="3"
                                            Click="OnConfigClick"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind ConfigVisibility, Mode=OneWay}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{helpers:Loc Key=EditConfigTooltip}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                            <TextBlock Text="{helpers:Loc Key=PluginSettingsLabel}" VerticalAlignment="Center"
                                                       FontSize="12" FontFamily="{StaticResource AppGlobalFont}" />
                                        </StackPanel>
                                    </Button>

                                    <ToggleSwitch Grid.Column="4"
                                                  IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                                  Toggled="OnPluginToggled"
                                                  Tag="{x:Bind}"
                                                  OffContent="" OnContent=""
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  MinWidth="0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <GridView x:Name="PluginLayoutGridView"
                              Margin="-12,0,-12,0"
                              Padding="0"
                              ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
                              ItemTemplate="{StaticResource PluginGridCardTemplate}"
                              ItemContainerStyle="{StaticResource PluginLayoutCardContainerStyle}"
                              ContainerContentChanging="OnPluginLayoutContainerChanging"
                              SelectionMode="None"
                              Visibility="Collapsed"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Left" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>

                    <TextBlock Text="{helpers:Loc Key=EmptyPluginLibrary}"
                               HorizontalAlignment="Center"
                               Margin="0,64,0,12"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                               FontFamily="{StaticResource AppGlobalFont}" />

                </StackPanel>

                <Grid Grid.Row="1" Margin="0,20,0,8">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Spacing="8">
                        <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                  FontSize="14" />
                        <TextBlock Text="{helpers:Loc Key=PluginSafetyDisclaimer}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppGlobalFont}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Spacing="8">
                        <TextBlock Text="{helpers:Loc Key=DiagnosticsHint}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   FontFamily="{StaticResource AppGlobalFont}" />
                        <Button Content="{helpers:Loc Key=DiagnosticsBtn}"
                                Click="OnOpenDiagnosticsClick"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>