<Page
    x:Class="FufuLauncher.Views.CycleChallengePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="using:FufuLauncher.Views.Controls.CycleChallenge"
    xmlns:helpers="using:FufuLauncher.Helpers"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:viewmodels="using:FufuLauncher.ViewModels"
    xmlns:views="using:FufuLauncher.Views"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <Style x:Key="CcCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="CcPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style x:Key="ModeTabButtonStyle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="20,16,20,16" RowSpacing="12" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="{helpers:Loc Key=CycleChallenge_Title}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{helpers:Loc Key=CycleChallenge_Subtitle}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    Padding="12,6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE77B;" />
                        <TextBlock
                            MaxWidth="200"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{x:Bind ViewModel.AccountText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ViewModel.AccountText, Mode=OneWay}" />
                        <views:GameRoleSelector
                            MaxWidth="320"
                            VerticalAlignment="Center"
                            Scope="{x:Bind ViewModel.RoleSelection, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Button
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    ToolTipService.ToolTip="{helpers:Loc Key=CycleChallenge_RefreshTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="{helpers:Loc Key=CycleChallenge_Refresh}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="540"
                Padding="4"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ToggleButton
                        x:Name="AbyssTab"
                        Grid.Column="0"
                        Click="OnModeTabClick"
                        IsChecked="True"
                        Style="{StaticResource ModeTabButtonStyle}"
                        Tag="SpiralAbyss">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Width="18" Height="18"
                                   Source="ms-appx:///Assets/CycleChallenge/Icons/SpiralAbyss.png" />
                            <TextBlock Text="{helpers:Loc Key=CycleChallenge_TabAbyss}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton
                        x:Name="TheaterTab"
                        Grid.Column="1"
                        Click="OnModeTabClick"
                        Style="{StaticResource ModeTabButtonStyle}"
                        Tag="Theater">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Width="18" Height="18"
                                   Source="ms-appx:///Assets/CycleChallenge/Icons/RoleCombat.png" />
                            <TextBlock Text="{helpers:Loc Key=CycleChallenge_TabTheater}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton
                        x:Name="StygianTab"
                        Grid.Column="2"
                        Click="OnModeTabClick"
                        Style="{StaticResource ModeTabButtonStyle}"
                        Tag="Stygian">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Width="18" Height="18"
                                   Source="ms-appx:///Assets/CycleChallenge/Icons/HardChallenge.png" />
                            <TextBlock Text="{helpers:Loc Key=CycleChallenge_TabStygian}" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
            </Border>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CcCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="16,14,16,10" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource FluentIconsFont}"
                                VerticalAlignment="Center"
                                FontSize="17.5"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE24E;" />
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="{helpers:Loc Key=CycleChallenge_PeriodListTitle}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{helpers:Loc Key=CycleChallenge_PeriodListDesc}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ListView
                            x:Name="PeriodList"
                            Margin="6,0"
                            ItemsSource="{x:Bind ViewModel.Periods, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedPeriod, Mode=TwoWay}"
                            SelectionMode="Single"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollMode="Enabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <primitives:ListViewItemPresenter
                                                    x:Name="Root"
                                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                                    ContentMargin="{TemplateBinding Padding}"
                                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    CornerRadius="10"
                                                    SelectionIndicatorVisualEnabled="False"
                                                    SelectionCheckMarkVisualEnabled="False"
                                                    PointerOverBackground="{ThemeResource ListViewItemBackgroundPointerOver}"
                                                    PointerOverForeground="{ThemeResource ListViewItemForegroundPointerOver}"
                                                    SelectedBackground="{ThemeResource AccentFillColorSecondaryBrush}"
                                                    SelectedForeground="{ThemeResource ListViewItemForegroundSelected}"
                                                    SelectedPointerOverBackground="{ThemeResource AccentFillColorTertiaryBrush}"
                                                    SelectedPressedBackground="{ThemeResource AccentFillColorTertiaryBrush}"
                                                    PressedBackground="{ThemeResource ListViewItemBackgroundPressed}"
                                                    DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:CycleChallengePeriodOption">
                                    <Grid MinHeight="80" Padding="10,9" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Text="{x:Bind TitleText}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind TitleText}" />
                                            <TextBlock
                                                MaxLines="2"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind SubtitleText}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap"
                                                ToolTipService.ToolTip="{x:Bind SubtitleText}"
                                                Visibility="{x:Bind HasSubtitle, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock
                                                MaxLines="2"
                                                FontSize="11"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Text="{x:Bind MetricText}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap"
                                                ToolTipService.ToolTip="{x:Bind MetricText}"
                                                Visibility="{x:Bind HasMetric, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Spacing="4">
                                            <Border
                                                Padding="7,2"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="8"
                                                Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{x:Bind StatusText}" />
                                            </Border>
                                            <Border
                                                Padding="7,2"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Visibility="{x:Bind ShowInactiveStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind StatusText}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            x:Name="PeriodEmptyState"
                            MaxWidth="220"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="Collapsed">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontSize="24"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE81C;" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{helpers:Loc Key=CycleChallenge_NoCachedPeriod}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CcCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="18,14,18,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Width="38"
                            Height="38"
                            VerticalAlignment="Center">
                            <Image
                                x:Name="AbyssHeaderIcon"
                                Source="ms-appx:///Assets/CycleChallenge/Icons/SpiralAbyss.png"
                                Stretch="Uniform" />
                            <Image
                                x:Name="TheaterHeaderIcon"
                                Source="ms-appx:///Assets/CycleChallenge/Icons/RoleCombat.png"
                                Stretch="Uniform"
                                Visibility="Collapsed" />
                            <Image
                                x:Name="StygianHeaderIcon"
                                Source="ms-appx:///Assets/CycleChallenge/Icons/HardChallenge.png"
                                Stretch="Uniform"
                                Visibility="Collapsed" />
                        </Grid>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                x:Name="DetailModeName"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.SelectedPeriod.TitleText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SelectedPeriod.TitleText, Mode=OneWay}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.SelectedPeriod.SubtitleText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SelectedPeriod.SubtitleText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.SelectedPeriod.HasSubtitle, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.SelectedPeriod, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                            <Border
                                Style="{StaticResource CcPillStyle}"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                Visibility="{x:Bind ViewModel.SelectedPeriod.HasMetric, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.SelectedPeriod.MetricText, Mode=OneWay}" />
                            </Border>
                            <Border
                                Style="{StaticResource CcPillStyle}"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind ViewModel.SelectedPeriod.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.SelectedPeriod.StatusText, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border
                        Grid.Row="0"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Opacity="0.7" />

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            x:Name="BannerPanel"
                            Grid.Row="0"
                            Margin="18,10,18,0"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.HasBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <InfoBar FontFamily="{StaticResource AppGlobalFont}"
                                IsClosable="False"
                                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                Severity="Error" />
                            <InfoBar FontFamily="{StaticResource AppGlobalFont}"
                                IsClosable="False"
                                IsOpen="{x:Bind ViewModel.IsOffline, Mode=OneWay}"
                                Message="{helpers:Loc Key=CycleChallenge_OfflineBanner}"
                                Severity="Warning" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <ScrollViewer
                                x:Name="AbyssHost"
                                Padding="18,12,8,18"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Enabled">
                                <cc:SpiralAbyssPanel x:Name="AbyssPanel" />
                            </ScrollViewer>
                            <ScrollViewer
                                x:Name="TheaterHost"
                                Padding="18,12,8,18"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Enabled"
                                Visibility="Collapsed">
                                <cc:TheaterPanel x:Name="TheaterPanel" />
                            </ScrollViewer>
                            <ScrollViewer
                                x:Name="StygianHost"
                                Padding="18,12,8,18"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Enabled"
                                Visibility="Collapsed">
                                <cc:StygianPanel x:Name="StygianPanel" />
                            </ScrollViewer>

                            <StackPanel
                                x:Name="LoadingState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="Collapsed">
                                <ProgressRing
                                    Width="32"
                                    Height="32"
                                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="Collapsed">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontSize="32"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE7BA;" />
                                <TextBlock
                                    x:Name="EmptyText"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{helpers:Loc Key=CycleChallenge_EmptyHint}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>