<Window
    x:Class="FufuLauncher.Views.ServiceStatusWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FufuLauncher.Controls"
    xmlns:helpers="using:FufuLauncher.Helpers"
    xmlns:models="using:FufuLauncher.Models">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
                <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
                </Style>
                <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
                </Style>
                <Style x:Key="MetaTextStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE9D9;"
                      FontSize="12"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      Opacity="0.7" />
            <TextBlock Grid.Column="1"
                       Text="{helpers:Loc Key=ServiceStatus_WindowTitle}"
                       Margin="8,0,140,0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.85" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Padding="32,18,32,32"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      Visibility="{x:Bind ViewModel.ShowContentVisibility, Mode=OneWay}">
            <StackPanel>

                <InfoBar FontFamily="{StaticResource AppGlobalFont}" Severity="Error"
                         IsOpen="True"
                         IsClosable="False"
                         Title="{helpers:Loc Key=ServiceStatus_LoadFailed}"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.HasErrorVisibility, Mode=OneWay}"
                         Margin="0,0,0,16">
                    <InfoBar.ActionButton>
                        <Button Content="{helpers:Loc Key=ServiceStatus_Retry}"
                                Command="{x:Bind ViewModel.RefreshCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Grid Visibility="{x:Bind ViewModel.ShowSummaryVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="10"
                             Height="10"
                             Margin="0,8,0,0"
                             VerticalAlignment="Top"
                             Fill="{x:Bind ViewModel.OverallBrush, Mode=OneWay}" />

                    <StackPanel Grid.Column="1" Margin="14,0,24,0" Spacing="3">
                        <TextBlock Text="{x:Bind ViewModel.OverallTitle, Mode=OneWay}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.OverallCaption, Mode=OneWay}"
                                   FontSize="12"
                                   Opacity="0.65" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="24"
                                VerticalAlignment="Center">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{helpers:Loc Key=ServiceStatus_Uptime90}"
                                       Style="{StaticResource MetaTextStyle}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind ViewModel.UptimeText, Mode=OneWay}"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                        <Button Width="32"
                                Height="32"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.RefreshCommand}"
                                IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                                AutomationProperties.Name="{helpers:Loc Key=ServiceStatus_Refresh}"
                                ToolTipService.ToolTip="{helpers:Loc Key=ServiceStatus_Refresh}">
                            <Grid>
                                <FontIcon Glyph="&#xE72C;"
                                          FontSize="13"
                                          Visibility="{x:Bind ViewModel.RefreshIconVisibility, Mode=OneWay}" />
                                <ProgressRing Width="14"
                                              Height="14"
                                              IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.RefreshProgressVisibility, Mode=OneWay}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0" Visibility="{x:Bind ViewModel.ShowSummaryVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="#2EA043" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.OperationalCountText, Mode=OneWay}"
                                       Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="#DA3633" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.OutageCountText, Mode=OneWay}"
                                       Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="#8B949E" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.PausedCountText, Mode=OneWay}"
                                       Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="{helpers:Loc Key=ServiceStatus_Outage}"
                                   Style="{StaticResource MetaTextStyle}"
                                   Margin="0,0,2,0" />
                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="#DA3633" />
                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="#D29922" />
                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="#2EA043" />
                        <TextBlock Text="{helpers:Loc Key=ServiceStatus_Operational}"
                                   Style="{StaticResource MetaTextStyle}"
                                   Margin="2,0,0,0" />
                    </StackPanel>
                </Grid>

                <Rectangle Height="1"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                           Margin="0,20,0,0"
                           Visibility="{x:Bind ViewModel.ShowSummaryVisibility, Mode=OneWay}" />

                <Grid Margin="0,18,0,2"
                      Visibility="{x:Bind ViewModel.ShowSummaryVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{helpers:Loc Key=ServiceStatus_Services}"
                               Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Grid.Column="1"
                               Text="{helpers:Loc Key=ServiceStatus_Last90Days}"
                               Style="{StaticResource MetaTextStyle}"
                               HorizontalAlignment="Right" />
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Monitors, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.ShowSummaryVisibility, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ServiceStatusMonitor">
                            <Grid Padding="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Width="9"
                                             Height="9"
                                             Margin="0,7,0,0"
                                             VerticalAlignment="Top"
                                             Fill="{x:Bind StatusBrush}" />

                                    <StackPanel Grid.Column="1" Margin="14,0,20,0" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind CaptionText}"
                                                   FontSize="12"
                                                   Opacity="0.65"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind Uptime90Text}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{helpers:Loc Key=ServiceStatus_Days90Short}"
                                                   FontSize="10"
                                                   Opacity="0.55"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <Button Grid.Column="3"
                                            Width="30"
                                            Height="30"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Margin="8,0,4,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            VerticalAlignment="Center"
                                            DataContext="{x:Bind}"
                                            Tag="{x:Bind}"
                                            Click="OnOpenDetailClick"
                                            AutomationProperties.Name="{helpers:Loc Key=ServiceDetail_ViewDetails}"
                                            ToolTipService.ToolTip="{helpers:Loc Key=ServiceDetail_ViewDetails}">
                                        <FontIcon Glyph="&#xE76C;" FontSize="14" Opacity="0.65" />
                                    </Button>
                                </Grid>

                                <controls:ServiceUptimeGraph Grid.Row="1"
                                                             Margin="0,12,0,14"
                                                             HorizontalAlignment="Stretch"
                                                             DataContext="{x:Bind}" />

                                <Rectangle Grid.Row="2"
                                           Height="1"
                                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <StackPanel HorizontalAlignment="Center"
                            Margin="0,56,0,0"
                            Spacing="10"
                            Visibility="{x:Bind ViewModel.ShowEmptyVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE9D9;" FontSize="24" Opacity="0.35" />
                    <TextBlock Text="{helpers:Loc Key=ServiceStatus_NoData}"
                               FontSize="12"
                               Opacity="0.6"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Margin="0,18,0,0"
                            Visibility="{x:Bind ViewModel.ShowFooterVisibility, Mode=OneWay}">
                    <ProgressRing Width="14"
                                  Height="14"
                                  IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.LoadingMoreVisibility, Mode=OneWay}" />
                    <Button Content="{helpers:Loc Key=ServiceStatus_LoadMore}"
                            Command="{x:Bind ViewModel.LoadMoreCommand}"
                            IsEnabled="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="16,6" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1"
              Visibility="{x:Bind ViewModel.ShowLoadingVisibility, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <ProgressRing Width="28" Height="28" IsActive="True" />
                <TextBlock Text="{helpers:Loc Key=ServiceStatus_Loading}"
                           FontSize="12"
                           Opacity="0.6"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>