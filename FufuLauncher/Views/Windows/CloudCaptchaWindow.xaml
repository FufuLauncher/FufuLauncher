<Window
    x:Class="FufuLauncher.Views.CloudCaptchaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:FufuLauncher.Helpers"
    mc:Ignorable="d"
    Title="{helpers:Loc Key=CloudSync_CaptchaWindowTitle}">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <FontIcon Glyph="&#xE72E;" FontSize="13" />
                <TextBlock Text="{helpers:Loc Key=CloudSync_CaptchaTitle}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Padding="16,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusTextBlock"
                       Text="{helpers:Loc Key=CloudSync_CaptchaHint}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <Button x:Name="OpenExternalBtn"
                    Grid.Column="1"
                    Content="{helpers:Loc Key=CloudSync_CaptchaOpenBrowser}"
                    Click="OnOpenInBrowserClick"
                    FontSize="12"
                    Padding="10,4" />
        </Grid>

        <Grid Grid.Row="2">
            <ProgressRing x:Name="LoadingRing"
                          Width="36"
                          Height="36"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsActive="True" />
            <WebView2 x:Name="CaptchaWebView" Source="about:blank" />
        </Grid>
    </Grid>
</Window>
