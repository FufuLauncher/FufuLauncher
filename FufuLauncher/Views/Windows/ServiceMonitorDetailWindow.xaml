<Window
    x:Class="FufuLauncher.Views.ServiceMonitorDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FufuLauncher.Controls"
    xmlns:helpers="using:FufuLauncher.Helpers"
    xmlns:models="using:FufuLauncher.Models">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
                <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
                </Style>
                <Style x:Key="MetaTextStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
                </Style>
                <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
                </Style>
                <Style x:Key="StatValueStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                    <Setter Property="FontSize" Value="22" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
                </Style>
                <Style x:Key="StatLabelStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE9D9;"
                      FontSize="12"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      Opacity="0.7" />
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.MonitorName}"
                       Margin="8,0,140,0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.85"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Padding="32,10,32,32"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
            <StackPanel>

                <HyperlinkButton Content="{helpers:Loc Key=ServiceDetail_BackToStatus}"
                                 Click="OnBackClick"
                                 Padding="0"
                                 Margin="0,0,0,12"
                                 FontSize="12" />

                <InfoBar FontFamily="{StaticResource AppGlobalFont}" Severity="Error"
                         IsOpen="True"
                         IsClosable="False"
                         Title="{helpers:Loc Key=ServiceDetail_LoadFailed}"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}"
                         Margin="0,0,0,16">
                    <InfoBar.ActionButton>
                        <Button Content="{helpers:Loc Key=ServiceStatus_Retry}"
                                Command="{x:Bind ViewModel.RefreshCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <StackPanel Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="10"
                                 Height="10"
                                 Margin="0,8,0,0"
                                 VerticalAlignment="Top"
                                 Fill="{x:Bind ViewModel.StatusBrush, Mode=OneWay}" />

                        <StackPanel Grid.Column="1" Margin="14,0,24,0" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.MonitorName}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.HeaderCaption, Mode=OneWay}"
                                       FontSize="12"
                                       Opacity="0.65" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Width="32"
                                Height="32"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.RefreshCommand}"
                                IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                                AutomationProperties.Name="{helpers:Loc Key=ServiceStatus_Refresh}"
                                ToolTipService.ToolTip="{helpers:Loc Key=ServiceStatus_Refresh}">
                            <Grid>
                                <FontIcon Glyph="&#xE72C;"
                                          FontSize="13"
                                          Visibility="{x:Bind ViewModel.RefreshIconVisibility, Mode=OneWay}" />
                                <ProgressRing Width="14"
                                              Height="14"
                                              IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.RefreshProgressVisibility, Mode=OneWay}" />
                            </Grid>
                        </Button>
                    </Grid>

                    <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                               Margin="0,18,0,0" />

                    <Grid Margin="0,20,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{helpers:Loc Key=ServiceDetail_Uptime}"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{helpers:Loc Key=ServiceStatus_Last90Days}"
                                   Style="{StaticResource MetaTextStyle}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.Uptime90Text, Mode=OneWay}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <controls:ServiceUptimeGraph Margin="0,8,0,0"
                                                 HorizontalAlignment="Stretch"
                                                 DataContext="{x:Bind ViewModel.Detail, Mode=OneWay}" />

                    <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                               Margin="0,20,0,0" />

                    <Grid Margin="0,20,0,10">
                        <TextBlock Text="{helpers:Loc Key=ServiceDetail_OverallUptime}"
                                   Style="{StaticResource SectionLabelStyle}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.Uptime1Text, Mode=OneWay}"
                                       Style="{StaticResource StatValueStyle}" />
                            <TextBlock Text="{helpers:Loc Key=ServiceDetail_Last24Hours}"
                                       Style="{StaticResource StatLabelStyle}" />
                        </StackPanel>
                        <Rectangle Grid.Column="1" Width="1" Height="34" Margin="12,0"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.Uptime7Text, Mode=OneWay}"
                                       Style="{StaticResource StatValueStyle}" />
                            <TextBlock Text="{helpers:Loc Key=ServiceDetail_Last7Days}"
                                       Style="{StaticResource StatLabelStyle}" />
                        </StackPanel>
                        <Rectangle Grid.Column="3" Width="1" Height="34" Margin="12,0"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="4" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.Uptime30Text, Mode=OneWay}"
                                       Style="{StaticResource StatValueStyle}" />
                            <TextBlock Text="{helpers:Loc Key=ServiceDetail_Last30Days}"
                                       Style="{StaticResource StatLabelStyle}" />
                        </StackPanel>
                        <Rectangle Grid.Column="5" Width="1" Height="34" Margin="12,0"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="6" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.Uptime90Text, Mode=OneWay}"
                                       Style="{StaticResource StatValueStyle}" />
                            <TextBlock Text="{helpers:Loc Key=ServiceStatus_Last90Days}"
                                       Style="{StaticResource StatLabelStyle}" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                               Margin="0,20,0,0" />

                    <Grid Margin="0,20,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{helpers:Loc Key=ServiceDetail_ResponseTime}"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{helpers:Loc Key=ServiceDetail_Last2Days}"
                                   Style="{StaticResource MetaTextStyle}" />
                    </Grid>
                    <controls:ServiceResponseTimeGraph Height="170"
                                                       HorizontalAlignment="Stretch"
                                                       DataContext="{x:Bind ViewModel.Detail, Mode=OneWay}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.AverageResponseText, Mode=OneWay}"
                                       Style="{StaticResource StatValueStyle}" />
                            <TextBlock Text="{helpers:Loc Key=ServiceDetail_AverageResponseTime}"
                                       Style="{StaticResource StatLabelStyle}" />
                        </StackPanel>
                        <Rectangle Grid.Column="1" Width="1" Height="34" Margin="12,0"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.MaxResponseText, Mode=OneWay}"
                                       Style="{StaticResource StatValueStyle}" />
                            <TextBlock Text="{helpers:Loc Key=ServiceDetail_MaxResponseTime}"
                                       Style="{StaticResource StatLabelStyle}" />
                        </StackPanel>
                        <Rectangle Grid.Column="3" Width="1" Height="34" Margin="12,0"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="4" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.MinResponseText, Mode=OneWay}"
                                       Style="{StaticResource StatValueStyle}" />
                            <TextBlock Text="{helpers:Loc Key=ServiceDetail_MinResponseTime}"
                                       Style="{StaticResource StatLabelStyle}" />
                        </StackPanel>
                        <Rectangle Grid.Column="5" Width="1" Height="34" Margin="12,0"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="6" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.TotalChecksText, Mode=OneWay}"
                                       Style="{StaticResource StatValueStyle}" />
                            <TextBlock Text="{helpers:Loc Key=ServiceDetail_TotalChecks}"
                                       Style="{StaticResource StatLabelStyle}" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                               Margin="0,20,0,0" />

                    <Grid Margin="0,20,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{helpers:Loc Key=ServiceDetail_RecentEvents}"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <HyperlinkButton Grid.Column="1"
                                         Content="{helpers:Loc Key=ServiceDetail_ShowMoreEvents}"
                                         Command="{x:Bind ViewModel.ShowMoreEventsCommand}"
                                         Visibility="{x:Bind ViewModel.ShowMoreVisibility, Mode=OneWay}"
                                         Padding="0"
                                         FontSize="12" />
                    </Grid>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.VisibleEvents, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.EventsVisibility, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:ServiceMonitorEvent">
                                <Grid Padding="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Margin="0,6,0,0"
                                                 VerticalAlignment="Top"
                                                 Fill="{x:Bind StatusBrush}" />

                                        <StackPanel Grid.Column="1" Margin="12,0,20,0" Spacing="1">
                                            <TextBlock Text="{x:Bind StatusText}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind DetailText}"
                                                       FontSize="11"
                                                       Opacity="0.6"
                                                       TextWrapping="Wrap"
                                                       Visibility="{x:Bind DetailVisibility}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind TimeText}"
                                                   FontSize="11"
                                                   Opacity="0.6"
                                                   Margin="0,2,0,0"
                                                   VerticalAlignment="Top" />
                                    </Grid>

                                    <Rectangle Grid.Row="1"
                                               Height="1"
                                               Margin="0,10,0,0"
                                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <TextBlock Text="{helpers:Loc Key=ServiceDetail_NoEvents}"
                               Margin="0,16,0,0"
                               Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{x:Bind ViewModel.NoEventsVisibility, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1"
              Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <ProgressRing Width="28" Height="28" IsActive="True" />
                <TextBlock Text="{helpers:Loc Key=ServiceDetail_Loading}"
                           FontSize="12"
                           Opacity="0.6"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>