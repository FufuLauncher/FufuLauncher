<?xml version="1.0" encoding="utf-8"?>

<Window x:Class="FufuLauncher.Views.MiyousheQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="using:FufuLauncher.Helpers"
        Title="{helpers:Loc Key=MiyousheQr_Title}">
    <Grid x:Name="ScanRootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <TextBlock Text="{helpers:Loc Key=MiyousheQr_Title}" Margin="16,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24" Spacing="20">
                <TextBlock Text="{helpers:Loc Key=MiyousheQr_Instructions}" TextWrapping="Wrap" />
                <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{helpers:Loc Key=MiyousheQr_CurrentAccount}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="AccountText" FontSize="18" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel x:Name="TargetPanel" Visibility="Collapsed" Spacing="8">
                    <TextBlock Text="{helpers:Loc Key=MiyousheQr_Target}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TargetText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{helpers:Loc Key=MiyousheQr_ConfirmHint}" TextWrapping="Wrap" />
                    <Button x:Name="ConfirmButton" Content="{helpers:Loc Key=MiyousheQr_Confirm}" Click="Confirm_Click"
                            Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                </StackPanel>
                <ProgressRing x:Name="Progress" Width="28" Height="28" IsActive="False" Visibility="Collapsed" />
                <InfoBar FontFamily="{StaticResource AppGlobalFont}" x:Name="Status" IsOpen="False" IsClosable="False" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CaptureButton" MinHeight="60" Padding="12,16" FontSize="17"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="{helpers:Loc Key=MiyousheQr_Capture}" Click="Capture_Click" />
                    <Button x:Name="ContinuousButton" Grid.Column="1" MinHeight="60" Padding="12,16" FontSize="17"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="{helpers:Loc Key=MiyousheQr_Continuous}" Click="Continuous_Click" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="24,0,24,24" Spacing="4">
            <CheckBox x:Name="AutoConfirmCheckBox"
                      Content="{helpers:Loc Key=MiyousheQr_AutoConfirm}" IsChecked="True"
                      ToolTipService.ToolTip="{helpers:Loc Key=MiyousheQr_AutoConfirmHint}" />
            <CheckBox x:Name="StopAfterLoginCheckBox"
                      Content="{helpers:Loc Key=MiyousheQr_StopAfterLogin}" IsChecked="True"
                      ToolTipService.ToolTip="{helpers:Loc Key=MiyousheQr_StopAfterLoginHint}" />
        </StackPanel>
    </Grid>
</Window>