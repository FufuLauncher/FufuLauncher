<Window
    x:Class="FufuLauncher.Views.PluginInstallWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:FufuLauncher.Helpers"
    mc:Ignorable="d"
    Title="{helpers:Loc Key=PluginInstallWindowTitle}">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="InstallWindowTintBrush" Color="#B3F2F2F2" />
                        <SolidColorBrush x:Key="InstallWindowStrokeBrush" Color="#24000000" />
                        <SolidColorBrush x:Key="InstallWindowTextBrush" Color="#FF1B1B1B" />
                        <SolidColorBrush x:Key="InstallWindowSecondaryTextBrush" Color="#992A2A2A" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="InstallWindowTintBrush" Color="#B31F1F1F" />
                        <SolidColorBrush x:Key="InstallWindowStrokeBrush" Color="#2EFFFFFF" />
                        <SolidColorBrush x:Key="InstallWindowTextBrush" Color="#FFF4F4F4" />
                        <SolidColorBrush x:Key="InstallWindowSecondaryTextBrush" Color="#A6FFFFFF" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <Style x:Key="InstallWindowButtonStyle" TargetType="Button"
                       BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="MinWidth" Value="104" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="16,0" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Border CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource InstallWindowStrokeBrush}"
                Background="{ThemeResource InstallWindowTintBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="AppTitleBar"
                      Grid.Row="0"
                      Height="44"
                      Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE7B8;"
                              FontSize="12"
                              Margin="20,0,0,0"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource InstallWindowSecondaryTextBrush}" />

                    <TextBlock x:Name="TitleBarText"
                               Grid.Column="1"
                               Margin="10,0,148,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource InstallWindowSecondaryTextBrush}" />
                </Grid>

                <Grid Grid.Row="1" Margin="32,6,32,24" RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="48" Height="48" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74C;"
                                      FontSize="24"
                                      Foreground="{ThemeResource InstallWindowSecondaryTextBrush}" />
                            <Image x:Name="PluginIcon" Stretch="UniformToFill" />
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock x:Name="PluginNameText"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource InstallWindowTextBrush}" />
                            <TextBlock x:Name="PluginMetaText"
                                       FontSize="12"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource InstallWindowSecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="StatusText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource InstallWindowTextBrush}" />

                            <TextBlock x:Name="PercentText"
                                       Grid.Column="1"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Foreground="{ThemeResource InstallWindowTextBrush}" />
                        </Grid>

                        <ProgressBar x:Name="InstallProgressBar"
                                     Maximum="100"
                                     Value="0"
                                     Height="6"
                                     CornerRadius="3"
                                     Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                        <TextBlock x:Name="DetailText"
                                   FontSize="11.5"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed"
                                   Foreground="{ThemeResource InstallWindowSecondaryTextBrush}" />

                        <TextBlock x:Name="ErrorText"
                                   FontSize="12"
                                   LineHeight="18"
                                   MaxLines="2"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10">
                        <Button x:Name="CancelButton"
                                Content="{helpers:Loc Key=PluginStoreCancelInstall}"
                                Style="{StaticResource InstallWindowButtonStyle}"
                                Click="OnCancelClick" />
                        <Button x:Name="CloseButton"
                                Content="{helpers:Loc Key=CloseBtn}"
                                Visibility="Collapsed"
                                Style="{StaticResource InstallWindowButtonStyle}"
                                Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
