<Window
    x:Class="FufuLauncher.Views.CutsceneResourcesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:FufuLauncher.Helpers"
    xmlns:views="using:FufuLauncher.Views"
    Title="{helpers:Loc Key=Cutscene_Title}">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto" Loaded="OnLoaded">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="CutsceneArchonBadgeBrush" Color="#785407" />
                        <SolidColorBrush x:Key="CutsceneStoryBadgeBrush" Color="#6448A4" />
                        <SolidColorBrush x:Key="CutsceneEventBadgeBrush" Color="#983B30" />
                        <SolidColorBrush x:Key="CutsceneTribalBadgeBrush" Color="#285B96" />
                        <SolidColorBrush x:Key="CutsceneWorldBadgeBrush" Color="#146773" />
                        <SolidColorBrush x:Key="CutsceneOtherBadgeBrush" Color="#366542" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="CutsceneArchonBadgeBrush" Color="#F4CF80" />
                        <SolidColorBrush x:Key="CutsceneStoryBadgeBrush" Color="#CCBCFF" />
                        <SolidColorBrush x:Key="CutsceneEventBadgeBrush" Color="#FFADA1" />
                        <SolidColorBrush x:Key="CutsceneTribalBadgeBrush" Color="#9CC7FF" />
                        <SolidColorBrush x:Key="CutsceneWorldBadgeBrush" Color="#85DBE7" />
                        <SolidColorBrush x:Key="CutsceneOtherBadgeBrush" Color="#A5D5A9" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <StaticResource x:Key="CutsceneArchonBadgeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                        <StaticResource x:Key="CutsceneStoryBadgeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                        <StaticResource x:Key="CutsceneEventBadgeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                        <StaticResource x:Key="CutsceneTribalBadgeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                        <StaticResource x:Key="CutsceneWorldBadgeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                        <StaticResource x:Key="CutsceneOtherBadgeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <Style x:Key="CutsceneBadgeStyle" TargetType="ContentControl">
                    <Setter Property="FontFamily" Value="{ThemeResource CaptionThemeFontFamily}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="8,3" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ContentControl">
                                <Grid>
                                    <Border Background="{TemplateBinding Foreground}" Opacity="0.14" CornerRadius="10" />
                                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                      Padding="{TemplateBinding Padding}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="CutsceneArchonBadgeStyle" TargetType="ContentControl" BasedOn="{StaticResource CutsceneBadgeStyle}">
                    <Setter Property="Foreground" Value="{ThemeResource CutsceneArchonBadgeBrush}" />
                </Style>
                <Style x:Key="CutsceneStoryBadgeStyle" TargetType="ContentControl" BasedOn="{StaticResource CutsceneBadgeStyle}">
                    <Setter Property="Foreground" Value="{ThemeResource CutsceneStoryBadgeBrush}" />
                </Style>
                <Style x:Key="CutsceneHangoutBadgeStyle" TargetType="ContentControl" BasedOn="{StaticResource CutsceneStoryBadgeStyle}" />
                <Style x:Key="CutsceneEventBadgeStyle" TargetType="ContentControl" BasedOn="{StaticResource CutsceneBadgeStyle}">
                    <Setter Property="Foreground" Value="{ThemeResource CutsceneEventBadgeBrush}" />
                </Style>
                <Style x:Key="CutsceneTribalBadgeStyle" TargetType="ContentControl" BasedOn="{StaticResource CutsceneBadgeStyle}">
                    <Setter Property="Foreground" Value="{ThemeResource CutsceneTribalBadgeBrush}" />
                </Style>
                <Style x:Key="CutsceneWorldBadgeStyle" TargetType="ContentControl" BasedOn="{StaticResource CutsceneBadgeStyle}">
                    <Setter Property="Foreground" Value="{ThemeResource CutsceneWorldBadgeBrush}" />
                </Style>
                <Style x:Key="CutsceneOtherBadgeStyle" TargetType="ContentControl" BasedOn="{StaticResource CutsceneBadgeStyle}">
                    <Setter Property="Foreground" Value="{ThemeResource CutsceneOtherBadgeBrush}" />
                </Style>

                <Style x:Key="CutsceneMetadataBadgeStyle" TargetType="Border">
                    <Setter Property="Height" Value="22" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                </Style>

                <DataTemplate x:Key="CutsceneDisplayOptionLabel">
                    <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </DataTemplate>

                <ControlTemplate x:Key="CutsceneFilterTemplate" TargetType="ToggleButton">
                    <Grid x:Name="Chip" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Tint.Opacity" Value="0.21" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Tint.Opacity" Value="0.27" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Opacity" Value="0.48" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Outline.Opacity" Value="1" />
                                        <Setter Target="Tint.Opacity" Value="0.20" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Outline.Opacity" Value="1" />
                                        <Setter Target="Tint.Opacity" Value="0.25" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Outline.Opacity" Value="1" />
                                        <Setter Target="Tint.Opacity" Value="0.29" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Outline.Opacity" Value="1" />
                                        <Setter Target="Chip.Opacity" Value="0.48" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Tint" Background="{TemplateBinding Foreground}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0.14" />
                        <Border x:Name="Outline" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1.5"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid x:Name="AppTitleBar" Height="36" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="/Assets/WindowIcon.ico" Width="16" Height="16" />
                <TextBlock Text="{helpers:Loc Key=Cutscene_Title}" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,12,24,12" Spacing="10">
            <StackPanel x:Name="ManagementHeader" Spacing="12" Visibility="Collapsed">
                <Border Padding="16,12" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock x:Name="InstallSummary" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NetChangeText" Grid.Column="1" FontSize="16" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <TextBlock x:Name="GameVersionText" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <HyperlinkButton x:Name="QuickCatalogUpdateLink" Grid.Column="1"
                                             Content="{helpers:Loc Key=Cutscene_CatalogUpdate}" Click="OnUpdateNameCatalogClick"
                                             VerticalAlignment="Center" />
                        </Grid>
                        <Grid Height="7" CornerRadius="3.5" Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="RetainedColumn" Width="0*" />
                                <ColumnDefinition x:Name="RemovalColumn" Width="0*" />
                                <ColumnDefinition x:Name="DownloadColumn" Width="0*" />
                                <ColumnDefinition x:Name="AbsentColumn" Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" />
                            <Border Grid.Column="1" Background="{ThemeResource SystemFillColorCriticalBrush}" />
                            <Border Grid.Column="2" Background="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="{helpers:Loc Key=Cutscene_Search}"
                                    TextChanged="OnSearchChanged" AutomationProperties.Name="{helpers:Loc Key=Cutscene_Search}">
                        <AutoSuggestBox.QueryIcon>
                            <SymbolIcon Symbol="Find" />
                        </AutoSuggestBox.QueryIcon>
                    </AutoSuggestBox>
                    <DropDownButton x:Name="TravelerButton" Grid.Column="1" Content="{helpers:Loc Key=Cutscene_BatchMenu}"
                                    IsEnabled="False">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="RemoveAetherItem" Text="{helpers:Loc Key=Cutscene_RemoveAether}"
                                                Click="OnRemoveAetherClick" />
                                <MenuFlyoutItem x:Name="RemoveLumineItem" Text="{helpers:Loc Key=Cutscene_RemoveLumine}"
                                                Click="OnRemoveLumineClick" />
                                <MenuFlyoutItem x:Name="ClearTravelerItem" Text="{helpers:Loc Key=Cutscene_ClearTraveler}"
                                                Click="OnClearTravelerClick" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="QueueLinkedAudioItem" Text="{helpers:Loc Key=Cutscene_QueueLinkedAudio}"
                                                Click="OnQueueLinkedAudioClick" />
                                <MenuFlyoutSubItem x:Name="QueueAudioByLangSubMenu" Text="{helpers:Loc Key=Cutscene_QueueAudioByLang}">
                                    <MenuFlyoutItem x:Name="QueueChineseAudioItem" Text="{helpers:Loc Key=Cutscene_VoiceChinese}"
                                                    Tag="Chinese" Click="OnQueueAudioByLanguageClick" />
                                    <MenuFlyoutItem x:Name="QueueEnglishAudioItem" Text="{helpers:Loc Key=Cutscene_VoiceEnglish}"
                                                    Tag="English(US)" Click="OnQueueAudioByLanguageClick" />
                                    <MenuFlyoutItem x:Name="QueueJapaneseAudioItem" Text="{helpers:Loc Key=Cutscene_VoiceJapanese}"
                                                    Tag="Japanese" Click="OnQueueAudioByLanguageClick" />
                                    <MenuFlyoutItem x:Name="QueueKoreanAudioItem" Text="{helpers:Loc Key=Cutscene_VoiceKorean}"
                                                    Tag="Korean" Click="OnQueueAudioByLanguageClick" />
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton x:Name="ResourceActionsButton" Grid.Column="2" Content="{helpers:Loc Key=Cutscene_ResourceActions}">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="{helpers:Loc Key=Cutscene_CatalogUpdate}" Click="OnUpdateNameCatalogClick" />
                                <MenuFlyoutItem Text="{helpers:Loc Key=Cutscene_CatalogImport}" Click="OnImportCatalogClick" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="{helpers:Loc Key=Cutscene_VoicePacks}" Click="OnVoicePacksClick" />
                                <MenuFlyoutItem x:Name="LockCleanedItem" Text="{helpers:Loc Key=Cutscene_LockCleaned}"
                                                Click="OnLockCleanedClick" />
                                <MenuFlyoutItem x:Name="UnlockCleanedItem" Text="{helpers:Loc Key=Cutscene_UnlockCleaned}"
                                                Click="OnUnlockCleanedClick" />
                                <MenuFlyoutItem Text="{helpers:Loc Key=Cutscene_BypassCheck}" Click="OnPersistentBypassClick" />
                                <MenuFlyoutSeparator x:Name="MediaToolsSeparator" Visibility="Collapsed" />
                                <MenuFlyoutItem x:Name="AutoSetupToolsItem" Text="{helpers:Loc Key=Cutscene_AutoSetupTools}"
                                                Click="OnAutoSetupToolsClick" Visibility="Collapsed" />
                                <MenuFlyoutItem x:Name="ChooseDecoderItem" Text="{helpers:Loc Key=Cutscene_ChooseDecoder}"
                                                Click="OnChooseDecoderClick" Visibility="Collapsed" />
                                <MenuFlyoutItem x:Name="ChooseFfmpegItem" Text="{helpers:Loc Key=Cutscene_ChooseFfmpeg}"
                                                Click="OnChooseFfmpegClick" Visibility="Collapsed" />
                                <MenuFlyoutItem x:Name="ClearPreviewCacheItem" Text="{helpers:Loc Key=Cutscene_ClearPreviewCache}"
                                                Click="OnClearPreviewCacheClick" Visibility="Collapsed" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="RefreshButton" Grid.Column="3" Click="OnRefreshClick"
                            ToolTipService.ToolTip="{helpers:Loc Key=Cutscene_Refresh}"
                            AutomationProperties.Name="{helpers:Loc Key=Cutscene_Refresh}">
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="12">
                    <ComboBox x:Name="ResourceScopeFilter" SelectedIndex="0" SelectionChanged="OnResourceScopeChanged"
                              AutomationProperties.Name="{helpers:Loc Key=Cutscene_ResourceScope}" MinWidth="150">
                        <ComboBoxItem Content="{helpers:Loc Key=Cutscene_ScopeAll}" Tag="All" />
                        <ComboBoxItem Content="{helpers:Loc Key=Cutscene_ScopeVideo}" Tag="Video" />
                        <ComboBoxItem Content="{helpers:Loc Key=Cutscene_ScopeAudio}" Tag="Audio" />
                    </ComboBox>
                    <ComboBox x:Name="AudioLanguageFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnAudioLanguageChanged"
                              AutomationProperties.Name="{helpers:Loc Key=Cutscene_AudioLanguageFilter}" MinWidth="130">
                        <ComboBoxItem Content="{helpers:Loc Key=Cutscene_AllLanguages}" Tag="" />
                        <ComboBoxItem Content="{helpers:Loc Key=Cutscene_VoiceChinese}" Tag="Chinese" />
                        <ComboBoxItem Content="{helpers:Loc Key=Cutscene_VoiceEnglish}" Tag="English(US)" />
                        <ComboBoxItem Content="{helpers:Loc Key=Cutscene_VoiceJapanese}" Tag="Japanese" />
                        <ComboBoxItem Content="{helpers:Loc Key=Cutscene_VoiceKorean}" Tag="Korean" />
                    </ComboBox>
                    <ComboBox x:Name="SortDirection" Grid.Column="2" SelectedIndex="1" SelectionChanged="OnSortChanged"
                              AutomationProperties.Name="{helpers:Loc Key=Cutscene_SortByRelease}" MinWidth="130">
                        <ComboBoxItem Content="{helpers:Loc Key=Cutscene_SortAscending}" />
                        <ComboBoxItem Content="{helpers:Loc Key=Cutscene_SortDescending}" />
                    </ComboBox>
                    <ScrollViewer Grid.Column="3" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox x:Name="ShowReleaseVersion" Content="{helpers:Loc Key=Cutscene_ShowReleaseVersion}"
                                      ContentTemplate="{StaticResource CutsceneDisplayOptionLabel}" MinWidth="0" MinHeight="26"
                                      IsChecked="False" Click="OnDisplayOptionsChanged" />
                            <CheckBox x:Name="ShowClipCount" Content="{helpers:Loc Key=Cutscene_ShowClipCount}"
                                      ContentTemplate="{StaticResource CutsceneDisplayOptionLabel}" MinWidth="0" MinHeight="26"
                                      IsChecked="False" Click="OnDisplayOptionsChanged" />
                            <CheckBox x:Name="ShowPlaybackExport" Content="{helpers:Loc Key=Cutscene_ShowPlaybackExport}"
                                      ContentTemplate="{StaticResource CutsceneDisplayOptionLabel}" MinWidth="0" MinHeight="26"
                                      IsChecked="False" Click="OnDisplayOptionsChanged" />
                        </StackPanel>
                    </ScrollViewer>
                    <ToggleButton x:Name="PendingOnlyButton" Grid.Column="4" Click="OnPendingOnlyClick"
                                  CornerRadius="14" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>

                <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Filters" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8" />
                </ScrollViewer>
            </StackPanel>
            <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" />
        </StackPanel>

        <Border x:Name="CatalogSetup" Grid.Row="2" Margin="24,16" Padding="30,26" MaxWidth="560"
                HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="12">
                <TextBlock Text="{helpers:Loc Key=Cutscene_CatalogSetupTitle}" Style="{StaticResource TitleTextBlockStyle}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{helpers:Loc Key=Cutscene_CatalogRequired}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                    <Button x:Name="FetchCatalogButton" Style="{StaticResource AccentButtonStyle}"
                            Content="{helpers:Loc Key=Cutscene_CatalogFetch}" Click="OnUpdateNameCatalogClick" />
                    <Button x:Name="ImportCatalogButton" Content="{helpers:Loc Key=Cutscene_CatalogImport}"
                            Click="OnImportCatalogClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid x:Name="ManagementList" Grid.Row="2" Margin="24,0,24,12" RowDefinitions="Auto,*" Visibility="Collapsed"
              CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid Padding="12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"
                  BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <CheckBox x:Name="KeepVisible" MinWidth="0" VerticalAlignment="Center" Click="OnKeepVisibleClick"
                          AutomationProperties.Name="{helpers:Loc Key=Cutscene_KeepVisible}" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="VisibleSummary" FontWeight="SemiBold" />
                    <TextBlock Text="{helpers:Loc Key=Cutscene_KeepHint}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="ExpandButton" Grid.Column="2" VerticalAlignment="Center"
                        Click="OnExpandClick" Content="{helpers:Loc Key=Cutscene_ExpandAll}" />
            </Grid>

            <ListView Grid.Row="1" x:Name="ChapterList" SelectionMode="None"
                      HorizontalContentAlignment="Stretch" IsItemClickEnabled="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:CutsceneChapterRow">
                        <Grid Padding="12,3,12,3" ColumnDefinitions="Auto,*" ColumnSpacing="6"
                              ToolTipService.ToolTip="{x:Bind ProtectionHint, Mode=OneWay}"
                              BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <CheckBox IsChecked="{x:Bind IsKept, Mode=OneWay}" IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                      Click="OnKeepChapterClick"
                                      MinWidth="0" VerticalAlignment="Top" Margin="0,8,0,0"
                                      AutomationProperties.Name="{Binding Title}" />
                            <Expander Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,84,Auto" Padding="0,4">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" ToolTipService.ToolTip="{x:Bind Title}" />
                                        <Border Grid.Column="1" Margin="0,0,8,0" Padding="6,0" CornerRadius="5"
                                                Style="{StaticResource CutsceneMetadataBadgeStyle}"
                                                Visibility="{x:Bind ReleaseVisibility, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ReleaseLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <ContentControl Grid.Column="2" Content="{x:Bind TypeLabel}" HorizontalAlignment="Right"
                                                        Style="{StaticResource CutsceneBadgeStyle}"
                                                        DataContextChanged="OnChapterBadgeContextChanged" />
                                        <Button Grid.Column="3" Tag="{x:Bind}" Click="OnExportChapterClick"
                                                Visibility="{x:Bind ExportChapterVisibility, Mode=OneWay}"
                                                Margin="8,0,0,0" Padding="6,4" VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{helpers:Loc Key=Cutscene_ExportChapter}"
                                                AutomationProperties.Name="{helpers:Loc Key=Cutscene_ExportChapter}">
                                            <SymbolIcon Symbol="Save" />
                                        </Button>
                                        <TextBlock Grid.Column="4" Text="{x:Bind SizeLabel}" Margin="8,0,0,0" TextAlignment="Right"
                                                   VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                        <Border Grid.Column="5" Width="22" Margin="12,0,0,0" CornerRadius="11"
                                                Style="{StaticResource CutsceneMetadataBadgeStyle}"
                                                Visibility="{x:Bind CountVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind CountLabel}">
                                            <TextBlock Text="{x:Bind CountText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       AutomationProperties.Name="{x:Bind CountLabel}" />
                                        </Border>
                                    </Grid>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,5" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                                <CheckBox MinWidth="0" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsKept, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
                                                          AutomationProperties.Name="{Binding DisplayName}" />
                                                <Border Grid.Column="1" Padding="6,2" CornerRadius="4"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KindTagText}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{Binding DisplayName}" />
                                                    <TextBlock Text="{Binding StateLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" VerticalAlignment="Center"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"
                                                            Visibility="{Binding LocalActionsVisibility}" VerticalAlignment="Center">
                                                    <Button Tag="{Binding}" Click="OnPlayLocalCutsceneClick" Padding="7"
                                                            ToolTipService.ToolTip="{helpers:Loc Key=Cutscene_PlayLocal}"
                                                            AutomationProperties.Name="{helpers:Loc Key=Cutscene_PlayLocal}">
                                                        <SymbolIcon Symbol="Play" />
                                                    </Button>
                                                    <Button Tag="{Binding}" Click="OnExportLocalCutsceneClick" Padding="7"
                                                            ToolTipService.ToolTip="{helpers:Loc Key=Cutscene_ExportLocal}"
                                                            AutomationProperties.Name="{helpers:Loc Key=Cutscene_ExportLocal}">
                                                        <SymbolIcon Symbol="Save" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="18"
                       TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" />
        </Grid>

        <Border x:Name="Footer" Grid.Row="3" Padding="24,10" BorderThickness="0,1,0,0" Visibility="Collapsed"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="10">
                <Grid x:Name="ChangeActions" ColumnDefinitions="*,Auto" ColumnSpacing="16" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <TextBlock x:Name="RemovalText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="DownloadText" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        <CheckBox x:Name="StubLockProtectionCheck"
                                  Content="{helpers:Loc Key=Cutscene_StubLockOption}"
                                  IsChecked="True"
                                  MinWidth="0"
                                  VerticalAlignment="Center"
                                  ToolTipService.ToolTip="{helpers:Loc Key=Cutscene_StubLockOptionHint}" />
                    </StackPanel>
                    <Button x:Name="ApplyButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnApplyClick"
                            Content="{helpers:Loc Key=Cutscene_Apply}" IsEnabled="False" />
                </Grid>
                <Grid x:Name="OperationProgress" ColumnDefinitions="*,Auto" ColumnSpacing="16" Visibility="Collapsed">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <ProgressBar x:Name="WorkProgress" IsIndeterminate="True" />
                        <TextBlock x:Name="WorkStatus" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="CancelButton" Grid.Column="1"
                            Content="{helpers:Loc Key=CancelBtn}" Click="OnCancelClick" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
