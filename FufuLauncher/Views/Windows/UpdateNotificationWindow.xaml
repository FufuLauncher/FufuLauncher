<windowex:WindowEx
    x:Class="FufuLauncher.Views.UpdateNotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:windowex="using:WinUIEx"
    xmlns:helpers="using:FufuLauncher.Helpers"
    Title="{helpers:Loc Key=UpdateNotification_Title}"
    Width="510"
    Height="480"
    MinWidth="510"
    MinHeight="360"
    IsMaximizable="False"
    IsMinimizable="False"
    IsResizable="True">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="AnnouncementTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Width="16" Height="16" Margin="12,0,0,0"
                   Source="/Assets/WindowIcon.ico" VerticalAlignment="Center" />

            <TextBlock x:Name="TitleBarText" Grid.Column="1" Text="{helpers:Loc Key=UpdateNotification_Title}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       Opacity="0.8" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="PreviewBanner" Grid.Row="0"
                    Visibility="Collapsed"
                    Background="#FFD700"
                    CornerRadius="4"
                    Margin="12,10,12,0"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#1A1A1A" VerticalAlignment="Center" />
                    <TextBlock Text="{helpers:Loc Key=UpdateNotification_PreviewBanner}"
                               FontSize="12"
                               Foreground="#1A1A1A"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="AnnouncementScrollViewer"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AnnouncementContent" Margin="28,18,28,20"
                                SizeChanged="OnAnnouncementContentSizeChanged" />
                </ScrollViewer>

                <StackPanel x:Name="StatusPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="430"
                            Margin="24"
                            Spacing="16">
                    <ProgressRing x:Name="LoadingRing" IsActive="True" Width="32" Height="32"
                                  HorizontalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Text="{helpers:Loc Key=GameAnnouncement_Loading}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button x:Name="RetryButton"
                            Content="{helpers:Loc Key=GameAnnouncement_Retry}"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            Click="OnRetryBtnClicked" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="UpdateFooter" Grid.Row="2"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Padding="16,12">
            <Button Content="{helpers:Loc Key=UpdateNotification_UpdateNow}"
                    HorizontalAlignment="Right"
                    Width="120"
                    Click="OnUpdateBtnClicked" />
        </Grid>

    </Grid>
</windowex:WindowEx>