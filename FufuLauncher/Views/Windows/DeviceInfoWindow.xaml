<Window
    x:Class="FufuLauncher.Views.DeviceInfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FufuLauncher.Models"
    xmlns:helpers="using:FufuLauncher.Helpers"
    mc:Ignorable="d"
    Title="{helpers:Loc Key=DeviceInfo_Title}">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <Style x:Key="DeviceFieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Opacity" Value="0.75" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>
            <Style x:Key="DeviceSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>
            <Style x:Key="DeviceSectionCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>
            <Style x:Key="DeviceCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14,16,16" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="12">
                <Image Source="/Assets/WindowIcon.ico" Width="16" Height="16" />
                <TextBlock Text="{helpers:Loc Key=DeviceInfo_Title}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20,10,20,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{helpers:Loc Key=DeviceInfo_Device}" Style="{StaticResource DeviceFieldLabelStyle}" />
                <TextBlock x:Name="ScopeText" Style="{StaticResource DeviceFieldLabelStyle}" FontWeight="SemiBold" />
            </StackPanel>

            <TextBlock x:Name="HeaderHintText" Grid.Column="1"
                       Style="{StaticResource DeviceSectionCaptionStyle}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="16,0,0,0" />
        </Grid>

        <ScrollViewer Grid.Row="2" Margin="20,12,20,12" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <Border Style="{StaticResource DeviceCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{helpers:Loc Key=DeviceInfo_FingerprintSection}"
                                           Style="{StaticResource DeviceSectionTitleStyle}" />
                                <TextBlock Text="{helpers:Loc Key=DeviceInfo_FingerprintCaption}"
                                           Style="{StaticResource DeviceSectionCaptionStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Click="OnRandomizeClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8EF;" FontSize="14" />
                                    <TextBlock Text="{helpers:Loc Key=DeviceInfo_Randomize}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="device_id" Style="{StaticResource DeviceFieldLabelStyle}" />
                            <TextBox x:Name="DeviceIdBox" Grid.Column="1" FontFamily="Consolas" />

                            <TextBlock Grid.Row="1" Text="bbs_device_id" Style="{StaticResource DeviceFieldLabelStyle}" />
                            <TextBox x:Name="BbsDeviceIdBox" Grid.Row="1" Grid.Column="1" FontFamily="Consolas"
                                     IsReadOnly="True" />

                            <TextBlock Grid.Row="2" Text="device_fp" Style="{StaticResource DeviceFieldLabelStyle}" />
                            <TextBox x:Name="DeviceFpBox" Grid.Row="2" Grid.Column="1" FontFamily="Consolas" />

                            <TextBlock Grid.Row="3" Text="seed_id" Style="{StaticResource DeviceFieldLabelStyle}" />
                            <TextBox x:Name="SeedIdBox" Grid.Row="3" Grid.Column="1" FontFamily="Consolas" />

                            <TextBlock Grid.Row="4" Text="seed_time" Style="{StaticResource DeviceFieldLabelStyle}" />
                            <TextBox x:Name="SeedTimeBox" Grid.Row="4" Grid.Column="1" FontFamily="Consolas" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DeviceCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{helpers:Loc Key=DeviceInfo_ExtSection}"
                                           Style="{StaticResource DeviceSectionTitleStyle}" />
                                <TextBlock Text="{helpers:Loc Key=DeviceInfo_ExtCaption}"
                                           Style="{StaticResource DeviceSectionCaptionStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="ExtCountText" Grid.Column="1"
                                       Style="{StaticResource DeviceFieldLabelStyle}" VerticalAlignment="Center" />
                            <TextBox x:Name="ExtFilterBox" Grid.Column="2" Width="200"
                                     PlaceholderText="{helpers:Loc Key=DeviceInfo_FilterPlaceholder}"
                                     TextChanged="OnFilterTextChanged" />
                        </Grid>

                        <ItemsControl x:Name="ExtFieldsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DeviceExtFieldItem">
                                    <Grid Margin="0,2" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Key}"
                                                   Style="{StaticResource DeviceFieldLabelStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Key}" />
                                        <TextBox Grid.Column="1" FontFamily="Consolas"
                                                 Text="{Binding Value, Mode=TwoWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="20,12" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource DeviceSectionCaptionStyle}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="ReloadButton" Content="{helpers:Loc Key=DeviceInfo_Reload}" Click="OnReloadClick" />
                    <Button x:Name="RestoreButton" Content="{helpers:Loc Key=DeviceInfo_RestoreDefaults}"
                            Click="OnRestoreDefaultsClick" />
                    <Button x:Name="ResetButton" Click="OnResetToDefaultsClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="{helpers:Loc Key=DeviceInfo_ResetToDefaults}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" Content="{helpers:Loc Key=DeviceInfo_Save}"
                            Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>