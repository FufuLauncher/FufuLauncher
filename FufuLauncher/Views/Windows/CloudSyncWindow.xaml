                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon Style="{StaticResource SectionTitleIconStyle}" Glyph="&#xE457;" />
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{helpers:Loc Key=HutaoSync_StatsTitle}"
                                                       Style="{StaticResource SectionHeadingStyle}" />
                                            <TextBlock Text="{helpers:Loc Key=HutaoSync_StatsDesc}"
                                                       Style="{StaticResource RowCaptionStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="HutaoStatsRefreshButton"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Click="OnHutaoStatsRefreshClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Style="{StaticResource ButtonIconStyle}" Glyph="&#xF13D;" />
                                            <TextBlock Text="{helpers:Loc Key=HutaoSync_StatsRefreshBtn}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="HutaoStatsRoleFilterCombo"
                                              Grid.Column="0"
                                              HorizontalAlignment="Stretch"
                                              Header="{helpers:Loc Key=HutaoSync_GameRoleHeader}"
                                              SelectionChanged="OnHutaoStatsRoleChanged" />
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            ToolTipService.ToolTip="{helpers:Loc Key=HutaoSync_RefreshRolesTooltip}"
                                            Click="OnHutaoRefreshAccountRolesClick">
                                        <FontIcon FontFamily="{StaticResource FluentIconsFont}" Glyph="&#xF13D;" FontSize="15" />
                                    </Button>
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="HutaoStatsPeriodCombo"
                                              Grid.Column="0"
                                              HorizontalAlignment="Stretch"
                                              Header="{helpers:Loc Key=HutaoSync_StatsPeriodHeader}"
                                              SelectionChanged="OnHutaoStatsPeriodChanged" />
                                    <ComboBox x:Name="HutaoStatsCategoryCombo"
                                              Grid.Column="1"
                                              HorizontalAlignment="Stretch"
                                              Header="{helpers:Loc Key=HutaoSync_StatsCategoryHeader}"
                                              SelectionChanged="OnHutaoStatsCategoryChanged" />
                                    <ComboBox x:Name="HutaoStatsFloorCombo"
                                              Grid.Column="2"
                                              HorizontalAlignment="Stretch"
                                              Header="{helpers:Loc Key=HutaoSync_StatsFloorHeader}"
                                              SelectionChanged="OnHutaoStatsFloorChanged" />
                                </Grid>

                                <Rectangle Style="{StaticResource HairlineDividerStyle}" />

                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Style="{StaticResource SectionTitleIconStyle}" Glyph="&#xF344;" />
                                        <TextBlock Text="{helpers:Loc Key=HutaoSync_StatsOverviewTitle}"
                                                   Style="{StaticResource SectionHeadingStyle}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="20" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="184" />
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Style="{StaticResource RowLabelIconStyle}" Glyph="&#xF21D;" />
                                            <TextBlock Text="{helpers:Loc Key=HutaoSync_StatsOverviewSchedule}"
                                                       Style="{StaticResource RowLabelStyle}" />
                                        </StackPanel>
                                        <TextBlock x:Name="HutaoStatsOverviewScheduleText"
                                                   Grid.Row="0" Grid.Column="1"
                                                   Style="{StaticResource RowTitleStyle}" />
                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Style="{StaticResource RowLabelIconStyle}" Glyph="&#xE45D;" />
                                            <TextBlock Text="{helpers:Loc Key=HutaoSync_StatsOverviewRecords}"
                                                       Style="{StaticResource RowLabelStyle}" />
                                        </StackPanel>
                                        <TextBlock x:Name="HutaoStatsOverviewRecordsText"
                                                   Grid.Row="1" Grid.Column="1"
                                                   Style="{StaticResource RowCaptionStyle}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Style="{StaticResource RowLabelIconStyle}" Glyph="&#xF70F;" />
                                            <TextBlock Text="{helpers:Loc Key=HutaoSync_StatsOverviewAbyssFullStar}"
                                                       Style="{StaticResource RowLabelStyle}" />
                                        </StackPanel>
                                        <TextBlock x:Name="HutaoStatsOverviewFullStarText"
                                                   Grid.Row="2" Grid.Column="1"
                                                   Style="{StaticResource RowCaptionStyle}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Style="{StaticResource RowLabelIconStyle}" Glyph="&#xEA27;" />
                                            <TextBlock Text="{helpers:Loc Key=HutaoSync_StatsOverviewAvgStar}"
                                                       Style="{StaticResource RowLabelStyle}" />
                                        </StackPanel>
                                        <TextBlock x:Name="HutaoStatsOverviewAvgText"
                                                   Grid.Row="3" Grid.Column="1"
                                                   Style="{StaticResource RowCaptionStyle}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Style="{StaticResource RowLabelIconStyle}" Glyph="&#xF836;" />
                                            <TextBlock Text="{helpers:Loc Key=HutaoSync_StatsOverviewTheater}"
                                                       Style="{StaticResource RowLabelStyle}" />
                                        </StackPanel>
                                        <TextBlock x:Name="HutaoStatsOverviewTheaterText"
                                                   Grid.Row="4" Grid.Column="1"
                                                   Style="{StaticResource RowCaptionStyle}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Style="{StaticResource RowLabelIconStyle}" Glyph="&#xF47E;" />
                                            <TextBlock Text="{helpers:Loc Key=HutaoSync_StatsOverviewUpdated}"
                                                       Style="{StaticResource RowLabelStyle}" />
                                        </StackPanel>
                                        <TextBlock x:Name="HutaoStatsOverviewUpdatedText"
                                                   Grid.Row="5" Grid.Column="1"
                                                   Style="{StaticResource RowCaptionStyle}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>

                                <Rectangle Style="{StaticResource HairlineDividerStyle}" />

                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Style="{StaticResource SectionTitleIconStyle}" Glyph="&#xEA27;" />
                                        <TextBlock Text="{helpers:Loc Key=HutaoSync_StatsUidRankTitle}"
                                                   Style="{StaticResource SectionHeadingStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="HutaoStatsUidRankEmptyText"
                                               Text="{helpers:Loc Key=HutaoSync_StatsUidRankEmptyHint}"
                                               Style="{StaticResource RowCaptionStyle}" />
                                    <ItemsRepeater x:Name="HutaoStatsUidRanksRepeater" Visibility="Collapsed">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="10" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:HutaoUidRankDisplayItem">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <FontIcon FontFamily="{StaticResource FluentIconsFont}"
                                                                  Glyph="&#xF5BD;"
                                                                  FontSize="15"
                                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind RoleTitle}"
                                                                   Style="{StaticResource RowTitleStyle}" />
                                                    </StackPanel>
                                                    <Grid ColumnSpacing="20" RowSpacing="8"
                                                          Visibility="{x:Bind RankGridVisibility}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="184" />
                                                            <ColumnDefinition Width="*" MinWidth="0" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                                   Text="{x:Bind DamageLabel}"
                                                                   Style="{StaticResource RowLabelStyle}" />
                                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                                   Text="{x:Bind DamageText}"
                                                                   Style="{StaticResource RowCaptionStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                                   Text="{x:Bind TakeDamageLabel}"
                                                                   Style="{StaticResource RowLabelStyle}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                                   Text="{x:Bind TakeDamageText}"
                                                                   Style="{StaticResource RowCaptionStyle}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind NoRecordHintText}"
                                                               Style="{StaticResource RowCaptionStyle}"
                                                               Visibility="{x:Bind NoRecordVisibility}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                                <Rectangle Style="{StaticResource HairlineDividerStyle}" />

                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="HutaoStatsEmptyText"
                                               Text="{helpers:Loc Key=HutaoSync_StatsEmptyHint}"
                                               Style="{StaticResource RowCaptionStyle}"
                                               Margin="0,4,0,4" />
                                    <ItemsRepeater x:Name="HutaoStatsRowsRepeater">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:HutaoRankDisplayItem">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid ColumnSpacing="12" Padding="4,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="*" MinWidth="0" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{x:Bind RankNumberText}"
                                                                   VerticalAlignment="Center"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{x:Bind PrimaryText}"
                                                                   VerticalAlignment="Center"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   helpers:TrimmedToolTip.IsEnabled="True" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{x:Bind SecondaryText}"
                                                                   VerticalAlignment="Center"
                                                                   Style="{StaticResource RowCaptionStyle}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   helpers:TrimmedToolTip.IsEnabled="True" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{x:Bind MetricText}"
                                                                   VerticalAlignment="Center"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    </Grid>
                                                    <Rectangle Grid.Row="1"
                                                               Style="{StaticResource HairlineDividerStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="HutaoSubSponsorPanel" Spacing="16" Visibility="Collapsed">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Style="{StaticResource SectionTitleIconStyle}" Glyph="&#xE30A;" />
                                            <TextBlock Text="{helpers:Loc Key=HutaoSync_SponsorStatusTitle}"
                                                       Style="{StaticResource SectionHeadingStyle}" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="20" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Style="{StaticResource RowLabelIconStyle}" Glyph="&#xF506;" />
                                                <TextBlock Text="{helpers:Loc Key=HutaoSync_LabelAccount}"
                                                           Style="{StaticResource RowLabelStyle}" />
                                            </StackPanel>
                                            <TextBlock x:Name="HutaoSponsorAccountText"
                                                       Grid.Row="0" Grid.Column="1"
                                                       Style="{StaticResource RowTitleStyle}" />
                                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Style="{StaticResource RowLabelIconStyle}" Glyph="&#xE387;" />
                                                <TextBlock Text="{helpers:Loc Key=HutaoSync_LabelGachaPlan}"
                                                           Style="{StaticResource RowLabelStyle}" />
                                            </StackPanel>
                                            <TextBlock x:Name="HutaoSponsorGachaText"
                                                       Grid.Row="1" Grid.Column="1"
                                                       Style="{StaticResource RowCaptionStyle}"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Style="{StaticResource RowLabelIconStyle}" Glyph="&#xE618;" />
                                                <TextBlock Text="{helpers:Loc Key=HutaoSync_LabelAccelPlan}"
                                                           Style="{StaticResource RowLabelStyle}" />
                                            </StackPanel>
                                            <TextBlock x:Name="HutaoSponsorCdnText"
                                                       Grid.Row="2" Grid.Column="1"
                                                       Style="{StaticResource RowCaptionStyle}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                    <Button x:Name="HutaoSponsorActionBtn"
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Content="{helpers:Loc Key=HutaoSync_RefreshAccountBtn}"
                                            Click="OnHutaoSponsorPrimaryActionClick" />
                                </Grid>

                                <Rectangle Style="{StaticResource HairlineDividerStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon Style="{StaticResource SectionTitleIconStyle}" Glyph="&#xF479;" />
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{helpers:Loc Key=HutaoSync_SponsorEntryTitle}"
                                                       Style="{StaticResource SectionHeadingStyle}" />
                                            <TextBlock Text="{helpers:Loc Key=HutaoSync_SponsorEntryDesc}"
                                                       Style="{StaticResource RowCaptionStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="OnHutaoOpenSponsorPageClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Style="{StaticResource ButtonIconStyle}" Glyph="&#xF582;" />
                                            <TextBlock Text="{helpers:Loc Key=HutaoSync_OpenSponsorPageBtn}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <InfoBar Title="{helpers:Loc Key=HutaoSync_SponsorFreeTipTitle}"
                                         Message="{helpers:Loc Key=HutaoSync_SponsorFreeTipDesc}"
                                         Severity="Informational"
                                         IsOpen="True"
                                         IsClosable="False" />

                                <Rectangle Style="{StaticResource HairlineDividerStyle}" />

                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Style="{StaticResource SectionTitleIconStyle}" Glyph="&#xF455;" />
                                        <TextBlock Text="{helpers:Loc Key=HutaoSync_RedeemTitle}"
                                                   Style="{StaticResource SectionHeadingStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="{helpers:Loc Key=HutaoSync_RedeemDesc}"
                                               Style="{StaticResource RowCaptionStyle}" />
                                    <TextBlock x:Name="HutaoSponsorSignInHintText"
                                               Text="{helpers:Loc Key=HutaoSync_SponsorSignInHint}"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               Style="{StaticResource RowCaptionStyle}"
                                               Visibility="Collapsed" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="HutaoRedeemCodeBox"
                                                 Grid.Column="0"
                                                 PlaceholderText="{helpers:Loc Key=HutaoSync_RedeemPlaceholder}"
                                                 MaxLength="64" />
                                        <Button x:Name="HutaoRedeemButton"
                                                Grid.Column="1"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="OnHutaoRedeemCodeClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Style="{StaticResource ButtonIconStyle}" Glyph="&#xED7C;" />
                                                <TextBlock Text="{helpers:Loc Key=HutaoSync_RedeemBtn}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Global Feedback InfoBar -->
        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="3"
                 IsOpen="False"
                 IsClosable="True"
                 HorizontalAlignment="Stretch"
                 Margin="32,0,32,8" />

        <!-- Footer Contact Tip -->
        <TextBlock Grid.Row="4"
                   Text="{helpers:Loc Key=CloudSync_ContactTip}"
                   FontSize="11"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   IsTextSelectionEnabled="True"
                   Margin="32,0,32,12" />
    </Grid>
</Window>