<Window
    x:Class="FufuLauncher.Views.CloudSyncWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:FufuLauncher.Helpers"
    xmlns:models="using:FufuLauncher.Models"
    mc:Ignorable="d"
    Title="{helpers:Loc Key=CloudSync_WindowTitle}">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>
            <Style x:Key="RowTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>
            <Style x:Key="RowLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>
            <Style x:Key="RowCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>
            <Style x:Key="HairlineDividerStyle" TargetType="Rectangle">
                <Setter Property="Height" Value="1" />
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="VerticalDividerStyle" TargetType="Rectangle">
                <Setter Property="Width" Value="1" />
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="FlatRowActionButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <FontIcon Glyph="&#xE753;" FontSize="14" />
                <TextBlock Text="{helpers:Loc Key=CloudSync_WindowTitle}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Top Navigation + Busy Bar -->
        <Grid Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,0">
            <NavigationView x:Name="MainNavView"
                            PaneDisplayMode="Top"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            SelectionChanged="OnNavSelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="{helpers:Loc Key=CloudSync_NavAccount}" Tag="Account" IsSelected="True">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE77B;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="{helpers:Loc Key=CloudSync_NavQuota}" Tag="Quota">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE9D2;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="{helpers:Loc Key=CloudSync_NavArchives}" Tag="Archives">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE753;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
            </NavigationView>

            <ProgressBar x:Name="GlobalProgressBar"
                         VerticalAlignment="Bottom"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
        </Grid>

        <!-- Content Area (No MaxWidth on ScrollViewer child so viewport width maps 1:1 without horizontal offset/clipping) -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Top">
            <Grid Padding="32,24,32,20" HorizontalAlignment="Stretch">

                <!-- 1. Account & Security -->
                <Grid x:Name="AccountTabPanel" VerticalAlignment="Top">

                    <!-- Signed-out View -->
                    <Grid x:Name="UnauthPanel" RowSpacing="20" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="3">
                            <TextBlock Text="{helpers:Loc Key=CloudSync_AuthTitle}"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{helpers:Loc Key=CloudSync_AuthSubtitle}"
                                       Style="{StaticResource RowCaptionStyle}" />
                        </StackPanel>

                        <Rectangle Grid.Row="1" Style="{StaticResource HairlineDividerStyle}" />

                        <StackPanel Grid.Row="2" Spacing="16" Width="460" HorizontalAlignment="Left">
                            <RadioButtons x:Name="AuthModeSelector"
                                          MaxColumns="3"
                                          SelectionChanged="OnAuthModeChanged" />

                            <TextBox x:Name="EmailTextBox"
                                     Header="{helpers:Loc Key=CloudSync_EmailHeader}"
                                     PlaceholderText="{helpers:Loc Key=CloudSync_EmailPlaceholder}"
                                     InputScope="EmailSmtpAddress" />

                            <PasswordBox x:Name="PasswordBox"
                                         Header="{helpers:Loc Key=CloudSync_PasswordHeader}"
                                         PlaceholderText="{helpers:Loc Key=CloudSync_PasswordPlaceholder}" />

                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         Header="{helpers:Loc Key=CloudSync_ConfirmPasswordHeader}"
                                         PlaceholderText="{helpers:Loc Key=CloudSync_ConfirmPasswordPlaceholder}"
                                         Visibility="Collapsed" />

                            <Grid x:Name="OtpInputRow" ColumnSpacing="10" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OtpTextBox"
                                         Header="{helpers:Loc Key=CloudSync_OtpHeader}"
                                         PlaceholderText="{helpers:Loc Key=CloudSync_OtpPlaceholder}"
                                         MaxLength="16" />
                                <Button x:Name="SendAuthOtpButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        Content="{helpers:Loc Key=CloudSync_SendOtpBtn}"
                                        Click="OnSendAuthOtpClick" />
                            </Grid>

                            <Button x:Name="AuthSubmitButton"
                                    HorizontalAlignment="Left"
                                    MinWidth="180"
                                    Margin="0,4,0,0"
                                    Padding="24,8"
                                    Content="{helpers:Loc Key=CloudSync_SubmitLogin}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnAuthSubmitClick" />
                        </StackPanel>
                    </Grid>

                    <!-- Signed-in View -->
                    <Grid x:Name="LoggedInAccountPanel" RowSpacing="20" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="{helpers:Loc Key=CloudSync_AccountSectionTitle}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{helpers:Loc Key=CloudSync_AccountSectionSubtitle}"
                                           Style="{StaticResource RowCaptionStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="{helpers:Loc Key=CloudSync_RefreshStatusBtn}"
                                    Click="OnRefreshAccountStatusClick" />
                        </Grid>

                        <Rectangle Grid.Row="1" Style="{StaticResource HairlineDividerStyle}" />

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" MinWidth="0" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1.15*" MinWidth="0" />
                            </Grid.ColumnDefinitions>

                            <!-- Account Info Flat List -->
                            <StackPanel Grid.Column="0">
                                <Grid ColumnSpacing="20" Padding="0,4,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{helpers:Loc Key=CloudSync_LabelEmail}" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="AccountEmailValueText" Grid.Column="1" Text="-" IsTextSelectionEnabled="True" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>

                                <Rectangle Style="{StaticResource HairlineDividerStyle}" />

                                <Grid ColumnSpacing="20" Padding="0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{helpers:Loc Key=CloudSync_LabelStatus}" Style="{StaticResource RowLabelStyle}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse x:Name="AccountStatusIndicator"
                                                 Width="8"
                                                 Height="8"
                                                 VerticalAlignment="Center"
                                                 Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                        <TextBlock x:Name="AccountLockStatusText" Text="-" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <Rectangle Style="{StaticResource HairlineDividerStyle}" />

                                <Grid ColumnSpacing="20" Padding="0,14,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{helpers:Loc Key=CloudSync_LabelLockedAt}" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="AccountLockedAtText" Grid.Column="1" Text="-" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Style="{StaticResource VerticalDividerStyle}" Margin="32,4" />

                            <!-- Security & Session Flat Action Rows -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{helpers:Loc Key=CloudSync_SecurityActionsTitle}"
                                           Style="{StaticResource SectionHeadingStyle}"
                                           Margin="0,0,0,12" />

                                <Grid ColumnSpacing="20" Padding="0,4,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock x:Name="AccountLockActionTitleText"
                                                   Text="{helpers:Loc Key=CloudSync_LockTitle}"
                                                   Style="{StaticResource RowTitleStyle}" />
                                        <TextBlock x:Name="AccountLockActionDescText"
                                                   Text="{helpers:Loc Key=CloudSync_LockDesc}"
                                                   Style="{StaticResource RowCaptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button x:Name="LockAccountButton"
                                                Content="{helpers:Loc Key=CloudSync_LockAccountBtn}"
                                                Click="OnLockAccountClick" />
                                        <Button x:Name="UnlockAccountButton"
                                                Content="{helpers:Loc Key=CloudSync_UnlockAccountBtn}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="OnUnlockAccountClick" />
                                    </StackPanel>
                                </Grid>

                                <Rectangle Style="{StaticResource HairlineDividerStyle}" />

                                <Grid ColumnSpacing="20" Padding="0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{helpers:Loc Key=CloudSync_LabelAutoLogin}"
                                                   Style="{StaticResource RowTitleStyle}" />
                                        <TextBlock Text="{helpers:Loc Key=CloudSync_AutoLoginDesc}"
                                                   Style="{StaticResource RowCaptionStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Content="{helpers:Loc Key=CloudSync_LogoutBtn}"
                                            Click="OnLogoutClick" />
                                </Grid>

                                <Rectangle Style="{StaticResource HairlineDividerStyle}" />

                                <Grid ColumnSpacing="20" Padding="0,14,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{helpers:Loc Key=CloudSync_DeleteAccountTitle}"
                                                   Style="{StaticResource RowTitleStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <TextBlock Text="{helpers:Loc Key=CloudSync_DeleteAccountWarning}"
                                                   Style="{StaticResource RowCaptionStyle}" />
                                    </StackPanel>
                                    <Button x:Name="DeleteAccountButton"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Content="{helpers:Loc Key=CloudSync_DeleteAccountBtn}"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Click="OnDeleteAccountClick" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 2. Quotas & Upgrades -->
                <Grid x:Name="QuotaTabPanel" RowSpacing="20" Visibility="Collapsed" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{helpers:Loc Key=CloudSync_QuotaTitle}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="QuotaResetInfoText"
                                       Text="{helpers:Loc Key=CloudSync_QuotaDefaultSubtitle}"
                                       Style="{StaticResource RowCaptionStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{helpers:Loc Key=CloudSync_QuotaRefreshBtn}" Click="OnRefreshQuotaClick" VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Grid.Row="1" Style="{StaticResource HairlineDividerStyle}" />

                    <Grid Grid.Row="2">
                        <TextBlock x:Name="QuotaNotReadyHintText"
                                   Text="{helpers:Loc Key=CloudSync_QuotaNotReadySignIn}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,32,0,0"
                                   Visibility="Collapsed" />

                        <Grid x:Name="QuotaDetailsPanel" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" MinWidth="0" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="0" />
                            </Grid.ColumnDefinitions>

                            <!-- Quota Usage Meters (Flat Hairline-Separated Rows) -->
                            <StackPanel Grid.Column="0">
                                <!-- Cloud Storage -->
                                <StackPanel Spacing="8" Padding="0,2,0,14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{helpers:Loc Key=CloudSync_QuotaStorageLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="QuotaStorageValueText" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="-" />
                                    </Grid>
                                    <ProgressBar x:Name="QuotaStorageBar" Minimum="0" Maximum="100" Value="0" />
                                </StackPanel>

                                <Rectangle Style="{StaticResource HairlineDividerStyle}" />

                                <!-- Archive Files -->
                                <StackPanel Spacing="8" Padding="0,14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{helpers:Loc Key=CloudSync_QuotaFilesLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="QuotaFilesValueText" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="-" />
                                    </Grid>
                                    <ProgressBar x:Name="QuotaFilesBar" Minimum="0" Maximum="100" Value="0" />
                                </StackPanel>

                                <Rectangle Style="{StaticResource HairlineDividerStyle}" />

                                <!-- Daily Ops -->
                                <StackPanel Spacing="8" Padding="0,14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{helpers:Loc Key=CloudSync_QuotaOpsLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="QuotaOpsValueText" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="-" />
                                    </Grid>
                                    <ProgressBar x:Name="QuotaOpsBar" Minimum="0" Maximum="100" Value="0" />
                                </StackPanel>

                                <Rectangle Style="{StaticResource HairlineDividerStyle}" />

                                <!-- Daily Uploads -->
                                <StackPanel Spacing="8" Padding="0,14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{helpers:Loc Key=CloudSync_QuotaUploadsLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="QuotaUploadsValueText" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="-" />
                                    </Grid>
                                    <ProgressBar x:Name="QuotaUploadsBar" Minimum="0" Maximum="100" Value="0" />
                                </StackPanel>

                                <Rectangle Style="{StaticResource HairlineDividerStyle}" />

                                <!-- Daily Deletes -->
                                <StackPanel Spacing="8" Padding="0,14,0,2">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{helpers:Loc Key=CloudSync_QuotaDeletesLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="QuotaDeletesValueText" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="-" />
                                    </Grid>
                                    <ProgressBar x:Name="QuotaDeletesBar" Minimum="0" Maximum="100" Value="0" />
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Style="{StaticResource VerticalDividerStyle}" Margin="32,4" />

                            <!-- Activation Code Redemption (Flat Section) -->
                            <StackPanel Grid.Column="2" Spacing="14" Padding="0,2,0,0">
                                <TextBlock Text="{helpers:Loc Key=CloudSync_UpgradeTitle}" Style="{StaticResource SectionHeadingStyle}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE946;"
                                              FontSize="13"
                                              Margin="0,2,0,0"
                                              VerticalAlignment="Top"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{helpers:Loc Key=CloudSync_UpgradeDisclaimer}"
                                               Style="{StaticResource RowCaptionStyle}" />
                                </Grid>

                                <Rectangle Style="{StaticResource HairlineDividerStyle}" />

                                <TextBlock x:Name="UpgradeStatusText"
                                           Text="{helpers:Loc Key=CloudSync_UpgradeInactive}"
                                           Style="{StaticResource RowCaptionStyle}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ActivationCodeTextBox"
                                             PlaceholderText="{helpers:Loc Key=CloudSync_ActivationPlaceholder}" />
                                    <Button Grid.Column="1"
                                            Content="{helpers:Loc Key=CloudSync_ActivateBtn}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="OnActivateCodeClick" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 3. Cloud Archives -->
                <Grid x:Name="ArchivesTabPanel" RowSpacing="16" Visibility="Collapsed" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{helpers:Loc Key=CloudSync_ArchivesTitle}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="ArchivesSummaryText"
                                       Text="{helpers:Loc Key=CloudSync_ArchivesSubtitle}"
                                       Style="{StaticResource RowCaptionStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox x:Name="ArchiveFilterComboBox"
                                      SelectedIndex="0"
                                      Width="140"
                                      SelectionChanged="OnArchiveFilterChanged">
                                <ComboBoxItem Content="{helpers:Loc Key=CloudSync_FilterAll}" Tag="all" />
                                <ComboBoxItem Content="{helpers:Loc Key=CloudSync_FilterUiaf}" Tag="uiaf" />
                                <ComboBoxItem Content="{helpers:Loc Key=CloudSync_FilterUigf}" Tag="uigf" />
                                <ComboBoxItem Content="{helpers:Loc Key=CloudSync_FilterPlayTime}" Tag="playtime" />
                            </ComboBox>
                            <Button Content="{helpers:Loc Key=CloudSync_RefreshBtn}" Click="OnRefreshArchivesClick" />
                            <Button Content="{helpers:Loc Key=CloudSync_UploadLocalBtn}" Style="{StaticResource AccentButtonStyle}" Click="OnUploadLocalJsonClick" />
                            <Button Content="{helpers:Loc Key=CloudSync_DeleteAllBtn}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Click="OnDeleteAllDataClick" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Grid.Row="1" Style="{StaticResource HairlineDividerStyle}" />

                    <Grid Grid.Row="2">
                        <TextBlock x:Name="ArchivesEmptyText"
                                   Text="{helpers:Loc Key=CloudSync_ArchivesEmpty}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,36,0,0"
                                   Visibility="Collapsed" />

                        <ItemsRepeater x:Name="ArchivesRepeater">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:CloudArchiveItem">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid ColumnSpacing="16" Padding="4,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="148" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind TypeBadge}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Slot}"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind Slot}" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind SizeSummary}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind UpdatedAtLocalText}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <Button Content="{helpers:Loc Key=CloudSync_BtnMergeToLocal}"
                                                        Tag="{x:Bind}"
                                                        Visibility="{x:Bind PlayTimeMergeVisibility}"
                                                        Click="OnMergePlayTimeArchiveToLocalClick"
                                                        Style="{StaticResource FlatRowActionButtonStyle}"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <Button Content="{helpers:Loc Key=CloudSync_BtnExportSave}"
                                                        Tag="{x:Bind}"
                                                        Click="OnSaveArchiveToDiskClick"
                                                        Style="{StaticResource FlatRowActionButtonStyle}" />
                                                <Button Content="{helpers:Loc Key=CloudSync_BtnOverwrite}"
                                                        Tag="{x:Bind}"
                                                        Click="OnOverwriteArchiveFromDiskClick"
                                                        Style="{StaticResource FlatRowActionButtonStyle}" />
                                                <Button Content="{helpers:Loc Key=CloudSync_BtnRename}"
                                                        Tag="{x:Bind}"
                                                        Click="OnRenameArchiveClick"
                                                        Style="{StaticResource FlatRowActionButtonStyle}" />
                                                <Button Content="{helpers:Loc Key=CloudSync_BtnDelete}"
                                                        Tag="{x:Bind}"
                                                        Click="OnDeleteSingleArchiveClick"
                                                        Style="{StaticResource FlatRowActionButtonStyle}"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <Rectangle Grid.Row="1" Style="{StaticResource HairlineDividerStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Grid>
                </Grid>

            </Grid>
        </ScrollViewer>

        <!-- Global Feedback InfoBar -->
        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="3"
                 IsOpen="False"
                 IsClosable="True"
                 HorizontalAlignment="Stretch"
                 Margin="32,0,32,8" />

        <!-- Footer Contact Tip -->
        <TextBlock Grid.Row="4"
                   Text="{helpers:Loc Key=CloudSync_ContactTip}"
                   FontSize="11"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   IsTextSelectionEnabled="True"
                   Margin="32,0,32,12" />
    </Grid>
</Window>
