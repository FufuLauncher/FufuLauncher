<Window
    x:Class="FufuLauncher.Views.McpAuditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:FufuLauncher.Helpers"
    xmlns:models="using:FufuLauncher.Models"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="20,14" />
            </Style>
            <Style x:Key="RowTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>
            <Style x:Key="RowCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.65" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>
            <Style x:Key="RowDividerStyle" TargetType="Rectangle">
                <Setter Property="Height" Value="1" />
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="Margin" Value="0,12" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE81C;"
                      FontSize="12"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      Opacity="0.7" />
            <TextBlock Grid.Column="1"
                       Text="{helpers:Loc Key=Mcp_AuditWindowTitle}"
                       Margin="8,0,140,0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.85" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Padding="32,16,32,32"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled">
            <StackPanel Spacing="16" MaxWidth="760">

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{helpers:Loc Key=Mcp_AuditToggleTitle}"
                                           Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="{helpers:Loc Key=Mcp_AuditCaption}"
                                           Style="{StaticResource RowCaptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"
                                          IsOn="{x:Bind ViewModel.AuditEnabled, Mode=TwoWay}" />
                        </Grid>

                        <Rectangle Style="{StaticResource RowDividerStyle}" />

                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{helpers:Loc Key=Mcp_AuditConnections}"
                                           Style="{StaticResource RowCaptionStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.ConnectionsText, Mode=OneWay}"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{helpers:Loc Key=Mcp_AuditCalls}"
                                           Style="{StaticResource RowCaptionStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.CallsText, Mode=OneWay}"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="{helpers:Loc Key=Mcp_AuditFailures}"
                                           Style="{StaticResource RowCaptionStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.FailuresText, Mode=OneWay}"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Style="{StaticResource RowDividerStyle}" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.ArchiveText, Mode=OneWay}"
                                           Style="{StaticResource RowCaptionStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.ArchiveHint, Mode=OneWay}"
                                           FontSize="11"
                                           Opacity="0.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Content="{helpers:Loc Key=Mcp_AuditOpenFolder}"
                                        Click="OnOpenArchiveFolderClick" />
                                <Button Content="{helpers:Loc Key=Mcp_AuditClear}"
                                        Click="OnClearClick" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:McpAuditEntryView">
                            <Expander FontFamily="{StaticResource AppGlobalFont}" HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="0,0,0,4">
                                <Expander.Header>
                                    <Grid ColumnSpacing="10" MinHeight="36" Padding="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="16" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE73E;"
                                                      FontSize="13"
                                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                      Visibility="{x:Bind SuccessVisibility}" />
                                            <FontIcon Glyph="&#xE783;"
                                                      FontSize="13"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                      Visibility="{x:Bind FailureVisibility}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Meta}"
                                                       FontSize="11"
                                                       Opacity="0.6"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind ResultText}"
                                                   FontSize="11"
                                                   Opacity="0.65"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Spacing="6" Padding="26,2,8,8">
                                    <TextBlock Text="{x:Bind DetailMeta}"
                                               FontSize="12"
                                               Opacity="0.75"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind DetailMessage}"
                                               FontSize="12"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind DetailMessageVisibility}" />
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock Text="{helpers:Loc Key=Mcp_AuditEmpty}"
                           Style="{StaticResource RowCaptionStyle}"
                           Margin="4,0,0,0"
                           Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>