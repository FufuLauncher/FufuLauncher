<winuiex:WindowEx x:Class="FufuLauncher.Views.MiyousheWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:helpers="using:FufuLauncher.Helpers" xmlns:models="using:FufuLauncher.Models.Miyoushe"
                  xmlns:winuiex="using:WinUIEx" xmlns:views="using:FufuLauncher.Views"
                  Title="{helpers:Loc Key=Miyoushe_Title}">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Loaded="OnLoaded" Background="Transparent" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="CommunityCanvasBrush" Color="#F2F3F5" />
                        <SolidColorBrush x:Key="CommunitySurfaceBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="CommunityPillBrush" Color="#EFF1F3" />
                        <SolidColorBrush x:Key="CommunityHoverBrush" Color="#E4E7EB" />
                        <SolidColorBrush x:Key="CommunitySelectedBrush" Color="#23272B" />
                        <SolidColorBrush x:Key="CommunitySelectedTextBrush" Color="#FFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="CommunityCanvasBrush" Color="#202224" />
                        <SolidColorBrush x:Key="CommunitySurfaceBrush" Color="#15171A" />
                        <SolidColorBrush x:Key="CommunityPillBrush" Color="#282B30" />
                        <SolidColorBrush x:Key="CommunityHoverBrush" Color="#373B42" />
                        <SolidColorBrush x:Key="CommunitySelectedBrush" Color="#E8ECEF" />
                        <SolidColorBrush x:Key="CommunitySelectedTextBrush" Color="#14191E" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <views:MiyousheImageConverter x:Key="CommunityImageConverter" />
                <Style x:Key="CapsuleTabStyle" TargetType="RadioButton">
                    <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Padding" Value="14,7" />
                    <Setter Property="CornerRadius" Value="18" />
                    <Setter Property="Background" Value="{ThemeResource CommunityPillBrush}" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Grid x:Name="PillRoot" Background="Transparent">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="HoverLayer.Opacity" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="PillRoot.Opacity" Value="0.72" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="PillRoot.Opacity" Value="0.4" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                        <VisualStateGroup x:Name="CheckStates">
                                            <VisualState x:Name="Unchecked" />
                                            <VisualState x:Name="Checked">
                                                <VisualState.Setters>
                                                    <Setter Target="SelectedLayer.Opacity" Value="1" />
                                                    <Setter Target="PillContent.Foreground"
                                                            Value="{ThemeResource CommunitySelectedTextBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="{TemplateBinding CornerRadius}" />
                                    <Border x:Name="HoverLayer" Background="{ThemeResource CommunityHoverBrush}"
                                            CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                    <Border x:Name="SelectedLayer" Background="{ThemeResource CommunitySelectedBrush}"
                                            CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                    <ContentPresenter x:Name="PillContent" Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Padding="{TemplateBinding Padding}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="CommunityNavStyle" TargetType="RadioButton" BasedOn="{StaticResource CapsuleTabStyle}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Padding" Value="12,12" />
                    <Setter Property="CornerRadius" Value="10" />
                </Style>
                <Style x:Key="CommunityActionStyle" TargetType="Button">
                    <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                    <Setter Property="CornerRadius" Value="18" />
                    <Setter Property="Padding" Value="14,7" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Background" Value="{ThemeResource CommunityPillBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
                <Style x:Key="CommunityListItemStyle" TargetType="ListViewItem"
                       BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="CornerRadius" Value="12" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Back" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Margin="18,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="/Assets/WindowIcon.ico" Width="18" Height="18" />
                <TextBlock Text="{helpers:Loc Key=Miyoushe_Title}" FontSize="13" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="18,8,18,18" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="156" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="GameSelector" HorizontalAlignment="Stretch" CornerRadius="18"
                          SelectionChanged="OnGameChanged" />
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavigationButtons" Spacing="4">
                        <TextBlock Text="{helpers:Loc Key=Miyoushe_Explore}" Margin="12,6,0,10"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" />
                        <RadioButton x:Name="HomeNavigation" GroupName="CommunityNavigation"
                                     Style="{StaticResource CommunityNavStyle}" Tag="Forum" Click="OnNavigate">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE80F;" FontSize="15" />
                                <TextBlock Text="{helpers:Loc Key=Miyoushe_Forum}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="CommunityNavigation" Style="{StaticResource CommunityNavStyle}"
                                     Tag="News" Click="OnNavigate">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8A5;" FontSize="15" />
                                <TextBlock Text="{helpers:Loc Key=Miyoushe_News}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="CommunityNavigation" Style="{StaticResource CommunityNavStyle}"
                                     Tag="Following" Click="OnNavigate">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE716;" FontSize="15" />
                                <TextBlock Text="{helpers:Loc Key=Miyoushe_Following}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="CommunityNavigation" Style="{StaticResource CommunityNavStyle}"
                                     Tag="Favorites" Click="OnNavigate">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE734;" FontSize="15" />
                                <TextBlock Text="{helpers:Loc Key=Miyoushe_Favorites}" />
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Text="{helpers:Loc Key=Miyoushe_Library}" Margin="12,24,0,10"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" />
                        <RadioButton GroupName="CommunityNavigation" Style="{StaticResource CommunityNavStyle}"
                                     Tag="Bookmarks" Click="OnNavigate">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8A4;" FontSize="15" />
                                <TextBlock Text="{helpers:Loc Key=Miyoushe_Bookmarks}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="CommunityNavigation" Style="{StaticResource CommunityNavStyle}"
                                     Tag="History" Click="OnNavigate">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE81C;" FontSize="15" />
                                <TextBlock Text="{helpers:Loc Key=Miyoushe_History}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ProfileNavigation" GroupName="CommunityNavigation"
                                     Style="{StaticResource CommunityNavStyle}" Tag="User" Click="OnMyProfile">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE77B;" FontSize="15" />
                                <TextBlock Text="{helpers:Loc Key=Miyoushe_MyProfile}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Spacing="12">
                    <ComboBox x:Name="AccountSelector" CornerRadius="18" HorizontalAlignment="Stretch"
                              SelectionChanged="OnAccountChanged" />
                    <TextBlock Margin="12,0,8,8" Text="{helpers:Loc Key=Miyoushe_AccountHint}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="10" MinHeight="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="FeedBackButton" Style="{StaticResource CommunityActionStyle}" Click="OnFeedBack"
                            Padding="10" Visibility="Collapsed"
                            ToolTipService.ToolTip="{helpers:Loc Key=Miyoushe_Back}">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock x:Name="FeedTitle" FontSize="17" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MaxWidth="210" TextTrimming="CharacterEllipsis" />
                            <views:MiyousheWrapPanel x:Name="ForumTabs" />
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                        <views:MiyousheWrapPanel x:Name="SortTabs" VerticalAlignment="Center" />
                    </ScrollViewer>
                    <Button x:Name="RefreshButton" Grid.Column="3" Style="{StaticResource CommunityActionStyle}"
                            Click="OnRefresh" Padding="10" IsEnabled="False"
                            ToolTipService.ToolTip="{helpers:Loc Key=Miyoushe_RefreshHint}"
                            AutomationProperties.Name="{helpers:Loc Key=Miyoushe_Refresh}">
                        <Grid Width="16" Height="16">
                            <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="16" />
                            <ProgressRing x:Name="RefreshSpinner" Width="16" Height="16" MinWidth="0" MinHeight="0"
                                          IsActive="False" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <AutoSuggestBox x:Name="SearchBox" Grid.Column="4" CornerRadius="18"
                                    PlaceholderText="{helpers:Loc Key=Miyoushe_SearchHint}" QueryIcon="Find"
                                    QuerySubmitted="OnSearch" />
                </Grid>
                <InfoBar FontFamily="{StaticResource AppGlobalFont}" x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" Closed="OnStatusClosed">
                    <InfoBar.ActionButton>
                        <Button x:Name="StatusAction" Click="OnStatusAction" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <Grid x:Name="FeedPane" Grid.Row="2" MaxWidth="940">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="FeedDescription" FontSize="13" MaxHeight="110" TextWrapping="Wrap"
                               Margin="18,0,18,16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed" />
                    <ProgressBar Grid.Row="1" x:Name="FeedProgress" IsIndeterminate="True" Visibility="Collapsed"
                                 Height="3" />
                    <ListView Grid.Row="2" x:Name="PostsList" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="OnPostClicked" Padding="0,0,2,0"
                              ItemContainerStyle="{StaticResource CommunityListItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CommunityPost">
                                <Border Background="{ThemeResource CommunitySurfaceBrush}" CornerRadius="12"
                                        Padding="18,16">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <views:MiyousheAvatar Avatar="{x:Bind Avatar}"
                                                                  DisplayName="{x:Bind Author}"
                                                                  IsEnabled="{x:Bind CanOpenAuthor}" Tag="{Binding}"
                                                                  Click="OnPostAuthorAvatar" Width="22" Height="22" />
                                            <TextBlock Text="{x:Bind Author}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="650" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" MaxLines="3" />
                                        <TextBlock Text="{x:Bind Summary}" FontSize="13" TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Border CornerRadius="8"
                                                Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Image
                                                Source="{Binding Cover, Converter={StaticResource CommunityImageConverter}}"
                                                Height="260" Stretch="UniformToFill" HorizontalAlignment="Stretch"
                                                ImageFailed="OnCoverFailed" />
                                        </Border>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Published}" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <views:MiyoushePostCounters Grid.Column="1" Post="{x:Bind}"
                                                                        IsInteractive="True"
                                                                        LikeRequested="OnFeedPostLike"
                                                                        CommentRequested="OnFeedPostComment"
                                                                        FontSize="11" HorizontalAlignment="Right"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="2" x:Name="EmptyFeed" Text="{helpers:Loc Key=Miyoushe_Empty}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="20" Visibility="Collapsed" />
                    <Button Grid.Row="3" x:Name="MorePostsButton" Style="{StaticResource CommunityActionStyle}"
                            Content="{helpers:Loc Key=Miyoushe_More}" Click="OnMorePosts" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" Visibility="Collapsed" />
                </Grid>
                <Border x:Name="ReaderPane" Grid.Row="2" Background="{ThemeResource CommunitySurfaceBrush}"
                        CornerRadius="12" Visibility="Collapsed">
                    <Grid>
                        <ProgressRing x:Name="ReaderPlaceholder" IsActive="True" Width="36" Height="36"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Grid x:Name="ReaderGrid" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Padding="28,22,28,18" ColumnSpacing="20" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="PostTitle" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"
                                           MaxLines="3" IsTextSelectionEnabled="True" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Top">
                                    <ToggleButton x:Name="PostLikeButton" Click="OnPostLike" CornerRadius="18"
                                                  Padding="12,7" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <views:MiyousheIcon Kind="Like"
                                                                Foreground="{Binding Foreground, ElementName=PostLikeButton}" />
                                            <TextBlock x:Name="PostLikeLabel" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, ElementName=PostLikeButton}" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button x:Name="PostCommentButton" Style="{StaticResource CommunityActionStyle}"
                                            Click="OnPublishComment"
                                            AutomationProperties.Name="{helpers:Loc Key=Miyoushe_PublishComment}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <views:MiyousheIcon Kind="Comment"
                                                                Foreground="{Binding Foreground, ElementName=PostCommentButton}" />
                                            <TextBlock Text="{helpers:Loc Key=Miyoushe_PublishComment}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <ToggleButton x:Name="BookmarkButton" Click="OnBookmark" CornerRadius="18"
                                                  Padding="10,7"
                                                  ToolTipService.ToolTip="{helpers:Loc Key=Miyoushe_Save}"
                                                  AutomationProperties.Name="{helpers:Loc Key=Miyoushe_Save}">
                                        <FontIcon Glyph="&#xE734;" FontSize="14" />
                                    </ToggleButton>
                                    <Button Style="{StaticResource CommunityActionStyle}" Padding="10,7"
                                            Click="OnCopyLink"
                                            ToolTipService.ToolTip="{helpers:Loc Key=Miyoushe_CopyLink}"
                                            AutomationProperties.Name="{helpers:Loc Key=Miyoushe_CopyLink}">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource CommunityActionStyle}" Padding="10,7"
                                            Click="OnOriginal"
                                            ToolTipService.ToolTip="{helpers:Loc Key=Miyoushe_Original}"
                                            AutomationProperties.Name="{helpers:Loc Key=Miyoushe_Original}">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                    </Button>
                                    <ToggleButton x:Name="DockCommentsButton"
                                                  Content="{helpers:Loc Key=Miyoushe_RightComments}"
                                                  Click="OnCommentsLayoutChanged" CornerRadius="18" Padding="12,7"
                                                  FontSize="12"
                                                  ToolTipService.ToolTip="{helpers:Loc Key=Miyoushe_CommentsLayoutHint}" />
                                </StackPanel>
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <views:MiyousheAvatar x:Name="AuthorAvatar" Width="36" Height="36"
                                                          Click="OnPostAuthorAvatar" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <HyperlinkButton x:Name="AuthorButton" Click="OnAuthor" Padding="0"
                                                         FontSize="13" />
                                        <views:MiyousheWrapPanel>
                                            <TextBlock x:Name="PostMeta" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <views:MiyoushePostCounters x:Name="PostStats" FontSize="11"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </views:MiyousheWrapPanel>
                                    </StackPanel>
                                    <views:MiyousheWrapPanel x:Name="TopicLinks" Grid.Column="2"
                                                             VerticalAlignment="Center" HorizontalAlignment="Right"
                                                             MaxWidth="360" />
                                </Grid>
                            </Grid>
                            <ProgressBar Grid.Row="1" x:Name="ReaderProgress" IsIndeterminate="True"
                                         Visibility="Collapsed" Height="3" />
                            <Grid x:Name="ReaderBodyGrid" Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="CommentsColumn" Width="0" />
                                </Grid.ColumnDefinitions>
                                <WebView2 x:Name="ArticleView" />
                                <Border x:Name="CommentsView" Grid.Column="1" Visibility="Collapsed"
                                        BorderThickness="1,0,0,0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Padding="16" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="112" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="RepliesTitle" Text="{helpers:Loc Key=Miyoushe_Comments}"
                                                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ToggleButton x:Name="OnlyAuthor" Grid.Column="1"
                                                          Content="{helpers:Loc Key=Miyoushe_OnlyAuthor}"
                                                          CornerRadius="18" Padding="10,7" FontSize="12"
                                                          HorizontalAlignment="Left" Click="OnReplyFilterChanged" />
                                            <ComboBox x:Name="ReplySortSelector" Grid.Column="2" CornerRadius="18"
                                                      HorizontalAlignment="Stretch" FontSize="12"
                                                      SelectionChanged="OnReplySortChanged" />
                                        </Grid>
                                        <ProgressBar Grid.Row="1" x:Name="RepliesProgress" IsIndeterminate="True"
                                                     Visibility="Collapsed" Height="3" />
                                        <ScrollViewer Grid.Row="2" x:Name="RepliesScroll"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      HorizontalScrollMode="Disabled">
                                            <StackPanel Margin="16,0,16,24" Spacing="16">
                                                <StackPanel x:Name="RepliesPanel" Spacing="16" />
                                                <Button x:Name="MoreRepliesButton"
                                                        Style="{StaticResource CommunityActionStyle}"
                                                        Click="OnMoreReplies" Content="{helpers:Loc Key=Miyoushe_More}"
                                                        HorizontalAlignment="Stretch" Visibility="Collapsed" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</winuiex:WindowEx>