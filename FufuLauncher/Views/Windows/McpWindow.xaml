<Window
    x:Class="FufuLauncher.Views.McpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:FufuLauncher.Helpers"
    xmlns:models="using:FufuLauncher.Models"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="2,0,0,8" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>
            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="20,14" />
            </Style>
            <Style x:Key="RowTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>
            <Style x:Key="RowCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.65" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>
            <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="helpers:TrimmedToolTip.IsEnabled" Value="True" />
            </Style>
            <Style x:Key="RowDividerStyle" TargetType="Rectangle">
                <Setter Property="Height" Value="1" />
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="Margin" Value="0,12" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE774;"
                      FontSize="12"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      Opacity="0.7" />
            <TextBlock Grid.Column="1"
                       Text="{helpers:Loc Key=Mcp_WindowTitle}"
                       Margin="8,0,140,0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.85" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Padding="32,16,32,32"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled">
            <StackPanel Spacing="18" MaxWidth="760">

                <StackPanel Spacing="8">
                    <TextBlock Text="{helpers:Loc Key=Mcp_ServiceSection}"
                               Style="{StaticResource SectionTitleStyle}" />
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{helpers:Loc Key=Mcp_EnableTitle}"
                                               Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{helpers:Loc Key=Mcp_EnableCaption}"
                                               Style="{StaticResource RowCaptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              MinWidth="0"
                                              OnContent=""
                                              OffContent=""
                                              VerticalAlignment="Center"
                                              IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                            </Grid>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{helpers:Loc Key=Mcp_StatusTitle}"
                                               Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                               Style="{StaticResource RowCaptionStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.EndpointText, Mode=OneWay}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Opacity="0.8"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="{helpers:Loc Key=Mcp_Copy}"
                                        Click="OnCopyEndpointClick" />
                            </Grid>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{helpers:Loc Key=Mcp_PortTitle}"
                                               Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{helpers:Loc Key=Mcp_PortCaption}"
                                               Style="{StaticResource RowCaptionStyle}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1"
                                           Minimum="1024"
                                           Maximum="65535"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Compact"
                                           VerticalAlignment="Center"
                                           Width="150"
                                           Value="{x:Bind ViewModel.Port, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <InfoBar FontFamily="{StaticResource AppGlobalFont}" Severity="Warning"
                         IsOpen="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
                         IsClosable="False"
                         Title="{helpers:Loc Key=Mcp_SecurityTitle}"
                         Message="{helpers:Loc Key=Mcp_SecurityMessage}" />

                <InfoBar FontFamily="{StaticResource AppGlobalFont}" Severity="Error"
                         IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         IsClosable="False"
                         Title="{helpers:Loc Key=Mcp_ErrorTitle}"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <StackPanel Spacing="8">
                    <TextBlock Text="{helpers:Loc Key=Mcp_AccessSection}"
                               Style="{StaticResource SectionTitleStyle}" />
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{helpers:Loc Key=Mcp_AuthTitle}"
                                               Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{helpers:Loc Key=Mcp_AuthCaption}"
                                               Style="{StaticResource RowCaptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              MinWidth="0"
                                              OnContent=""
                                              OffContent=""
                                              VerticalAlignment="Center"
                                              IsOn="{x:Bind ViewModel.RequireAuth, Mode=TwoWay}" />
                            </Grid>

                            <TextBlock Text="{helpers:Loc Key=Mcp_AuthOffWarning}"
                                       Style="{StaticResource ErrorTextStyle}"
                                       Margin="0,10,0,0"
                                       Visibility="{x:Bind ViewModel.AuthOffWarningVisibility, Mode=OneWay}" />

                            <StackPanel Spacing="10"
                                        Visibility="{x:Bind ViewModel.AuthSettingsVisibility, Mode=OneWay}">
                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{helpers:Loc Key=Mcp_TokenModeTitle}"
                                               Style="{StaticResource RowTitleStyle}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              MinWidth="150"
                                              SelectedIndex="{x:Bind ViewModel.TokenModeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="{helpers:Loc Key=Mcp_TokenModeAuto}" />
                                        <ComboBoxItem Content="{helpers:Loc Key=Mcp_TokenModeCustom}" />
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnSpacing="8" Margin="0,2,0,0"
                                      Visibility="{x:Bind ViewModel.AutoTokenVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{x:Bind ViewModel.AccessToken, Mode=OneWay}"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="{helpers:Loc Key=Mcp_Copy}"
                                            Click="OnCopyTokenClick" />
                                    <Button Grid.Column="2"
                                            Content="{helpers:Loc Key=Mcp_Regenerate}"
                                            Click="OnRegenerateTokenClick" />
                                </Grid>

                                <StackPanel Spacing="6"
                                            Visibility="{x:Bind ViewModel.CustomTokenVisibility, Mode=OneWay}">
                                    <TextBlock Text="{helpers:Loc Key=Mcp_CustomTokenTitle}"
                                               Style="{StaticResource RowTitleStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Text="{x:Bind ViewModel.CustomToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Content="{helpers:Loc Key=Mcp_Save}"
                                                Click="OnSaveCustomTokenClick" />
                                    </Grid>
                                    <TextBlock Text="{helpers:Loc Key=Mcp_CustomTokenCaption}"
                                               Style="{StaticResource RowCaptionStyle}" />
                                </StackPanel>

                                <TextBlock Text="{helpers:Loc Key=Mcp_TokenCaption}"
                                           Style="{StaticResource RowCaptionStyle}" />

                                <TextBlock Text="{x:Bind ViewModel.TokenError, Mode=OneWay}"
                                           Style="{StaticResource ErrorTextStyle}"
                                           Visibility="{x:Bind ViewModel.TokenErrorVisibility, Mode=OneWay}" />
                            </StackPanel>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{helpers:Loc Key=Mcp_IpFilterTitle}"
                                               Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{helpers:Loc Key=Mcp_IpFilterCaption}"
                                               Style="{StaticResource RowCaptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              MinWidth="0"
                                              OnContent=""
                                              OffContent=""
                                              VerticalAlignment="Center"
                                              IsOn="{x:Bind ViewModel.IpFilterEnabled, Mode=TwoWay}" />
                            </Grid>

                            <StackPanel Spacing="10"
                                        Visibility="{x:Bind ViewModel.IpEditorVisibility, Mode=OneWay}">
                                <Grid ColumnSpacing="20" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{helpers:Loc Key=Mcp_IpModeTitle}"
                                               Style="{StaticResource RowTitleStyle}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              MinWidth="150"
                                              SelectedIndex="{x:Bind ViewModel.IpModeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="{helpers:Loc Key=Mcp_IpModeAllow}" />
                                        <ComboBoxItem Content="{helpers:Loc Key=Mcp_IpModeDeny}" />
                                    </ComboBox>
                                </Grid>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{helpers:Loc Key=Mcp_IpRulesTitle}"
                                               Style="{StaticResource RowTitleStyle}" />
                                    <TextBox
                                        Text="{x:Bind ViewModel.IpRulesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        Height="96"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        LostFocus="OnIpRulesLostFocus" />
                                    <TextBlock Text="{helpers:Loc Key=Mcp_IpRulesCaption}"
                                               Style="{StaticResource RowCaptionStyle}" />
                                    <TextBlock Text="{helpers:Loc Key=Mcp_IpRulesEmpty}"
                                               Style="{StaticResource RowCaptionStyle}"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               Visibility="{x:Bind ViewModel.IpRulesHintVisibility, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.IpError, Mode=OneWay}"
                                               Style="{StaticResource ErrorTextStyle}"
                                               Visibility="{x:Bind ViewModel.IpErrorVisibility, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{helpers:Loc Key=Mcp_ToolsSection}"
                               Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{helpers:Loc Key=Mcp_ToolsCaption}"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="2,-4,0,0" />
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="10">

                            <TextBlock Text="{helpers:Loc Key=Mcp_CategoryPlugins}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.6" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.PluginTools, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:McpToolToggleItem">
                                        <Grid MinHeight="44" Padding="0,4" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}"
                                                           FontSize="14"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Description}"
                                                           FontSize="12"
                                                           Opacity="0.65"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          MinWidth="0"
                                                          OnContent=""
                                                          OffContent=""
                                                          VerticalAlignment="Center"
                                                          IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <TextBlock Text="{helpers:Loc Key=Mcp_CategoryGame}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.6" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.GameTools, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:McpToolToggleItem">
                                        <Grid MinHeight="44" Padding="0,4" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}"
                                                           FontSize="14"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Description}"
                                                           FontSize="12"
                                                           Opacity="0.65"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          MinWidth="0"
                                                          OnContent=""
                                                          OffContent=""
                                                          VerticalAlignment="Center"
                                                          IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <TextBlock Text="{helpers:Loc Key=Mcp_CategoryInterface}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.6" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.InterfaceTools, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:McpToolToggleItem">
                                        <Grid MinHeight="44" Padding="0,4" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}"
                                                           FontSize="14"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Description}"
                                                           FontSize="12"
                                                           Opacity="0.65"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          MinWidth="0"
                                                          OnContent=""
                                                          OffContent=""
                                                          VerticalAlignment="Center"
                                                          IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <TextBlock Text="{helpers:Loc Key=Mcp_CategoryPlayer}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.6" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.PlayerTools, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:McpToolToggleItem">
                                        <Grid MinHeight="44" Padding="0,4" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}"
                                                           FontSize="14"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Description}"
                                                           FontSize="12"
                                                           Opacity="0.65"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          MinWidth="0"
                                                          OnContent=""
                                                          OffContent=""
                                                          VerticalAlignment="Center"
                                                          IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <TextBlock Text="{helpers:Loc Key=Mcp_CategorySystem}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.6" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.SystemTools, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:McpToolToggleItem">
                                        <Grid MinHeight="44" Padding="0,4" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}"
                                                           FontSize="14"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Description}"
                                                           FontSize="12"
                                                           Opacity="0.65"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          MinWidth="0"
                                                          OnContent=""
                                                          OffContent=""
                                                          VerticalAlignment="Center"
                                                          IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{helpers:Loc Key=Mcp_AuditSection}"
                               Style="{StaticResource SectionTitleStyle}" />
                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.AuditSummary, Mode=OneWay}"
                                           Style="{StaticResource RowCaptionStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="{helpers:Loc Key=Mcp_AuditOpenButton}"
                                    Click="OnOpenAuditWindowClick" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>