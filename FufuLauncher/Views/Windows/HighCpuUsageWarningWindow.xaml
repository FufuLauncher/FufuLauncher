<Window
    x:Class="FufuLauncher.Views.HighCpuUsageWarningWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:FufuLauncher.Helpers"
    Title="{helpers:Loc Key=HighCpuUsage_Title}">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="36" Background="Transparent">
            <TextBlock Text="{helpers:Loc Key=HighCpuUsage_Title}" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontSize="12" Opacity="0.8" />
        </Grid>

        <Grid Grid.Row="1" Padding="32,16,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Top" Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="{helpers:Loc Key=HighCpuUsage_Detected}" FontSize="20"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="UsageText" FontSize="13" Opacity="0.72" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="{helpers:Loc Key=HighCpuUsage_Description}" FontSize="14"
                           LineHeight="22" TextWrapping="Wrap" Opacity="0.86" />

                <StackPanel Spacing="8">
                    <TextBlock Text="{helpers:Loc Key=HighCpuUsage_SuggestedAction}" FontWeight="SemiBold" />
                    <TextBlock Text="{helpers:Loc Key=HighCpuUsage_SuggestionText}" FontSize="13"
                               Opacity="0.76" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,24,0,0" ColumnSpacing="12" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="{helpers:Loc Key=HighCpuUsage_Dismiss}" MinWidth="96" Click="OnDismissClick" />
                <Button Grid.Column="1" Content="{helpers:Loc Key=HighCpuUsage_Report}" MinWidth="104"
                        Style="{StaticResource AccentButtonStyle}" Click="OnFeedbackClick" />
                <Button Grid.Column="2" Content="{helpers:Loc Key=HighCpuUsage_ExitLauncher}" MinWidth="104"
                        Click="OnExitClick" />
            </Grid>
        </Grid>
    </Grid>
</Window>
