<UserControl
    x:Class="FufuLauncher.Controls.ColorPickerButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:FufuLauncher.Helpers"
    HorizontalAlignment="Right"
    VerticalAlignment="Center">
    <UserControl.Resources>
        <Style x:Key="ColorPickerTriggerStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PaletteButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PaletteSwatchStyle" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="PaletteSwatchSelectedStyle" TargetType="Border" BasedOn="{StaticResource PaletteSwatchStyle}">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Button x:Name="PickerButton" Style="{StaticResource ColorPickerTriggerStyle}">
        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" Opened="OnFlyoutOpened" Closed="OnFlyoutClosed">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="FontFamily" Value="{StaticResource AppGlobalFont}" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="16" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="MaxWidth" Value="420" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <ScrollViewer MaxHeight="620" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="340" Margin="20" Spacing="16">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="PreviewSwatch"
                                    Width="64"
                                    Height="64"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="PreviewHexText"
                                           FontFamily="Consolas"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="PreviewRgbText" FontSize="12" Opacity="0.65" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock FontSize="12" Opacity="0.65" Text="{helpers:Loc Key=QuickPresetsLabel}" />
                            <Grid x:Name="PaletteGrid"
                                  HorizontalAlignment="Left"
                                  ColumnSpacing="6"
                                  RowSpacing="6" />
                        </StackPanel>

                        <Grid>
                            <ContentControl x:Name="SpectrumFocusTarget"
                                            Padding="0"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            IsTabStop="True"
                                            UseSystemFocusVisuals="False"
                                            GotFocus="OnSpectrumGotFocus"
                                            KeyDown="OnSpectrumKeyDown"
                                            LostFocus="OnSpectrumLostFocus">
                                <Grid x:Name="SpectrumHost" Height="170">
                                    <Rectangle x:Name="HueBaseRect" RadiusX="12" RadiusY="12" />
                                    <Rectangle RadiusX="12" RadiusY="12">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle RadiusX="12" RadiusY="12">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#FF000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Canvas x:Name="SpectrumCanvas"
                                            Background="Transparent"
                                            PointerCanceled="OnSpectrumPointerCaptureLost"
                                            PointerCaptureLost="OnSpectrumPointerCaptureLost"
                                            PointerMoved="OnSpectrumPointerMoved"
                                            PointerPressed="OnSpectrumPointerPressed"
                                            PointerReleased="OnSpectrumPointerReleased"
                                            SizeChanged="OnPickerHostSizeChanged">
                                        <Ellipse x:Name="SpectrumThumb"
                                                 Width="18"
                                                 Height="18"
                                                 Fill="White"
                                                 Stroke="#33000000"
                                                 StrokeThickness="1" />
                                    </Canvas>
                                </Grid>
                            </ContentControl>
                            <Border x:Name="SpectrumFocusRing"
                                    BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                        </Grid>

                        <Grid>
                            <ContentControl x:Name="HueFocusTarget"
                                            Padding="0"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            IsTabStop="True"
                                            UseSystemFocusVisuals="False"
                                            GotFocus="OnHueGotFocus"
                                            KeyDown="OnHueKeyDown"
                                            LostFocus="OnHueLostFocus">
                                <Grid x:Name="HueHost" Height="24">
                                    <Border Height="12" VerticalAlignment="Center" CornerRadius="6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FFFF0000" Offset="0" />
                                                <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                                                <GradientStop Color="#FF00FF00" Offset="0.3333" />
                                                <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                                <GradientStop Color="#FF0000FF" Offset="0.6667" />
                                                <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                                                <GradientStop Color="#FFFF0000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Canvas x:Name="HueCanvas"
                                            Background="Transparent"
                                            PointerCanceled="OnHuePointerCaptureLost"
                                            PointerCaptureLost="OnHuePointerCaptureLost"
                                            PointerMoved="OnHuePointerMoved"
                                            PointerPressed="OnHuePointerPressed"
                                            PointerReleased="OnHuePointerReleased"
                                            SizeChanged="OnPickerHostSizeChanged">
                                        <Ellipse x:Name="HueThumb"
                                                 Width="20"
                                                 Height="20"
                                                 Fill="White"
                                                 Stroke="#33000000"
                                                 StrokeThickness="1" />
                                    </Canvas>
                                </Grid>
                            </ContentControl>
                            <Border x:Name="HueFocusRing"
                                    BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                        </Grid>

                        <TextBox x:Name="HexBox"
                                 Header="{helpers:Loc Key=ColorHex}"
                                 FontFamily="Consolas"
                                 LostFocus="OnHexLostFocus"
                                 MaxLength="9"
                                 PlaceholderText="#0078D7"
                                 TextChanged="OnHexTextChanged" />
                    </StackPanel>
                </ScrollViewer>
            </Flyout>
        </Button.Flyout>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border x:Name="ButtonSwatch"
                    Width="22"
                    Height="22"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6" />
            <TextBlock x:Name="ButtonHexText"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"
                       FontSize="12" />
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      FontSize="10"
                      Glyph="&#xE70D;"
                      Opacity="0.6"
                      VerticalAlignment="Center" />
        </StackPanel>
    </Button>
</UserControl>