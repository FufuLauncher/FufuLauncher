<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ApplicationIcon>Assets/WindowIcon.ico</ApplicationIcon>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <Version>1.7.2.4</Version>
        <AssemblyVersion>1.7.2.4</AssemblyVersion>
        <FileVersion>1.7.2.4</FileVersion>
        <Copyright>Copyright © FufuLauncher Development Team</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Downloader" Version="5.9.0" />
        <PackageReference Include="ModernWpfUI" Version="0.9.7-preview.2" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Strings\**\*.resw" />
        <EmbeddedResource Include="Strings\zh-CN\Resources.resw" LogicalName="Updater.Strings.zh-CN.resw" />
        <EmbeddedResource Include="Strings\en-US\Resources.resw" LogicalName="Updater.Strings.en-US.resw" />
    </ItemGroup>

</Project>