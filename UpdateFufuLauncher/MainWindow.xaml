<Window x:Class="Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:loc="clr-namespace:Updater"
        Title="{loc:Loc Key=WindowTitle}" Height="550" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.EdgeMode="Unspecified"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei"
        ResizeMode="CanMinimize"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="32" UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#E0E0E0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                        To="#FFFFFF" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                        To="#E0E0E0" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#333333"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                        To="#555555" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                        To="#333333" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelBtnStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#333333"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                        To="#555555" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                        To="#333333" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanguageToggleBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#333333"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,32,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24" Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock Text="{loc:Loc Key=WindowHeader}" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
            <TextBlock x:Name="SubtitleText" Text="{loc:Loc Key=SubtitlePreparing}" FontSize="14" Foreground="#AAAAAA"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing IsActive="True" Width="70" Height="70" Margin="0,0,0,32" Foreground="White"/>
                <TextBlock x:Name="TestStatusText" Text="{loc:Loc Key=PreparingNodeCheck}" TextAlignment="Center" FontSize="15" Foreground="#E0E0E0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="NoUpdatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="NoUpdateText" Text="{loc:Loc Key=NoUpdateMessage}" FontSize="16" Foreground="#E0E0E0" TextAlignment="Center" Margin="0,0,0,24"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="RollbackBtn" Content="{loc:Loc Key=RollbackToStable}" Click="RollbackToStable_Click" Style="{StaticResource SecondaryActionBtnStyle}" Width="160" Margin="0,0,6,0" Visibility="Collapsed"/>
                    <Button Content="{loc:Loc Key=Close}" Click="CloseWindow_Click" Style="{StaticResource PrimaryActionBtnStyle}" Width="120" HorizontalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <Grid x:Name="SelectionPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:Loc Key=MirrorListHeader}" FontSize="14" Foreground="#CCCCCC" Margin="0,0,0,12"/>
                
                <ListView x:Name="MirrorListView" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0,4,0,4"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="ItemBorder" CornerRadius="8" Background="#252525" BorderBrush="#333333" BorderThickness="1" Padding="16,14" SnapsToDevicePixels="True">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#2E2E2E"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#444444"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D3A4F"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4A75A5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Domain}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="#EAEAEA"/>
                                <TextBlock Grid.Column="1" Text="{Binding StatusDesc}" VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="13"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" x:Name="ActionPanel" Visibility="Collapsed" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Button Content="{loc:Loc Key=DirectOfficialSource}" Click="DirectDownload_Click" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryActionBtnStyle}"/>
            <Button Grid.Column="2" Content="{loc:Loc Key=DownloadSelectedNode}" Click="MirrorDownload_Click" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryActionBtnStyle}"/>
        </Grid>

        <StackPanel Grid.Row="2" x:Name="DownloadProgressPanel" Visibility="Collapsed" Margin="0,24,0,0" VerticalAlignment="Bottom">
            <TextBlock x:Name="DownloadMainText" Text="{loc:Loc Key=DownloadStarting}" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <ProgressBar x:Name="DownloadProgressBar" Height="8" ui:ControlHelper.CornerRadius="4" Foreground="#FFFFFF" Background="#333333" Maximum="100"/>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelBtn" Content="{loc:Loc Key=CancelDownload}" Click="CancelDownload_Click" Style="{StaticResource CancelBtnStyle}" Padding="16,0" FontSize="13"/>
                <TextBlock Grid.Column="1" x:Name="DownloadDetailText" Text="{loc:Loc Key=DownloadProgressInitial}" FontSize="13" Foreground="#AAAAAA" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Button x:Name="LanguageToggleBtn" Click="LanguageToggle_Click" Style="{StaticResource LanguageToggleBtnStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        </Grid>

        <ui:ContentDialog x:Name="UpdateInitErrorDialog" Grid.RowSpan="4"
                          Title="{loc:Loc Key=UpdateInitFailedTitle}"
                          PrimaryButtonText="{loc:Loc Key=CopyDownloadLink}"
                          PrimaryButtonClick="CopyDownloadLink_Click"
                          CloseButtonText="{loc:Loc Key=Close}">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=UpdateInitFailed}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DownloadLinkBox" ui:ControlHelper.Header="{loc:Loc Key=DownloadLink}"
                             AutomationProperties.Name="{loc:Loc Key=DownloadLink}"
                             Text="{x:Static loc:ApiEndpoints.DownloadPageUrl}" TextWrapping="Wrap" IsReadOnly="True"/>
                    <TextBox Grid.Column="1" Margin="12,0,0,0" MinWidth="72" VerticalAlignment="Top"
                             ui:ControlHelper.Header="{loc:Loc Key=DownloadPassword}" AutomationProperties.Name="{loc:Loc Key=DownloadPassword}"
                             Text="{x:Static loc:ApiEndpoints.DownloadPagePassword}" IsReadOnly="True"/>
                </Grid>
                <TextBox x:Name="UpdateErrorDetailsBox" Margin="0,16,0,0" ui:ControlHelper.Header="{loc:Loc Key=ErrorDetails}"
                         AutomationProperties.Name="{loc:Loc Key=ErrorDetails}" IsReadOnly="True"
                         TextWrapping="Wrap" MaxLines="4" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ui:ContentDialog>
    </Grid>
</Window>
